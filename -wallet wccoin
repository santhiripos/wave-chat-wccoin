  const cred = await auth.createUserWithEmailAndPassword(toEmail(phone), password);
  const uid = cred.user.uid;
  await db.ref('users/' + uid).set({
    uid,
    name,
    phone: displayPhone(phone),
    gender: gender || 'other',
    age_group: ageGroup || '25-34',
    coin_balance: 100,
    today_earned: 0,
    games_played: 0,
    total_wins: 0,
    createdAt: Date.now(),
    isAdmin: false
  });
  await db.ref('coin_transactions/' + uid).push({
    ts: Date.now(),
    amount: 100,
    reason: 'signup_bonus',
    type: 'signup_bonus',
    desc: '🎉 Welcome bonus'
  });
  return cred.user;
}

