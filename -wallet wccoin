    const usersSnap = await db.ref('users').orderByChild('phone').equalTo(displayPhone(phone)).once('value');
    let adminUser = null;
    usersSnap.forEach(child => { if (!adminUser) adminUser = Object.assign({ _key: child.key }, child.val()); });
