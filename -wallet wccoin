    } else if (t === 'WCWalletGetBalance') {
      e.source.postMessage({ type: 'WCWalletResponse', id: e.data.id, result: coinBalance }, '*');
    } else if (t === 'WCWalletGetUser') {
      e.source.postMessage({ type: 'WCWalletResponse', id: e.data.id, result: currentUser ? { name: currentUser.name, phone: currentUser.phone } : null }, '*');
    } else if (t === 'WCWalletToast') {
      toast(e.data.msg, e.data.toastType);
    }
  }
  window.addEventListener('message', handleMessage);
  const cleanup = () => window.removeEventListener('message', handleMessage);
  overlay.addEventListener('remove', cleanup);
  const origRemove = overlay.remove.bind(overlay);
  overlay.remove = function() { cleanup(); origRemove(); };
}

