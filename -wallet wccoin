   ============================================================ */
function loadUserData() {
  if (!currentUser) return;
  if (userDataRef) { try { userDataRef.off(); } catch(e){} }
  userDataRef = db.ref('users/' + currentUser.uid);
  userDataRef.on('value', snap => {
    const data = snap.val();
    if (!data) return;
    coinBalance = data.coin_balance || 0;
    todayEarned = data.today_earned || 0;
    totalGamesPlayed = data.games_played || 0;
    totalWins = data.total_wins || 0;
    currentUser = Object.assign(currentUser, data);
    settings.name = data.name || settings.name;
    isAdmin = data.isAdmin === true;
    updateAllUI();
  });
}

function loadHistory() {
  if (!currentUser) return;
  if (txRef) { try { txRef.off(); } catch(e){} }
  txRef = db.ref('coin_transactions/' + currentUser.uid).limitToLast(50);
  txRef.on('value', snap => {
    const data = snap.val() || {};
    const txHistory = Object.entries(data).map(([id, tx]) => Object.assign({ id }, tx)).sort((a,b) => (b.ts||0) - (a.ts||0));
    renderHistoryList(txHistory);
  });
}

async function addCoins(amount, reason, meta = {}) {
  if (!currentUser || !amount) return false;
  try {
    const result = await db.ref('users/' + currentUser.uid + '/coin_balance').transaction(c => {
      const n = (c || 0) + amount;
      return n < 0 ? undefined : n;
    });
    if (!result.committed) return false;
    await db.ref('coin_transactions/' + currentUser.uid).push({
      ts: Date.now(), amount, reason, type: reason, desc: meta.desc || reason, ...meta
    });
    if (amount > 0) await db.ref('users/' + currentUser.uid + '/today_earned').transaction(c => (c || 0) + amount).catch(()=>{});
    return true;
  } catch(e) { console.error('addCoins error:', e); return false; }
}

async function addCoinsToUser(uid, amount, reason, meta = {}) {
  try {
    const result = await db.ref('users/' + uid + '/coin_balance').transaction(c => {
      const n = (c || 0) + amount;
      return n < 0 ? undefined : n;
    });
    if (!result.committed) return false;
    await db.ref('coin_transactions/' + uid).push({ ts: Date.now(), amount, reason, type: reason, desc: meta.desc || reason, ...meta });
    return true;
  } catch(e) { console.error('addCoinsToUser error:', e); return false; }
}

