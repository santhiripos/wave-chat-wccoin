        <div id="admUserList"></div>
      </div>
    </div>

    <div class="admin-panel" id="admPanel-buyreq"><div class="admin-card"><div class="admin-card-title">🛒 Buy Requests</div><div id="admBuyReqList"></div></div></div>

    <div class="admin-panel" id="admPanel-gift">
      <div class="admin-card">
        <div class="admin-card-title">🎁 Gift Management</div>
        <div style="background:var(--bg-main);border-radius:12px;padding:16px;margin-bottom:16px;border:1px dashed var(--border)">
