    <div class="section-header" style="margin-top:20px;margin-bottom:10px;"><h3>📦 ကျွန်ုပ်၏ Orders</h3></div>
    <div id="myGiftOrders"></div>
  </div>

  <!-- TRANSFER -->
  <div class="page-view" id="page-transfer">
    <div class="admin-card">
      <h3 style="margin-bottom:20px;color:var(--primary);">💸 WCCoin Transfer</h3>
      <div class="info-row"><label>ဖုန်းနံပါတ်</label><input type="tel" id="trPhone" placeholder="09xxxxxxxxx"></div>
      <div class="info-row"><label>ပမာဏ</label><input type="number" id="trAmount" placeholder="0"></div>
