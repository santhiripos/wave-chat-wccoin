function randomSymbol() {
  const rand = Math.random();
  if (rand < 0.04) return SCATTER_SYMBOL;
  if (rand < 0.6) return SYMBOLS[Math.floor(Math.random() * 5)];
  if (rand < 0.9) return SYMBOLS[Math.floor(Math.random() * 10)];
  return SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
}

function buildCell(symKey) {
  const cell = document.createElement('div');
  cell.className = 'reel-cell';
  const s = document.createElement('div');
  s.className = 'sym' + (symKey === SCATTER_SYMBOL ? ' bomb' : '');
  s.innerHTML = SVG_ICONS[symKey] || SVG_ICONS['cherry'];
  s.dataset.sym = symKey;
  cell.appendChild(s);
  return cell;
}

function generateReels() {
  const container = $('reelsContainer'); if (!container) return;
  container.innerHTML = '';
  _reelColumns = []; _reelStrips = []; _reelOffsets = [0,0,0,0,0];
  for (let c = 0; c < 5; c++) {
    const col = document.createElement('div');
    col.className = 'reel-column'; col.dataset.col = c;
    const strip = document.createElement('div');
    strip.className = 'reel-strip'; strip.dataset.col = c;
    for (let i = 0; i < REEL_VISIBLE + REEL_BUFFER * 2; i++) strip.appendChild(buildCell(randomSymbol()));
    col.appendChild(strip);
    container.appendChild(col);
    _reelColumns.push(col); _reelStrips.push(strip);
  }
  resetReelPositions();
}

function resetReelPositions() {
  const cellH = getCellHeight(); if (!cellH) return;
  _reelOffsets = [0,0,0,0,0];
  for (let c = 0; c < 5; c++) {
    const strip = _reelStrips[c]; if (!strip) continue;
    strip.style.transition = 'none';
    strip.style.transform = `translateY(${-cellH * REEL_BUFFER}px)`;
    _reelOffsets[c] = -cellH * REEL_BUFFER;
  }
}

function getCellHeight() {
  if (!_reelStrips[0]) return 0;
  const firstCell = _reelStrips[0].querySelector('.reel-cell'); if (!firstCell) return 0;
  const rect = firstCell.getBoundingClientRect();
  const style = window.getComputedStyle(firstCell);
  const margin = (parseFloat(style.marginTop) || 0) + (parseFloat(style.marginBottom) || 0);
  return rect.height + margin;
}

function spinColumn(colIndex, targetSymbols, duration, onDone) {
  const strip = _reelStrips[colIndex];
  const colEl = _reelColumns[colIndex];
  if (!strip || !colEl) { if (onDone) onDone(); return; }
  const cellH = getCellHeight();
  if (!cellH) { if (onDone) onDone(); return; }
  const totalScrollCells = 30 + colIndex * 5;
  const requiredCells = totalScrollCells + REEL_VISIBLE + REEL_BUFFER;
  while (strip.children.length < requiredCells + REEL_BUFFER * 2) strip.appendChild(buildCell(randomSymbol()));
  const finalCells = targetSymbols.slice(0, REEL_VISIBLE).map(buildCell);
  const totalNeeded = totalScrollCells + REEL_VISIBLE + REEL_BUFFER;
  while (strip.children.length < totalNeeded) strip.appendChild(buildCell(randomSymbol()));
  for (let i = 0; i < finalCells.length; i++) {
    const idx = totalScrollCells + i;
    if (strip.children[idx]) strip.replaceChild(finalCells[i], strip.children[idx]);
  }
  const endOffset = -cellH * totalScrollCells;
  const durationMs = Math.max(duration, 200);
  strip.style.transition = `transform ${durationMs}ms cubic-bezier(0.2, 0.9, 0.3, 1)`;
  void strip.offsetHeight;
  strip.style.transform = `translateY(${endOffset}px)`;
  _reelOffsets[colIndex] = endOffset;
  setTimeout(() => {
    cleanupColumn(colIndex, totalScrollCells, cellH);
    playReelStopSound(colIndex);
    if (onDone) onDone();
  }, durationMs + 20);
}

function cleanupColumn(colIndex, targetStartIndex, cellH) {
  const strip = _reelStrips[colIndex]; if (!strip) return;
  const keepAbove = REEL_BUFFER;
  const removeCount = Math.max(0, targetStartIndex - keepAbove);
  for (let i = 0; i < removeCount; i++) { if (strip.firstChild) strip.removeChild(strip.firstChild); }
  const newOffset = _reelOffsets[colIndex] + cellH * removeCount;
  strip.style.transition = 'none';
  strip.style.transform = `translateY(${newOffset}px)`;
  _reelOffsets[colIndex] = newOffset;
  void strip.offsetHeight;
}

function slotSpin() {
  if (slotState.spinning) return;
  if (!currentUser) return toast('Login လုပ်ပါ', 'warn');
  if (slotConfig.status === 'disabled') { toast('⚠️ Slot ပိတ်ထားပါသည်', 'warn'); return; }
  if (!slotState.isFreeSpin && slotState.bet > slotState.credit) { toast('⚠️ WCCoin မလုံလောက်ပါ', 'warn'); slotStopAuto(); return; }
  getAudioCtx(); playSpinSound();
  if (!slotState.isFreeSpin) {
    slotState.credit -= slotState.bet;
    if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit);
    addCoins(-slotState.bet, 'bet', { desc: '🎰 Slot Bet', game: 'Slot' });
  }
  if($('slotWinDisplay')) $('slotWinDisplay').textContent = '0';
  slotState.spinning = true;
  if($('slotSpinBtn')) $('slotSpinBtn').disabled = true;
  if($('slotAutoBtn')) $('slotAutoBtn').disabled = true;
  if($('slotMessage')) $('slotMessage').textContent = slotState.isFreeSpin ? `🎁 Free Spin! (${slotState.freeSpins})` : '🎰 လှည့်နေသည်...';
  slotState.totalSpins++; totalGamesPlayed++;
  db.ref('users/' + currentUser.uid + '/games_played').set(totalGamesPlayed).catch(()=>{});
  if($('slotEffect')) $('slotEffect').classList.remove('show');
  if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show');
  document.querySelectorAll('.reel-cell .sym').forEach(el => el.classList.remove('win', 'scatter'));
  
  let winChance = false;
  if (slotForceMode === 'win') winChance = true;
  else if (slotForceMode === 'lose') winChance = false;
  else winChance = Math.random() * 100 < slotConfig.winRate;
  
  const results = []; let bombCount = 0;
  for (let c = 0; c < 5; c++) {
    const colRes = [];
    for (let r = 0; r < REEL_VISIBLE; r++) {
      let sym; const rand = Math.random();
      if (rand < 0.03 && bombCount < 2) { sym = SCATTER_SYMBOL; bombCount++; }
      else {
        if (rand < 0.6) sym = SYMBOLS[Math.floor(Math.random() * 5)];
        else if (rand < 0.9) sym = SYMBOLS[Math.floor(Math.random() * 10)];
        else sym = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
      }
      colRes.push(sym);
    }
    results.push(colRes);
  }
  if (winChance && !slotState.isFreeSpin) {
    const low = ['cherry','lemon','orange','plum','watermelon'];
    const rs = low[Math.floor(Math.random() * low.length)];
    results[0][1] = rs; results[1][1] = rs; results[2][1] = rs;
  }
  
  const baseDur = slotState.turbo ? 300 : 700;
  const staggerDur = slotState.turbo ? 60 : 150;
  let finishedCount = 0;
  for (let c = 0; c < 5; c++) {
    const colDur = baseDur + c * staggerDur;
    spinColumn(c, results[c], colDur, () => {
      finishedCount++;
      if (finishedCount === 5) {
        setTimeout(() => {
          slotCheckWin(results);
          slotState.spinning = false;
          if($('slotSpinBtn')) $('slotSpinBtn').disabled = false;
          if($('slotAutoBtn')) $('slotAutoBtn').disabled = false;
          if (slotState.isFreeSpin) {
            slotState.freeSpins--;
            if (slotState.freeSpins > 0) setTimeout(() => slotSpin(), slotState.turbo ? 300 : 800);
            else { slotState.isFreeSpin = false; if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show'); }
          }
          if (slotState.auto && slotState.autoCount > 0) {
            slotState.autoCount--;
            if($('slotAutoBtn')) $('slotAutoBtn').innerHTML = `🔄<br><span class="btn-label">(${slotState.autoCount})</span>`;
            if (slotState.autoCount > 0) setTimeout(() => slotSpin(), slotState.turbo ? 300 : 800);
            else slotStopAuto();
          }
        }, 80);
      }
    });
  }
}

