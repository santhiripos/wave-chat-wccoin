<!DOCTYPE html>
<html lang="my">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0f172a">
<title>WC Wallet Ultra</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Padauk:wght@400;700&family=Noto+Sans+Myanmar:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg-main:#070a13;--bg-card:rgba(30,41,59,0.7);--bg-card-hover:rgba(51,65,85,0.8);
  --text-main:#f8fafc;--text-muted:#94a3b8;
  --primary:#00f2fe;--primary-dark:#4facfe;
  --accent:#fbbf24;--accent-dark:#d97706;
  --success:#10b981;--danger:#ef4444;--border:rgba(255,255,255,0.08);
  --grad-primary:linear-gradient(135deg,#4facfe,#00f2fe);
  --grad-accent:linear-gradient(135deg,#fbbf24,#d97706);
  --grad-success:linear-gradient(135deg,#10b981,#059669);
  --grad-danger:linear-gradient(135deg,#ef4444,#dc2626);
  --sh-sm:0 4px 6px -1px rgba(0,0,0,.5);--sh-md:0 10px 15px -3px rgba(0,0,0,.5);--sh-lg:0 20px 25px -5px rgba(0,0,0,.5);
  --gold-coin: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23FFD700"/><stop offset="0.5" stop-color="%23FFA500"/><stop offset="1" stop-color="%23FF8C00"/></linearGradient></defs><circle cx="50" cy="50" r="45" fill="url(%23g)" stroke="%23B8860B" stroke-width="4"/><circle cx="50" cy="50" r="35" fill="none" stroke="%23FFF8DC" stroke-width="2" opacity="0.6"/><text x="50" y="62" text-anchor="middle" font-family="Arial, sans-serif" font-size="36" font-weight="900" fill="%23B8860B">W</text></svg>');
}
body{font-family:'Inter','Padauk','Noto Sans Myanmar',sans-serif;background:var(--bg-main);color:var(--text-main);min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.6;background-image:radial-gradient(circle at 15% 50%, rgba(79, 172, 254, 0.15), transparent 25%), radial-gradient(circle at 85% 30%, rgba(251, 191, 36, 0.1), transparent 25%)}
.hidden{display:none!important}

/* ===== TOP NAVIGATION ===== */
.top-navbar{position:fixed;top:0;left:0;right:0;background:rgba(15,23,42,0.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);z-index:9999;display:flex;flex-direction:column}
.nav-top-row{display:flex;justify-content:space-between;align-items:center;padding:10px 20px;border-bottom:1px solid rgba(255,255,255,0.05)}
.nav-logo{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:900;color:#fff}
.nav-logo-mark{background:var(--grad-primary);width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#000}
.nav-tools{display:flex;align-items:center;gap:10px}
.lang-select{background:rgba(255,255,255,0.1);color:#fff;border:1px solid var(--border);padding:6px 10px;border-radius:6px;font-size:12px;font-weight:600;outline:none;cursor:pointer}
.logout-btn{background:rgba(239,68,68,0.2);color:#ef4444;border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:6px 12px;font-size:13px;font-weight:700;cursor:pointer;transition:.2s}
.logout-btn:hover{background:rgba(239,68,68,0.3)}

/* Nav Menu Bar */
.nav-menu-bar{display:flex;overflow-x:auto;padding:8px 20px;gap:8px;scrollbar-width:none}
.nav-menu-bar::-webkit-scrollbar{display:none}
.nav-btn{background:transparent;border:1px solid transparent;color:var(--text-muted);padding:8px 16px;border-radius:20px;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px;transition:.3s;font-family:inherit}
.nav-btn:hover{background:rgba(255,255,255,0.05);color:#fff}
.nav-btn.active{background:rgba(79,172,254,0.15);color:var(--primary);border-color:rgba(79,172,254,0.3);box-shadow:0 0 10px rgba(0,242,254,0.1)}

.app-shell{display:none;min-height:100vh;padding-top:100px;padding-bottom:40px;max-width:1200px;margin:0 auto;padding-left:15px;padding-right:15px}
.app-shell.active{display:block}

.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;padding:0 10px}
.topbar-left h2{font-size:24px;font-weight:900;letter-spacing:-.5px;background:var(--grad-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.topbar-left p{font-size:14px;color:var(--text-muted);margin-top:4px;font-weight:500}

.page-view{display:none}
.page-view.active{display:block;animation:fadeUp .4s cubic-bezier(0.16, 1, 0.3, 1)}
@keyframes fadeUp{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}

/* ===== BALANCE CARD ===== */
.balance-card{background:linear-gradient(135deg,rgba(30,41,59,0.8) 0%,rgba(15,23,42,0.9) 100%);backdrop-filter:blur(20px);border-radius:24px;padding:30px;color:#fff;position:relative;overflow:hidden;margin-bottom:24px;box-shadow:0 15px 35px rgba(0,0,0,0.4), inset 0 0 0 1px rgba(255,255,255,0.1)}
.balance-card::before{content:'';position:absolute;top:-50%;right:-20%;width:300px;height:300px;background:radial-gradient(circle,rgba(0,242,254,.2),transparent 70%);border-radius:50%;filter:blur(20px)}
.balance-label{font-size:14px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--primary);margin-bottom:10px;position:relative;z-index:2;text-shadow:0 0 10px rgba(0,242,254,0.5)}
.balance-amount{font-size:48px;font-weight:900;letter-spacing:-1px;line-height:1.1;position:relative;z-index:2;display:flex;align-items:center;gap:12px;flex-wrap:wrap;text-shadow:0 4px 20px rgba(0,0,0,0.5)}
.balance-amount .coin-icon{width:44px;height:44px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center;filter:drop-shadow(0 4px 10px rgba(251,191,36,0.4))}
.balance-amount small{font-size:20px;font-weight:800;color:var(--text-muted)}
.balance-actions{display:flex;gap:12px;margin-top:24px;position:relative;z-index:2}
.balance-action{flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#fff;padding:14px 12px;border-radius:14px;font-size:15px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:.3s}
.balance-action:hover{background:rgba(255,255,255,0.1);transform:translateY(-3px);box-shadow:0 10px 20px rgba(0,0,0,0.2)}

/* ===== STATS & ACTIONS ===== */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}
.stat-box{background:var(--bg-card);backdrop-filter:blur(10px);border:1px solid var(--border);border-radius:20px;padding:20px;box-shadow:var(--sh-sm);transition:.3s}
.stat-box:hover{transform:translateY(-5px);box-shadow:var(--sh-md);border-color:rgba(255,255,255,0.2)}
.stat-box .sb-label{font-size:13px;color:var(--text-muted);font-weight:700;margin-bottom:8px}
.stat-box .sb-value{font-size:26px;font-weight:900;color:#fff;display:flex;align-items:center;gap:8px}
.stat-box .sb-value .inline-coin{width:24px;height:24px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}

.action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;margin-bottom:24px}
.action-tile{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:24px 14px;display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;transition:.3s;box-shadow:var(--sh-sm);font-family:inherit}
.action-tile:hover{transform:translateY(-5px);box-shadow:var(--sh-md);border-color:var(--primary);background:rgba(30,41,59,0.9)}
.action-tile .at-icon{width:60px;height:60px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:30px;background:rgba(255,255,255,0.05);box-shadow:inset 0 0 20px rgba(255,255,255,0.05)}
.action-tile h4{font-size:16px;font-weight:800;color:#fff}
.action-tile p{font-size:12px;color:var(--text-muted);text-align:center}

/* ===== SLOT 5x5 ===== */
.slot-wrapper{background:linear-gradient(145deg,#0b0f19 0%,#1a0b2e 100%);border-radius:24px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.7),0 0 0 2px rgba(251,191,36,.2),inset 0 0 40px rgba(251,191,36,.05);max-width:980px;margin:0 auto;position:relative;overflow:hidden;border:1px solid rgba(251,191,36,.3)}
.slot-top{display:flex;justify-content:space-between;align-items:center;background:rgba(0,0,0,.4);border:1px solid rgba(251,191,36,.3);border-radius:14px;padding:12px 20px;margin-bottom:16px;position:relative;z-index:2;backdrop-filter:blur(10px)}
.slot-credit{display:flex;align-items:center;gap:8px;color:var(--accent);font-weight:900;font-size:15px}
.slot-credit .coin-icon{width:24px;height:24px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}
.slot-credit .val{color:#00f2fe;font-size:22px;text-shadow:0 0 15px rgba(0,242,254,.6)}
.slot-btn-sm{background:var(--grad-accent);color:#000;border:none;border-radius:8px;width:36px;height:36px;cursor:pointer;font-weight:900;font-size:16px;display:flex;align-items:center;justify-content:center;transition:.2s}
.slot-btn-sm:hover{transform:scale(1.1)}
.slot-title{text-align:center;font-size:38px;font-weight:900;background:linear-gradient(180deg,#FFD700 0%,#FF8C00 50%,#FFD700 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:8px;margin:10px 0 4px;position:relative;z-index:2;filter:drop-shadow(0 0 20px rgba(251,191,36,.6))}
.slot-subtitle{text-align:center;font-size:12px;color:#00f2fe;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(0,242,254,.3);border-radius:8px;padding:6px;background:rgba(0,242,254,.05);font-weight:800;position:relative;z-index:2}
.slot-info-row{display:flex;justify-content:space-around;background:rgba(0,0,0,.6);border:1px solid rgba(251,191,36,.2);border-radius:12px;padding:10px 16px;margin-bottom:16px;position:relative;z-index:2}
.slot-info-item{display:flex;flex-direction:column;align-items:center}
.slot-info-item .lbl{font-size:10px;color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:1px}
.slot-info-item .val{font-size:20px;color:#fff;font-weight:900;margin-top:2px;text-shadow:0 0 10px rgba(255,255,255,0.3)}
.slot-main{display:flex;gap:12px;margin-bottom:16px;position:relative;z-index:2}
.slot-reels{flex:1;background:linear-gradient(180deg,#05020a,#110522);border:3px solid var(--accent);border-radius:16px;padding:8px;position:relative;min-width:0;overflow:hidden;box-shadow:inset 0 0 50px rgba(251,191,36,.1)}
.reels-container{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:4px;width:100%;height:100%}
.reel-column{position:relative;overflow:hidden;border-radius:8px;background:#05020a;border:1px solid rgba(251,191,36,.2);height:100%;min-height:360px}
.reel-strip{position:absolute;top:0;left:0;right:0;display:flex;flex-direction:column;will-change:transform}
.reel-cell{width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#FFFDF8,#FFF5E0);border-radius:6px;border:1px solid rgba(251,191,36,.3);margin:1px 0;position:relative;overflow:hidden;flex-shrink:0;box-shadow:inset 0 0 10px rgba(0,0,0,0.1)}
.reel-cell .sym{display:flex;justify-content:center;align-items:center;width:100%;height:100%;font-weight:bold;font-size:34px;color:#1E293B}
.reel-cell .sym svg{width:100%;height:100%;max-width:52px;max-height:52px;display:block;margin:auto}
.reel-cell .sym.win{background:linear-gradient(135deg,rgba(0,255,204,.95),rgba(255,204,0,.9));border-radius:6px;animation:wf .3s infinite alternate;box-shadow:0 0 25px #00ffcc;z-index:2}
.reel-cell .sym.scatter{background:linear-gradient(135deg,rgba(255,0,255,.95),rgba(255,100,0,.9));border-radius:6px;animation:sf .3s infinite alternate;box-shadow:0 0 30px #ff00ff;z-index:2}
@keyframes wf{0%{transform:scale(1)}100%{transform:scale(1.15)}}
@keyframes sf{0%{transform:scale(1)}100%{transform:scale(1.2)}}

/* Win Line Overlay */
.win-lines-overlay{position:absolute;inset:0;pointer-events:none;z-index:10;display:none}
.win-lines-overlay.show{display:block}
.win-lines-overlay svg{width:100%;height:100%}

.slot-btns{display:flex;flex-direction:column;gap:10px;width:110px;flex-shrink:0}
.slot-btn{border-radius:12px;font-weight:900;cursor:pointer;text-transform:uppercase;border:none;transition:.2s;padding:0;color:#000;position:relative;overflow:hidden;box-shadow:0 6px 15px rgba(0,0,0,.4);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1;font-family:inherit}
.slot-btn:active{transform:scale(.95)}
.slot-spin{background:linear-gradient(180deg,#00f2fe,#4facfe);font-size:26px;padding:18px 0;flex:1}
.slot-spin .btn-label{font-size:14px;letter-spacing:1px;margin-top:4px}
.slot-spin:disabled{opacity:.5;cursor:not-allowed;filter:grayscale(50%)}
.slot-auto{background:linear-gradient(180deg,#ff00ff,#c400c4);color:#fff;font-size:20px;padding:14px 0}
.slot-auto .btn-label{font-size:12px;margin-top:2px}
.slot-turbo{background:linear-gradient(180deg,#fbbf24,#d97706);font-size:20px;padding:14px 0}
.slot-turbo .btn-label{font-size:12px;margin-top:2px}

.slot-bet-row{display:flex;justify-content:space-between;align-items:center;background:rgba(0,0,0,.6);border:1px solid rgba(251,191,36,.2);border-radius:12px;padding:10px 16px;gap:10px;flex-wrap:wrap;position:relative;z-index:2}
.bet-ctrl{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);padding:6px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);position:relative;}
.bet-ctrl button{background:var(--grad-accent);border:none;width:34px;height:34px;border-radius:8px;font-weight:900;cursor:pointer;font-size:18px;color:#000;box-shadow:0 2px 5px rgba(0,0,0,.3)}
.bet-ctrl .bv{color:#fff;font-weight:900;font-size:20px;min-width:60px;text-align:center}
.bet-ctrl .bl{color:var(--accent);font-size:10px;font-weight:800;text-transform:uppercase;position:absolute;top:-8px;left:50%;transform:translateX(-50%);background:#0f172a;padding:0 4px}
.quick-bets{display:flex;gap:8px}
.quick-bets button{border:none;border-radius:8px;font-weight:900;cursor:pointer;color:#fff;font-size:14px;padding:10px 14px;font-family:inherit;transition:.2s}
.q2x{background:linear-gradient(180deg,#4facfe,#00f2fe);color:#000}
.q3x{background:linear-gradient(180deg,#ff6600,#cc4400)}
.q5x{background:linear-gradient(180deg,#ef4444,#dc2626)}
.daily-btn{background:linear-gradient(180deg,#10b981,#059669);color:#fff;padding:10px 16px;border:none;border-radius:8px;font-weight:900;cursor:pointer;font-size:20px}
.slot-msg{background:rgba(0,0,0,.8);border:1px solid rgba(251,191,36,.3);border-radius:12px;padding:14px;color:#fbbf24;font-size:14px;font-weight:700;min-height:60px;display:flex;justify-content:center;align-items:center;text-align:center;line-height:1.5;flex-wrap:wrap;gap:8px;margin-top:14px;position:relative;z-index:2}
.slot-effect{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0);font-size:64px;font-weight:900;text-shadow:0 0 40px currentColor,0 0 80px currentColor;z-index:50;pointer-events:none;opacity:0;transition:opacity .3s,transform .3s;white-space:nowrap;text-align:center}
.slot-effect.show{opacity:1;transform:translate(-50%,-50%) scale(1);animation:winPulse .4s infinite alternate}
@keyframes winPulse{0%{transform:translate(-50%,-50%) scale(1)}100%{transform:translate(-50%,-50%) scale(1.2)}}
.slot-freespin{position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,0,255,.2),rgba(251,191,36,.2));z-index:40;pointer-events:none;opacity:0;transition:opacity .3s;border-radius:12px}
.slot-freespin.show{opacity:1}
.slot-freespin::before{content:'🎁 FREE SPIN';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-15deg);font-size:36px;font-weight:900;color:#ff00ff;text-shadow:0 0 30px #ff00ff,0 0 60px #ff00ff;animation:fsFlash .5s infinite alternate}
@keyframes fsFlash{0%{opacity:.6}100%{opacity:1}}

/* ===== GAME HUB & GIFTS ===== */
.game-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:.3s;box-shadow:var(--sh-sm);display:flex;flex-direction:column}
.game-card:hover{transform:translateY(-6px);box-shadow:0 15px 30px rgba(0,0,0,0.4);border-color:var(--primary)}
.game-card .game-thumb{width:100%;aspect-ratio:16/10;background:linear-gradient(135deg,#1e293b,#0f172a);display:flex;align-items:center;justify-content:center;font-size:64px;overflow:hidden;position:relative}
.game-card .game-thumb img{width:100%;height:100%;object-fit:cover}
.game-card .game-body{padding:16px;display:flex;flex-direction:column;gap:8px}
.game-card .game-body h4{font-size:18px;font-weight:900;color:#fff}
.game-card .game-body p{font-size:13px;color:var(--text-muted);line-height:1.5;min-height:40px}
.game-card .game-body .game-play{background:var(--grad-primary);color:#000;border:none;border-radius:10px;padding:12px;font-weight:900;cursor:pointer;font-size:14px;margin-top:auto;transition:.2s;font-family:inherit}
.game-card .game-body .game-play:hover{box-shadow:0 0 20px rgba(0,242,254,0.4)}

.gift-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:24px}
.gift-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:.3s;box-shadow:var(--sh-sm);display:flex;flex-direction:column}
.gift-card:hover{transform:translateY(-5px);box-shadow:var(--sh-md);border-color:#FF6B9D}
.gift-image{width:100%;aspect-ratio:1/1;background:linear-gradient(135deg,#1e293b,#0f172a);display:flex;align-items:center;justify-content:center;font-size:64px;overflow:hidden}
.gift-image img{width:100%;height:100%;object-fit:cover}
.gift-body{padding:16px;display:flex;flex-direction:column;gap:8px;flex:1}
.gift-body h4{font-size:16px;font-weight:900;color:#fff}
.gift-body .gift-price{font-size:18px;font-weight:900;color:#FF6B9D;display:flex;align-items:center;gap:6px}
.gift-body .gift-price .coin-icon{width:20px;height:20px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}
.gift-body .gift-btn{background:linear-gradient(135deg,#FF6B9D,#C44569);color:#fff;border:none;border-radius:10px;padding:12px;font-weight:800;cursor:pointer;font-size:14px;transition:.2s;margin-top:auto;font-family:inherit}
.gift-body .gift-btn:hover{transform:translateY(-2px);box-shadow:0 5px 15px rgba(196,69,105,.4)}

/* ===== FORMS & MODALS ===== */
.info-row{margin-bottom:16px}
.info-row label{display:block;font-size:13px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.info-row input,.info-row select,.info-row textarea{width:100%;padding:14px 16px;border:1px solid var(--border);border-radius:12px;font-size:15px;background:rgba(0,0,0,0.2);outline:none;color:#fff;font-family:inherit;font-weight:500;transition:.2s}
.info-row input:focus,.info-row select:focus,.info-row textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,242,254,.15)}
.info-row textarea{resize:vertical;min-height:100px}
.btn{padding:14px 24px;border-radius:12px;font-weight:800;font-size:15px;cursor:pointer;font-family:inherit;border:none;transition:.2s;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn-primary{background:var(--grad-primary);color:#000;box-shadow:0 4px 15px rgba(0,242,254,.3)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,242,254,.4)}
.btn-secondary{background:rgba(255,255,255,0.05);color:#fff;border:1px solid var(--border)}
.btn-danger{background:var(--grad-danger);color:#fff}
.btn-success{background:var(--grad-success);color:#fff}
.btn-gold{background:var(--grad-accent);color:#000}
.btn-block{width:100%}
.btn-sm{padding:8px 14px;font-size:13px;border-radius:8px}

.history-list{display:flex;flex-direction:column;gap:10px}
.tx-row{background:rgba(0,0,0,0.2);border:1px solid var(--border);border-radius:16px;padding:16px;display:flex;align-items:center;gap:16px;box-shadow:var(--sh-sm);transition:.2s}
.tx-row:hover{transform:translateX(4px);box-shadow:var(--sh-md)}

.pkg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:20px}
.pkg-card{background:var(--bg-card);border:2px solid var(--border);border-radius:16px;padding:20px 12px;text-align:center;cursor:pointer;position:relative;transition:.2s}
.pkg-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.pkg-card.selected{border-color:var(--accent);background:rgba(251,191,36,.05);box-shadow:0 6px 20px rgba(251,191,36,.15)}
.pkg-coins{font-size:24px;font-weight:900;color:var(--accent);line-height:1.1;margin-bottom:6px}
.pkg-price{font-size:14px;color:var(--text-muted);font-weight:700}
.pkg-bonus{position:absolute;top:-8px;right:10px;background:var(--danger);color:#fff;font-size:11px;font-weight:900;padding:3px 10px;border-radius:12px}
.req-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:14px}
.req-card .req-body{flex:1;min-width:0}
.req-card .req-title{font-size:14px;font-weight:800;margin-bottom:2px}
.req-card .req-sub{font-size:12px;color:var(--text-muted);font-weight:500}

.modal-overlay{position:fixed;inset:0;background:rgba(2,6,23,.8);display:none;align-items:center;justify-content:center;z-index:9000;padding:20px;backdrop-filter:blur(8px)}
.modal-overlay.show{display:flex}
.modal{background:var(--bg-card);border-radius:20px;width:100%;max-width:440px;max-height:90vh;overflow-y:auto;box-shadow:var(--sh-lg);animation:popIn .3s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column;border:1px solid var(--border)}
.modal.modal-lg{max-width:800px}
@keyframes popIn{0%{transform:scale(.92);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-head{padding:20px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.modal-head h3{font-size:18px;font-weight:900;letter-spacing:-.5px;display:flex;align-items:center;gap:8px;color:var(--primary)}
.modal-close{background:transparent;border:none;font-size:20px;cursor:pointer;color:var(--text-muted);width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-family:inherit}
.modal-close:hover{background:var(--bg-main)}
.modal-body{padding:24px;flex:1;overflow-y:auto}
.modal-foot{padding:16px 24px 24px;display:flex;gap:10px;flex-shrink:0}

/* ===== ADMIN PANEL ===== */
#adminScreen{display:none;min-height:100vh;background:var(--bg-main);position:fixed;inset:0;z-index:1000;overflow-y:auto;padding-top:60px}
#adminScreen.active{display:block}
.admin-header{background:rgba(15,23,42,0.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);color:#fff;padding:16px 24px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
.admin-header h2{font-size:22px;font-weight:900;background:var(--grad-accent);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.admin-body{padding:24px;max-width:1200px;margin:0 auto}
.admin-tabs{display:flex;gap:8px;background:rgba(0,0,0,0.3);border-radius:16px;padding:8px;margin-bottom:24px;overflow-x:auto;position:sticky;top:70px;z-index:9;border:1px solid var(--border);scrollbar-width:none}
.admin-tabs::-webkit-scrollbar{display:none}
.admin-tab{padding:10px 20px;border:none;background:transparent;font-weight:800;font-size:14px;cursor:pointer;border-radius:10px;color:var(--text-muted);white-space:nowrap;transition:.2s;font-family:inherit}
.admin-tab.active{background:var(--grad-primary);color:#000;box-shadow:0 4px 15px rgba(0,242,254,.3)}
.admin-panel{display:none}
.admin-panel.active{display:block;animation:fadeUp .3s}
.admin-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:24px;margin-bottom:20px;box-shadow:var(--sh-sm)}
.admin-card-title{font-size:18px;font-weight:900;color:#fff;margin-bottom:20px;display:flex;align-items:center;gap:8px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.admin-grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.admin-grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px}
.admin-field{margin-bottom:16px}
.admin-field label{display:block;font-size:12px;font-weight:800;color:var(--accent);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.admin-field input,.admin-field select,.admin-field textarea{width:100%;padding:14px;border:1px solid var(--border);border-radius:10px;font-size:14px;background:rgba(0,0,0,0.3);outline:none;color:#fff;font-family:inherit}
.admin-field textarea{resize:vertical;min-height:100px;font-family:monospace}

.admin-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-bottom:24px}
.admin-stat{background:linear-gradient(145deg,rgba(30,41,59,0.8),rgba(15,23,42,0.9));border:1px solid var(--border);border-radius:16px;padding:20px;text-align:center;box-shadow:var(--sh-sm)}
.admin-stat .as-icon{font-size:32px;margin-bottom:8px}
.admin-stat .as-value{font-size:24px;font-weight:900;color:#fff}
.admin-stat .as-label{font-size:12px;color:var(--text-muted);font-weight:800;text-transform:uppercase;letter-spacing:1px;margin-top:4px}

.user-row{display:flex;align-items:center;gap:16px;padding:16px;background:rgba(0,0,0,0.2);border-radius:16px;margin-bottom:12px;border:1px solid var(--border)}
.user-row .ur-av{width:48px;height:48px;border-radius:50%;background:var(--grad-primary);color:#000;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;flex-shrink:0}
.user-row .ur-body{flex:1;min-width:0}
.user-row .ur-name{font-size:15px;font-weight:800;color:#fff;margin-bottom:4px}
.user-row .ur-sub{font-size:13px;color:var(--text-muted)}
.user-row .ur-actions{display:flex;gap:8px;flex-wrap:wrap}

@media(max-width:768px){
  .app-shell{padding-top:120px;padding-left:10px;padding-right:10px}
  .nav-menu-bar{padding:10px}
  .slot-main{flex-direction:column}
  .slot-btns{flex-direction:row;width:100%;margin-top:10px}
  .slot-btn{flex:1}
  .slot-reels{border-radius:12px}
  .reel-column{min-height:240px}
  .slot-title{font-size:28px;letter-spacing:4px}
  .balance-amount{font-size:36px}
  .action-grid{grid-template-columns:repeat(2,1fr)}
  .user-row{flex-direction:column;align-items:flex-start}
  .user-row .ur-actions{width:100%;justify-content:space-between}
}
</style>
</head>
<body>

<!-- TOP NAVIGATION -->
