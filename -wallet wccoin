function slotCheckWin(results) {
  let totalWin = 0; const winPositions = []; const winLines = []; let hasJackpot = false;
  const scatterPos = [];
  for (let c = 0; c < 5; c++) for (let r = 0; r < REEL_VISIBLE; r++) {
    if (results[c][r] === SCATTER_SYMBOL) scatterPos.push({ col: c, row: r });
  }
  let bombFreeSpins = 0;
  const freeSpinChance = Math.random() * 100 < slotConfig.freeSpinRate;
  if (scatterPos.length >= 3 || freeSpinChance) {
    if (scatterPos.length === 3) bombFreeSpins = 5;
    else if (scatterPos.length === 4) bombFreeSpins = 7;
    else if (scatterPos.length >= 5) bombFreeSpins = 10;
    else bombFreeSpins = 3;
    slotState.freeSpins += bombFreeSpins;
    slotState.isFreeSpin = true;
    if($('slotFreeSpin')) $('slotFreeSpin').classList.add('show');
    scatterPos.forEach(p => {
      winPositions.push(p);
      const strip = _reelStrips[p.col]; if (!strip) return;
      const cell = strip.children[REEL_BUFFER + p.row];
      if (cell) { const s = cell.querySelector('.sym'); if (s) s.classList.add('scatter'); }
    });
  }
  
  const lines = [
    { positions: [{c:0,r:0},{c:1,r:0},{c:2,r:0},{c:3,r:0},{c:4,r:0}], dir:'➡️' },
    { positions: [{c:0,r:1},{c:1,r:1},{c:2,r:1},{c:3,r:1},{c:4,r:1}], dir:'➡️' },
    { positions: [{c:0,r:2},{c:1,r:2},{c:2,r:2},{c:3,r:2},{c:4,r:2}], dir:'➡️' },
    { positions: [{c:0,r:3},{c:1,r:3},{c:2,r:3},{c:3,r:3},{c:4,r:3}], dir:'➡️' },
    { positions: [{c:0,r:4},{c:1,r:4},{c:2,r:4},{c:3,r:4},{c:4,r:4}], dir:'➡️' },
    { positions: [{c:0,r:0},{c:1,r:1},{c:2,r:2},{c:3,r:3},{c:4,r:4}], dir:'↘️' },
    { positions: [{c:0,r:4},{c:1,r:3},{c:2,r:2},{c:3,r:1},{c:4,r:0}], dir:'↗️' },
    { positions: [{c:0,r:0},{c:1,r:1},{c:2,r:2},{c:3,r:1},{c:4,r:0}], dir:'V' },
    { positions: [{c:0,r:4},{c:1,r:3},{c:2,r:2},{c:3,r:3},{c:4,r:4}], dir:'^' }
  ];
  
  lines.forEach(line => {
    const syms = line.positions.map(p => results[p.c][p.r]);
    const firstSym = syms[0];
    if (!firstSym || firstSym === SCATTER_SYMBOL) return;
    let count = 1; const matchedPositions = [0];
    for (let i = 1; i < syms.length; i++) {
      if (syms[i] === firstSym) { count++; matchedPositions.push(i); } else break;
    }
    if (PAYOUTS[firstSym] && count >= 3) {
      const mult = PAYOUTS[firstSym][count];
      if (mult) {
        const amount = slotState.bet * mult;
        totalWin += amount;
        if (count >= 5) hasJackpot = true;
        const mp = matchedPositions.map(i => line.positions[i]);
        winLines.push({ positions: mp, symbol: firstSym, matchCount: count, winAmount: amount, dir: line.dir });
        mp.forEach(p => winPositions.push(p));
      }
    }
  });
  
  const maxWin = slotState.bet * slotConfig.maxWinMultiplier;
  if (totalWin > maxWin) totalWin = maxWin;
  
  if (totalWin > 0) {
    slotState.credit += totalWin;
    if($('slotWinDisplay')) $('slotWinDisplay').textContent = fmt(totalWin);
    if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit);
    addCoins(totalWin, 'game_reward', { desc: '🎰 Slot Win', game: 'Slot' }).then(ok => {
      if (ok) { showCoinReward(totalWin); coinBalance = slotState.credit; updateAllUI(); }
    });
    db.ref('users/' + currentUser.uid + '/total_wins').set(totalWins + totalWin).catch(()=>{});
    
    let winText = '🎉 WIN!', color = '#00ffcc', sound;
    if (hasJackpot || totalWin >= slotState.bet * 500) { winText = '🏆 JACKPOT!'; color = '#ff00ff'; sound = playBigWinSound; }
    else if (totalWin >= slotState.bet * 100) { winText = '💎 MEGA WIN!'; color = '#ff00ff'; sound = playBigWinSound; }
    else if (totalWin >= slotState.bet * 50) { winText = '🌟 SUPER WIN!'; color = '#ffcc00'; sound = playBigWinSound; }
    else { sound = playWinSound; }
    if (sound) sound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = winText; eff.style.color = color; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2800); }
    
    const linesHtml = winLines.map(l => `<span style="display:inline-block;background:rgba(251,191,36,.15);border:1px solid rgba(251,191,36,.5);border-radius:6px;padding:3px 8px;margin:2px;font-size:11px;">${l.dir} ${l.matchCount}×${fmt(l.winAmount)}</span>`).join('');
    if($('slotMessage')) $('slotMessage').innerHTML = `<div style="width:100%;text-align:center;margin-bottom:6px;font-size:16px;">${winText} = <span style="color:#ffcc00">${fmt(totalWin)} WCCoin</span></div><div style="width:100%;text-align:center">${linesHtml}</div>`;
    
    winPositions.forEach(p => {
      const strip = _reelStrips[p.col]; if (!strip) return;
      const cell = strip.children[REEL_BUFFER + p.r];
      if (cell) { const s = cell.querySelector('.sym'); if (s && !s.classList.contains('scatter')) s.classList.add('win'); }
    });
    
    const overlay = $('winLinesOverlay');
    const svg = $('winLinesSvg');
    if (overlay && svg && winLines.length > 0) {
      overlay.classList.add('show');
      const slotReelsRect = $('slotReels').getBoundingClientRect();
      let svgContent = '';
      winLines.forEach(line => {
        const points = line.positions.map(p => {
          const strip = _reelStrips[p.c]; if (!strip) return null;
          const cell = strip.children[REEL_BUFFER + p.r]; if (!cell) return null;
          const rect = cell.getBoundingClientRect();
          return { x: rect.left + rect.width / 2 - slotReelsRect.left, y: rect.top + rect.height / 2 - slotReelsRect.top };
        }).filter(Boolean);
        if (points.length >= 2) {
          const path = points.map((pt, i) => `${i === 0 ? 'M' : 'L'} ${pt.x} ${pt.y}`).join(' ');
          svgContent += `<path d="${path}" stroke="#ff00ff" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="drop-shadow(0 0 8px #ff00ff)" style="animation:pulse 0.5s infinite alternate"/>`;
        }
      });
      svg.innerHTML = svgContent;
      setTimeout(() => { overlay.classList.remove('show'); svg.innerHTML = ''; }, 3000);
    }
  }
  
  if (bombFreeSpins > 0) {
    playFreeSpinSound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = '💣 FREE SPIN!'; eff.style.color = '#ff00ff'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2500); }
    const bombMsg = `💣 <span style="color:#ff00ff">BOMB ${scatterPos.length}!</span> Free Spin ${bombFreeSpins} ခါ!`;
    if ($('slotMessage')) {
      if (totalWin > 0) $('slotMessage').innerHTML += `<div style="width:100%;text-align:center;margin-top:4px;font-size:14px;">${bombMsg}</div>`;
      else $('slotMessage').innerHTML = bombMsg;
    }
  } else if (totalWin === 0) {
    playLoseSound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = 'LOSE'; eff.style.color = '#ff4444'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 1500); }
    if($('slotMessage')) $('slotMessage').innerHTML = '😢 <span style="color:#ff4444">LOSE!</span> ထပ်ကြိုးစားပါ';
  }
}

