<div class="toast-container" id="toastContainer"></div>
<div class="coin-reward" id="coinReward"><div class="coin-icon"></div><span id="coinRewardText">+0 WCCoin</span></div>

<!-- AUTH SCREEN -->
<div id="authScreen" style="position:fixed;inset:0;background:var(--bg-main);z-index:9999;display:flex;align-items:center;justify-content:center;">
  <div class="auth-box" style="background:var(--bg-card);padding:40px;border-radius:24px;width:400px;max-width:90%;border:1px solid var(--border);">
    <h1 id="authTitle" style="text-align:center;color:var(--primary);margin-bottom:20px;">Login</h1>
    <form class="auth-form" id="loginForm">
      <div class="info-row"><input type="tel" id="loginPhone" placeholder="09xxxxxxxxx" required></div>
      <div class="info-row"><input type="password" id="loginPass" placeholder="Password" required></div>
      <p class="auth-err" id="loginErr" style="color:var(--danger);text-align:center;margin-bottom:10px;"></p>
      <button type="submit" class="btn btn-primary btn-block" id="loginBtn">Login</button>
    </form>
    <form class="auth-form hidden" id="signupForm">
      <div class="info-row"><input type="text" id="suName" placeholder="Full Name" required></div>
      <div class="info-row"><input type="tel" id="suPhone" placeholder="09xxxxxxxxx" required></div>
      <div class="info-row"><input type="password" id="suPass" placeholder="Password (6+ chars)" required></div>
      <div class="info-row"><select id="suGender" required><option value="">- လိင် -</option><option value="male">👨 ကျား</option><option value="female">👩 မ</option></select></div>
      <div class="info-row"><select id="suAge" required><option value="">- အသက် -</option><option value="18-24">18-24</option><option value="25-34">25-34</option><option value="45+">45+</option></select></div>
      <p class="auth-err" id="signupErr" style="color:var(--danger);text-align:center;margin-bottom:10px;min-height:20px;"></p>
      <button type="submit" class="btn btn-gold btn-block" id="signupBtn">Sign Up</button>
    </form>
    <div style="text-align:center;margin-top:20px;">
      <a href="#" id="switchAuthBtn" style="color:var(--text-muted);font-size:14px;text-decoration:none;">Switch to Sign Up</a>
    </div>
  </div>
</div>

<!-- APP SHELL -->
<div class="app-shell" id="appShell">
  <div class="topbar">
    <div class="topbar-left"><h2 id="pageTitle">Dashboard</h2><p id="pageSubtitle">သင့်ရဲ့ WCCoin နဲ့ Slot ဂိမ်း</p></div>
    <div class="topbar-right">
      <button class="avatar-btn" onclick="gotoPage('settings')" style="width:44px;height:44px;border-radius:50%;background:var(--grad-primary);color:#000;font-weight:900;font-size:18px;border:none;cursor:pointer;"><span id="topAvatar">W</span></button>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div class="page-view active" id="page-dashboard">
    <div class="balance-card">
      <div class="balance-label">Total Balance</div>
      <div class="balance-amount"><div class="coin-icon"></div><span id="mainBalance">0</span><small>WCCoin</small></div>
      <div class="balance-actions">
        <button class="balance-action" onclick="gotoPage('play')">🎰 Play Slot</button>
        <button class="balance-action" onclick="gotoPage('gift')">🎁 Gift Shop</button>
      </div>
    </div>
    <div class="stats-grid">
      <div class="stat-box"><div class="sb-label">Today's Earned</div><div class="sb-value"><div class="inline-coin"></div><span id="statToday">0</span></div></div>
      <div class="stat-box"><div class="sb-label">Games Played</div><div class="sb-value"><span id="statGames">0</span></div></div>
      <div class="stat-box"><div class="sb-label">Total Wins</div><div class="sb-value"><div class="inline-coin"></div><span id="statWins">0</span></div></div>
    </div>
    <div class="action-grid">
      <button class="action-tile" onclick="gotoPage('games')"><div class="at-icon">🎮</div><h4>Game Hub</h4><p>ဂိမ်းများ</p></button>
      <button class="action-tile" onclick="gotoPage('transfer')"><div class="at-icon">💸</div><h4>Transfer</h4><p>လွှဲပို့ရန်</p></button>
      <button class="action-tile" onclick="gotoPage('buy')"><div class="at-icon">🛒</div><h4>Buy Coin</h4><p>ဝယ်ယူရန်</p></button>
      <button class="action-tile" onclick="gotoPage('history')"><div class="at-icon">📜</div><h4>History</h4><p>မှတ်တမ်း</p></button>
    </div>
  </div>

  <!-- PLAY SLOT -->
  <div class="page-view" id="page-play">
    <div class="slot-wrapper">
      <div class="slot-top">
        <div class="slot-credit"><div class="coin-icon"></div><span class="lbl">WCCoin</span><span class="val" id="slotCredit">0</span></div>
        <div class="slot-top-right"><button class="slot-btn-sm" onclick="refreshSlot()">🔄</button></div>
      </div>
      <div class="slot-title">SLOT</div>
      <div class="slot-subtitle">WCCoin · 5×5 · WIN <span id="slotWinRateLabel">40</span>%</div>
      <div class="slot-info-row">
        <div class="slot-info-item"><div class="lbl">BET</div><div class="val" id="slotBetDisplay">10</div></div>
        <div class="slot-info-item"><div class="lbl">WIN</div><div class="val" id="slotWinDisplay">0</div></div>
        <div class="slot-info-item vip"><div class="lbl">VIP</div><div class="val" id="slotVipDisplay">🥉</div></div>
      </div>
      <div class="slot-main">
        <div class="slot-reels" id="slotReels">
          <div class="reels-container" id="reelsContainer"></div>
          <div class="win-lines-overlay" id="winLinesOverlay"><svg id="winLinesSvg"></svg></div>
          <div class="slot-effect" id="slotEffect"></div>
          <div class="slot-freespin" id="slotFreeSpin"></div>
        </div>
        <div class="slot-btns">
          <button class="slot-btn slot-spin" id="slotSpinBtn" onclick="slotSpin()">🎰<br><span class="btn-label">SPIN</span></button>
          <button class="slot-btn slot-auto" id="slotAutoBtn" onclick="slotToggleAuto()">🔄<br><span class="btn-label">AUTO</span></button>
          <button class="slot-btn slot-turbo" id="slotTurboBtn" onclick="slotToggleTurbo()">⚡<br><span class="btn-label">TURBO</span></button>
        </div>
      </div>
      <div class="slot-bet-row">
        <div class="bet-ctrl" style="position:relative;">
          <button onclick="slotChangeBet(-5)">−</button>
          <div style="text-align:center"><div class="bl">BET</div><div class="bv" id="slotBetValue">10</div></div>
          <button onclick="slotChangeBet(5)">+</button>
        </div>
        <div class="quick-bets"><button class="q2x" onclick="slotQuickBet(2)">2×</button><button class="q3x" onclick="slotQuickBet(3)">3×</button><button class="q5x" onclick="slotQuickBet(5)">5×</button></div>
        <button class="daily-btn" onclick="slotDailyBonus()">🎁</button>
      </div>
      <div class="slot-msg" id="slotMessage">🎰 SPIN နှိပ်ပြီး ကစားပါ</div>
    </div>
  </div>

  <!-- GAME HUB -->
  <div class="page-view" id="page-games">
    <div style="margin-bottom:20px;font-size:16px;color:var(--text-muted);font-weight:600;">Admin ထည့်ထားတဲ့ ဂိမ်းများ</div>
    <div class="gift-grid" id="gameHubGrid"></div>
  </div>

  <!-- GIFT SHOP -->
  <div class="page-view" id="page-gift">
