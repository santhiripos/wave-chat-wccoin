   ============================================================ */
let _updateVersion = null;
function checkUpdate() {
  if (!db) return;
  db.ref('app_config/version').once('value').then(snap => {
    const v = snap.val();
    if (!v || !v.latest) return;
    const cmp = compareVersion(APP_VERSION, v.latest);
    if (cmp >= 0) return;
    const dismissed = localStorage.getItem('wc_version_dismissed');
    if (dismissed === v.latest) return;
    if (_updateVersion && _updateVersion.latest === v.latest) return;
    showUpdateModal(v);
  }).catch(() => {});
}
function compareVersion(a, b) {
  const pa = String(a || '0').split('.').map(n => parseInt(n, 10) || 0);
  const pb = String(b || '0').split('.').map(n => parseInt(n, 10) || 0);
  const len = Math.max(pa.length, pb.length);
  for (let i = 0; i < len; i++) { const x = pa[i] || 0, y = pb[i] || 0; if (x > y) return 1; if (x < y) return -1; }
  return 0;
}
function showUpdateModal(v) {
  _updateVersion = v;
  if($('newVerLabel')) $('newVerLabel').textContent = v.latest;
  if($('releaseNotes')) $('releaseNotes').textContent = v.releaseNotes || 'Bug fixes';
  $('updateModal').classList.add('show');
}
function applyUpdate() {
  if (!_updateVersion) { closeModal('updateModal'); return; }
  localStorage.setItem('wc_version_dismissed', _updateVersion.latest);
  _updateVersion = null;
  closeModal('updateModal');
  if ('caches' in window) { caches.keys().then(names => { for (let name of names) caches.delete(name); }).catch(()=>{}); }
  toast('🔄 Updating...', 'info');
  setTimeout(() => { window.location.href = window.location.href.split('?')[0] + '?t=' + Date.now(); }, 600);
}
function checkUpdateManually() {
  toast('🔄 Checking...', 'info');
  db.ref('app_config/version').once('value').then(snap => {
    const v = snap.val();
    if (!v || !v.latest) return toast('Version info မရှိပါ', 'warn');
    const cmp = compareVersion(APP_VERSION, v.latest);
    if (cmp >= 0) return toast('✅ Latest', 'success');
    showUpdateModal(v);
  }).catch(err => toast('Failed: ' + err.message, 'error'));
}

/* ============================================================
   INIT - ပြင်ဆင်ပြီး
   ============================================================ */
function init() {
  loadSettingsLocal();
  generateReels();
  window.addEventListener('resize', () => { setTimeout(() => { resetReelPositions(); }, 100); });
  
  db.ref('app_config/coin_packages').on('value', snap => { allCoinPackages = snap.val() || {}; renderPkgGrid(); });
  db.ref('gifts').on('value', snap => { allGifts = snap.val() || {}; renderGiftGrid(); });
  db.ref('games').on('value', snap => { allGames = snap.val() || {}; renderGameHub(); });
  db.ref('app_config/slot_config').on('value', snap => {
    if (snap.val()) { slotConfig = Object.assign(slotConfig, snap.val()); if($('slotWinRateLabel')) $('slotWinRateLabel').textContent = slotConfig.winRate; }
  });
  db.ref('app_config/slot_force_mode').on('value', snap => { slotForceMode = snap.val() || 'auto'; });
  
  // ✅ Switch button - JS ပဲ assign လုပ်သည် (HTML inline onclick ဖျက်ထားပြီး)
  const switchBtn = $('switchAuthBtn');
  if (switchBtn) {
    switchBtn.onclick = (e) => {
      e.preventDefault();
      const isLogin = !$('loginForm').classList.contains('hidden');
      showAuthTab(isLogin ? 'signup' : 'login');
    };
  }
  
  // ✅ Login form
  $('loginForm').onsubmit = async e => {
    e.preventDefault();
    const b = $('loginBtn');
    const errEl = $('loginErr');
    errEl.textContent = '';
    b.disabled = true; b.textContent = '...';
    try {
      const phone = $('loginPhone').value.trim();
      const pass = $('loginPass').value;
      if (!phone) throw new Error('ဖုန်းနံပါတ် ထည့်ပါ');
      if (!pass) throw new Error('Password ထည့်ပါ');
      await login(phone, pass);
      toast('Welcome', 'success');
    } catch(err) {
      errEl.textContent = authErrMsg(err);
    } finally {
      b.disabled = false; b.textContent = 'Login';
    }
  };
  
  // ✅ Signup form - validation နဲ့ မြန်မာ error ထည့်ပြီး
  $('signupForm').onsubmit = async e => {
    e.preventDefault();
    const b = $('signupBtn');
    const errEl = $('signupErr');
    errEl.textContent = '';
    b.disabled = true; b.textContent = '...';
    try {
      const name = $('suName').value.trim();
      const phone = $('suPhone').value.trim();
      const pass = $('suPass').value;
      const gender = $('suGender').value;
      const age = $('suAge').value;
      
      if (!name || name.length < 2) throw new Error('နာမည် အနည်းဆုံး ၂ လုံး ထည့်ပါ');
      if (!/^09\d{7,9}$/.test(phone.replace(/\s/g,''))) throw new Error('ဖုန်းနံပါတ် မှန်ကန်စွာ ထည့်ပါ (09xxxxxxxxx)');
      if (!pass || pass.length < 6) throw new Error('Password အနည်းဆုံး ၆ လုံး ထည့်ပါ');
      if (!gender) throw new Error('လိင် ရွေးပါ');
      if (!age) throw new Error('အသက် ရွေးပါ');
      
      await signup(name, phone, pass, gender, age);
      toast('✅ Account ဖွင့်ပြီးပါပြီ!', 'success');
    } catch(err) {
      errEl.textContent = authErrMsg(err);
    } finally {
      b.disabled = false; b.textContent = 'Sign Up';
    }
  };
  
  document.querySelectorAll('.nav-btn[data-page]').forEach(btn => btn.onclick = () => gotoPage(btn.dataset.page));
  document.querySelectorAll('.admin-tab').forEach(btn => btn.onclick = () => {
    document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    $('admPanel-' + btn.dataset.tab).classList.add('active');
  });
  document.querySelectorAll('.modal-overlay').forEach(ov => ov.addEventListener('click', e => { if(e.target === ov) ov.classList.remove('show'); }));
  
  auth.onAuthStateChanged(async u => {
    if(u) {
      const s = await db.ref('users/'+u.uid).once('value');
      const d = s.val();
      if(!d) { auth.signOut(); return; }
      currentUser = { uid: u.uid, ...d };
      isAdmin = d.isAdmin === true;
      showScreen('app');
      loadUserData();
      updateAllUI();
    } else {
      showScreen('auth');
    }
  });
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
</script>
</body>
