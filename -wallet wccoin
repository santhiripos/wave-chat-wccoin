      <button class="btn btn-primary btn-block" id="doTransferBtn" onclick="doTransfer()">ငွေလွှဲမည်</button>
    </div>
  </div>

  <!-- BUY -->
  <div class="page-view" id="page-buy">
    <div class="admin-card">
      <h3 style="margin-bottom:20px;color:var(--primary);">🛒 Buy WCCoin</h3>
      <div class="pkg-grid" id="pkgGrid"></div>
      <div class="info-row" style="margin-top:20px;"><label>ငွေပေးချေမှု Note</label><textarea id="buyNote" placeholder="KBZ Pay ref..."></textarea></div>
      <button class="btn btn-gold btn-block" id="reqBuyBtn" onclick="requestBuyCoins()">🛒 Request ပို့မည်</button>
    </div>
    <div class="section-header" style="margin-top:20px;margin-bottom:10px;"><h3>📋 ကျွန်ုပ်၏ Requests</h3></div>
    <div id="myBuyRequests"></div>
  </div>

  <!-- HISTORY -->
  <div class="page-view" id="page-history">
    <div class="admin-card">
      <h3 style="margin-bottom:20px;color:var(--primary);">📜 Transaction History</h3>
      <div class="history-list" id="historyList"></div>
    </div>
  </div>

  <!-- SETTINGS -->
  <div class="page-view" id="page-settings">
    <div class="admin-card">
      <h3 style="margin-bottom:20px;color:var(--primary);">⚙️ Settings</h3>
      <div class="info-row"><label>Name</label><input type="text" id="setName"></div>
      <div class="info-row"><label>Phone</label><input type="tel" id="setPhone" disabled></div>
      <button class="btn btn-primary btn-block" onclick="saveSettings()">Save</button>
    </div>
    <div class="admin-card" style="margin-top:20px;">
      <button class="btn btn-secondary btn-block" onclick="checkUpdateManually()">Check for Update</button>
      <button class="btn btn-secondary btn-block" style="margin-top:10px;" onclick="openAdminLogin()">👑 Admin Panel</button>
    </div>
  </div>
</div>

<!-- ADMIN PANEL -->
