function openGiftExchange(giftId) {
  const g = allGifts[giftId]; if (!g) return;
  if (coinBalance < (g.price || 0)) { toast(' WCCoin မလုံေလာက္ပါ', 'warn'); return; }
  if (g.stock === 0) { toast(' ကုန္သြားပါၿပီ', 'warn'); return; }
  selectedGiftId = giftId;
  const imgHtml = g.image ? `<img src="${esc(g.image)}" style="width:100%;height:200px;object-fit:cover;border-radius:16px;margin-bottom:16px" onerror="this.style.display='none'">` : `<div style="font-size:100px;text-align:center;margin-bottom:16px">${esc(g.emoji || '')}</div>`;
  $('giftExchangeBody').innerHTML = `${imgHtml}<h3 style="font-size:20px;font-weight:900;margin-bottom:8px;text-align:center">${esc(g.name)}</h3><p style="font-size:14px;color:var(--text-2);font-weight:600;text-align:center;margin-bottom:18px">${esc(g.desc || '')}</p><div style="background:var(--surface-2);border-radius:14px;padding:16px;margin-bottom:12px"><div style="display:flex;justify-content:space-between;font-weight:800;font-size:15px;margin-bottom:8px"><span>ေဈးႏႈန္း:</span><span style="color:#C44569">${fmt(g.price)} WCCoin</span></div><div style="display:flex;justify-content:space-between;font-weight:800;font-size:15px;margin-bottom:8px"><span>သင့္လက္က်န္:</span><span style="color:var(--wc-blue)">${fmt(coinBalance)} WCCoin</span></div><div style="display:flex;justify-content:space-between;font-weight:800;font-size:15px;border-top:2px solid var(--border);padding-top:10px;margin-top:10px"><span>က်န္မည္:</span><span style="color:var(--green)">${fmt(coinBalance - g.price)} WCCoin</span></div></div><p style="font-size:13px;color:var(--text-2);font-weight:600;text-align:center">Admin approve လုပ္ၿပီးမွ လက္ေဆာင္ ရရွိပါမည္</p>`;
  $('giftExchangeModal').classList.add('show');
}

async function confirmGiftExchange() {
  if (!selectedGiftId || !currentUser) return;
  const g = allGifts[selectedGiftId]; if (!g) return;
  if (coinBalance < g.price) { toast(' WCCoin မလုံေလာက္ပါ', 'warn'); return; }
  if (g.stock === 0) { toast(' ကုန္သြားပါၿပီ', 'warn'); return; }
  const btn = event.target; btn.disabled = true;
  try {
    const ok = await addCoins(-g.price, 'gift_exchange', { desc: ` Gift: ${g.name}`, giftId: selectedGiftId, giftName: g.name });
    if (!ok) throw new Error('WCCoin ႏုတ္မရပါ');
    if (g.stock > 0) await db.ref('gifts/' + selectedGiftId + '/stock').transaction(c => Math.max(0, (c || 0) - 1)).catch(()=>{});
    await db.ref('gift_orders').push({ uid: currentUser.uid, userName: currentUser.name, phone: currentUser.phone, giftId: selectedGiftId, giftName: g.name, giftImage: g.image || '', giftEmoji: g.emoji || '', price: g.price, status: 'pending', ts: Date.now() });
    toast(' လဲလွယ္ၿပီး! Admin approve လုပ္ပါမည္', 'success');
    showCoinReward(-g.price);
    closeModal('giftExchangeModal');
    selectedGiftId = null;
    loadMyGiftOrders();
  } catch(e) { toast(' ' + e.message, 'error'); } finally { btn.disabled = false; }
}

function loadMyGiftOrders() {
  if (!currentUser) return;
  db.ref('gift_orders').orderByChild('uid').equalTo(currentUser.uid).once('value').then(snap => {
    const data = snap.val() || {};
    const list = Object.entries(data).sort((a,b) => (b[1].ts||0) - (a[1].ts||0)).slice(0, 15);
    const wrap = $('myGiftOrders'); if (!wrap) return;
    if (list.length === 0) { wrap.innerHTML = '<div class="empty-state"><span class="em"></span><h3>Order မရွိေသးပါ</h3></div>'; return; }
    wrap.innerHTML = list.map(([id, o]) => {
      const statusColor = o.status === 'approved' ? '#00D9A3' : o.status === 'rejected' ? '#FF4757' : '#FFB800';
      const statusIcon = o.status === 'approved' ? '' : o.status === 'rejected' ? '' : '';
      const imgHtml = o.giftImage ? `<img src="${esc(o.giftImage)}" style="width:100%;height:100%;object-fit:cover;border-radius:10px" onerror="this.parentElement.innerHTML='${esc(o.giftEmoji || '')}'">` : `${esc(o.giftEmoji || '')}`;
      return `<div class="req-card"><div style="width:60px;height:60px;border-radius:12px;background:#FFF;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:28px">${imgHtml}</div><div class="req-body"><div class="req-title">${esc(o.giftName)}</div><div class="req-sub">${fmt(o.price)} WCCoin  ${new Date(o.ts || Date.now()).toLocaleString()}  <span style="color:${statusColor};font-weight:800">${statusIcon} ${esc(o.status || 'pending')}</span></div></div></div>`;
    }).join('');
  }).catch(() => {});
}

