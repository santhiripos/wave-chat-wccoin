function loadMyBuyRequests() {
  if (!currentUser) return;
  db.ref('coin_buy_requests').orderByChild('uid').equalTo(currentUser.uid).once('value').then(snap => {
    const data = snap.val() || {}; const list = Object.entries(data).sort((a,b) => (b[1].ts||0) - (a[1].ts||0)).slice(0, 10);
    const wrap = $('myBuyRequests'); if (!wrap) return;
    if (list.length === 0) { wrap.innerHTML = '<div class="empty-state"><span class="em">🛒</span><h3>Request မရှိသေးပါ</h3></div>'; return; }
    wrap.innerHTML = list.map(([id, r]) => {
      const statusColor = r.status === 'approved' ? 'var(--success)' : r.status === 'rejected' ? 'var(--danger)' : 'var(--accent)';
      const statusIcon = r.status === 'approved' ? '✅' : r.status === 'rejected' ? '❌' : '⏳';
      return `<div class="req-card"><div style="font-size:24px">${statusIcon}</div><div class="req-body"><div class="req-title">${fmt(r.coins || 0)} WCCoin${r.bonus ? ' (+' + r.bonus + ' bonus)' : ''} · ${esc(r.price || '')}</div><div class="req-sub">${new Date(r.ts || Date.now()).toLocaleString()} · <span style="color:${statusColor};font-weight:800">${esc(r.status || 'pending')}</span></div></div></div>`;
    }).join('');
  }).catch(() => {});
}

