<!DOCTYPE html>
<html lang="my">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#00B4D8">
<title>WC Wallet + Slot</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Padauk:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --wc-blue:#00B4D8;--wc-blue-dark:#0077B6;--wc-gold:#FFB800;--wc-gold-dark:#FF8C00;
  --bg:#F0F4F8;--surface:#FFF;--surface-2:#F8FAFC;--text:#1A202C;--text-2:#64748B;
  --border:#E2E8F0;--green:#00D9A3;--red:#FF4757;--warn:#FFB800;
  --grad:linear-gradient(135deg,#00B4D8,#0077B6);
  --grad-gold:linear-gradient(135deg,#FFB800,#FF8C00);
  --r:16px;--r-pill:999px;
  --sh-sm:0 2px 6px rgba(0,0,0,.06);--sh-md:0 6px 20px rgba(0,0,0,.08);
  --sh-lg:0 12px 32px rgba(0,0,0,.12);
  --slot-bg:#0d021a;--panel:#1a0b2e;--header:#2a0845;
  --gold:#ffcc00;--cyan:#00ffcc;--pink:#ff00ff;
  --reel:#fff8e7;--reel-text:#333;
}
body{font-family:'Inter','Padauk',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased;font-size:15px}
.hidden{display:none!important}

/* ===== LOADING ===== */
.loading{position:fixed;inset:0;background:rgba(255,255,255,.85);display:none;align-items:center;justify-content:center;z-index:99999;backdrop-filter:blur(4px)}
.loading.show{display:flex}
.spinner{width:50px;height:50px;border:5px solid rgba(0,180,216,.15);border-top-color:var(--wc-blue);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== AUTH SCREEN ===== */
#authScreen{display:none;min-height:100vh;background:linear-gradient(135deg,#00B4D8 0%,#0077B6 50%,#03045E 100%);align-items:center;justify-content:center;padding:20px;position:fixed;inset:0;z-index:1000;overflow-y:auto}
#authScreen.active{display:flex}
.auth-logo{position:absolute;top:30px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:14px;z-index:10}
.auth-logo-mark{width:60px;height:60px;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;color:#0077B6;box-shadow:0 10px 32px rgba(0,0,0,.2);letter-spacing:-1px}
.auth-logo-text{font-size:32px;font-weight:900;color:#fff;letter-spacing:-1px}
.auth-logo-text span{color:#48CAE4}
.auth-box{background:#FFF;padding:44px 32px 36px;border-radius:28px;box-shadow:0 30px 80px rgba(0,0,0,.3);width:420px;max-width:100%;position:relative;z-index:5;margin:80px 0 20px}
.auth-box h1{font-size:32px;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-align:center;margin-bottom:8px}
.auth-box .subtitle{text-align:center;color:var(--text-2);font-size:16px;margin-bottom:26px;font-weight:600}
.auth-tabs{display:flex;background:var(--surface-2);border-radius:var(--r-pill);padding:6px;margin-bottom:24px}
.auth-tab{flex:1;padding:14px;border:none;background:transparent;cursor:pointer;font-weight:800;font-size:16px;color:var(--text-2);border-radius:var(--r-pill);font-family:inherit;transition:.2s}
.auth-tab.active{background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}
.auth-form{display:flex;flex-direction:column;gap:16px}
.auth-input-group{position:relative;display:flex;align-items:center}
.auth-input-group .ico{position:absolute;left:18px;font-size:20px;pointer-events:none;z-index:1}
.auth-form input{width:100%;padding:16px 18px 16px 52px;border:2px solid var(--border);border-radius:14px;font-size:16px;background:var(--surface-2);transition:.2s;outline:none;color:var(--text);font-family:inherit;font-weight:600}
.auth-form input:focus{border-color:var(--wc-blue);background:#FFF;box-shadow:0 0 0 4px rgba(0,180,216,.1)}
.auth-btn{background:var(--grad);color:#fff;padding:16px;border:none;border-radius:14px;font-weight:900;cursor:pointer;font-size:18px;font-family:inherit;transition:.2s;box-shadow:0 6px 20px rgba(0,180,216,.3);margin-top:8px}
.auth-btn:hover{transform:translateY(-2px)}
.auth-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.auth-err{color:var(--red);font-size:15px;text-align:center;min-height:22px;font-weight:700}
.auth-footer{margin-top:24px;text-align:center;font-size:14px;color:var(--text-2);font-weight:600}

/* ===== TOASTS ===== */
.toast-container{position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;pointer-events:none;max-width:calc(100vw - 40px)}
.toast{background:#FFF;padding:16px 22px;border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.15);border-left:6px solid var(--wc-blue);font-size:16px;font-weight:700;color:var(--text);min-width:260px;max-width:380px;pointer-events:auto;display:flex;align-items:center;gap:12px;animation:slideRight .3s ease-out}
.toast.success{border-left-color:var(--green)}
.toast.error{border-left-color:var(--red)}
.toast.warn{border-left-color:var(--warn)}
@keyframes slideRight{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

.coin-reward{position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-200px);background:var(--grad-gold);color:#fff;padding:16px 28px;border-radius:36px;font-weight:900;font-size:20px;box-shadow:0 12px 32px rgba(255,184,0,.4);z-index:99998;transition:transform .4s cubic-bezier(.4,0,.2,1);pointer-events:none;display:flex;align-items:center;gap:10px}
.coin-reward.show{transform:translateX(-50%) translateY(0)}
.coin-reward .coin-icon{width:30px;height:30px}
.coin-reward .coin-icon img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,.2))}

/* ===== APP SHELL ===== */
.app-shell{display:none;min-height:100vh}
.app-shell.active{display:flex}
.sidebar{width:240px;background:#FFF;border-right:1px solid var(--border);padding:24px 16px;display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;z-index:20;overflow-y:auto}
.sidebar-logo{display:flex;align-items:center;gap:12px;padding:0 8px;margin-bottom:30px}
.logo-mark{width:48px;height:48px;border-radius:16px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#fff;box-shadow:0 4px 14px rgba(0,180,216,.35);letter-spacing:-1px}
.sidebar-logo h1{font-size:20px;font-weight:900;letter-spacing:-0.5px}
.sidebar-logo p{font-size:11px;color:var(--text-2);letter-spacing:1px;text-transform:uppercase;font-weight:700;margin-top:2px}
.nav-section{font-size:12px;color:var(--text-2);font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:0 12px;margin:20px 0 10px}
.nav-item{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;cursor:pointer;transition:.2s;color:var(--text-2);font-size:15px;font-weight:700;margin-bottom:4px;border:none;background:transparent;width:100%;text-align:left;font-family:inherit}
.nav-item .ni-icon{font-size:20px;width:24px;text-align:center}
.nav-item:hover{background:var(--surface-2);color:var(--text)}
.nav-item.active{background:linear-gradient(90deg,rgba(0,180,216,.15),rgba(0,180,216,.03));color:var(--wc-blue-dark);border-left:4px solid var(--wc-blue)}
.nav-wallet{margin-top:8px}
.wallet-row{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:14px;cursor:pointer;transition:.2s;margin-bottom:6px}
.wallet-row:hover{background:var(--surface-2)}
.wallet-row .wr-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.wallet-row .wr-meta{flex:1;min-width:0}
.wallet-row .wr-meta h5{font-size:15px;font-weight:800;margin-bottom:2px}
.wallet-row .wr-meta p{font-size:12px;color:var(--text-2);font-weight:600}
.sb-user{margin-top:auto;display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--surface-2);border:1px solid var(--border);cursor:pointer;transition:.2s}
.sb-user:hover{background:#FFF}
.sb-avatar{width:44px;height:44px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;color:#fff;flex-shrink:0}
.sb-user h5{font-size:15px;font-weight:800}
.sb-user p{font-size:12px;color:var(--text-2);font-weight:600}

.main-content{flex:1;margin-left:240px;padding:30px 36px 50px;position:relative;z-index:2}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;gap:16px;flex-wrap:wrap}
.topbar-left h2{font-size:28px;font-weight:900;letter-spacing:-1px}
.topbar-left p{font-size:15px;color:var(--text-2);margin-top:4px;font-weight:600}
.topbar-right{display:flex;align-items:center;gap:14px}
.avatar-btn{width:48px;height:48px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:20px;cursor:pointer;box-shadow:var(--sh-sm);position:relative;border:none;font-family:inherit}
.avatar-btn .status-dot{position:absolute;bottom:2px;right:2px;width:14px;height:14px;background:var(--green);border:3px solid #FFF;border-radius:50%}
.logout-btn{background:var(--surface);border:2px solid var(--border);border-radius:14px;padding:12px 18px;font-size:15px;font-weight:800;cursor:pointer;font-family:inherit;color:var(--red);transition:.2s}
.logout-btn:hover{background:#FFF0F1;border-color:var(--red)}

/* ===== PAGE VIEWS ===== */
.page-view{display:none}
.page-view.active{display:block;animation:fadeUp .3s ease-out}
@keyframes fadeUp{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}

/* ===== BALANCE / STATS / ACTIONS ===== */
.balance-card{background:linear-gradient(135deg,#00B4D8 0%,#0077B6 100%);border-radius:28px;padding:32px 30px;color:#fff;position:relative;overflow:hidden;margin-bottom:28px;box-shadow:0 12px 32px rgba(0,180,216,.28)}
.balance-card::before{content:'';position:absolute;top:-50%;right:-30%;width:320px;height:320px;background:rgba(255,255,255,.08);border-radius:50%}
.balance-card::after{content:'';position:absolute;bottom:-60%;left:-20%;width:260px;height:260px;background:rgba(255,255,255,.05);border-radius:50%}
.balance-label{font-size:14px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;opacity:.85;margin-bottom:12px;position:relative;z-index:2}
.balance-amount{font-size:48px;font-weight:900;letter-spacing:-2px;line-height:1.1;position:relative;z-index:2;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.balance-amount .coin-icon{width:44px;height:44px;display:flex;align-items:center;justify-content:center}
.balance-amount .coin-icon img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(0,0,0,.2))}
.balance-amount small{font-size:20px;font-weight:800;opacity:.9}
.balance-sub{font-size:15px;margin-top:12px;font-weight:600;opacity:.85;position:relative;z-index:2;display:flex;align-items:center;gap:8px}
.balance-actions{display:flex;gap:14px;margin-top:24px;position:relative;z-index:2}
.balance-action{flex:1;background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.35);color:#fff;padding:16px 12px;border-radius:16px;font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;transition:.2s;backdrop-filter:blur(10px)}
.balance-action:hover{background:rgba(255,255,255,.3);transform:translateY(-2px)}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-bottom:30px}
.stat-box{background:#FFF;border:1px solid var(--border);border-radius:22px;padding:22px 24px;box-shadow:var(--sh-sm);transition:.25s}
.stat-box:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
.stat-box .sb-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.stat-box .sb-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px}
.sb-wave .sb-icon{background:linear-gradient(135deg,#FFF3D0,#FFE29A)}
.sb-kpay .sb-icon{background:linear-gradient(135deg,#DDEEFF,#B8DCFF)}
.sb-wc .sb-icon{background:linear-gradient(135deg,#D0F9E8,#A8EFD3)}
.sb-total .sb-icon{background:linear-gradient(135deg,#E0F2FE,#BAE6FD)}
.stat-box .sb-label{font-size:14px;color:var(--text-2);font-weight:700;margin-bottom:8px}
.stat-box .sb-value{font-size:28px;font-weight:900;letter-spacing:-1px;line-height:1.15;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.stat-box .sb-value small{font-size:15px;font-weight:800;color:var(--text-2)}
.stat-box .sb-value .inline-coin{width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.stat-box .sb-value .inline-coin img{width:100%;height:100%;object-fit:contain}
.stat-box .sb-foot{font-size:13px;color:var(--text-2);margin-top:10px;font-weight:600}

.action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:30px}
.action-tile{background:#FFF;border:1px solid var(--border);border-radius:22px;padding:22px 18px;display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm);font-family:inherit;border:none}
.action-tile:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:rgba(0,180,216,.3)}
.action-tile .at-icon{width:64px;height:64px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:30px}
.at-play .at-icon{background:linear-gradient(135deg,#FFE4B8,#FFC97A)}
.at-receive .at-icon{background:linear-gradient(135deg,#D0F9E8,#A8EFD3)}
.at-history .at-icon{background:linear-gradient(135deg,#DDEEFF,#B8DCFF)}
.at-buy .at-icon{background:linear-gradient(135deg,#F3E4FF,#E0C8FF)}
.action-tile h4{font-size:16px;font-weight:800;color:var(--text);text-align:center;line-height:1.2}
.action-tile p{font-size:13px;color:var(--text-2);font-weight:600;text-align:center}

/* ===== WALLET CARDS ===== */
.wallets-section{margin-bottom:28px}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.section-header h3{font-size:22px;font-weight:900;letter-spacing:-0.5px;display:flex;align-items:center;gap:10px}
.section-header a{font-size:14px;color:var(--wc-blue-dark);font-weight:800;cursor:pointer;text-decoration:none}
.wallet-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px}
.wallet-card{background:#FFF;border:1px solid var(--border);border-radius:24px;padding:24px;position:relative;overflow:hidden;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm)}
.wallet-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.wallet-card::before{content:'';position:absolute;top:-40%;right:-20%;width:200px;height:200px;border-radius:50%;opacity:.12;filter:blur(20px);background:#00B4D8}
.wallet-card-head{display:flex;align-items:center;gap:14px;margin-bottom:20px;position:relative;z-index:2}
.wallet-logo{width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#fff;flex-shrink:0;background:var(--grad);letter-spacing:-1px}
.wallet-card-head .wc-name{flex:1;min-width:0}
.wallet-card-head .wc-name h4{font-size:18px;font-weight:900;margin-bottom:4px}
.wallet-card-head .wc-name p{font-size:13px;color:var(--text-2);font-weight:600}
.wallet-balance{font-size:34px;font-weight:900;letter-spacing:-1.5px;position:relative;z-index:2;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.wallet-balance small{font-size:16px;font-weight:800;color:var(--text-2)}
.wallet-balance .inline-coin{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.wallet-balance .inline-coin img{width:100%;height:100%;object-fit:contain}
.wallet-meta{font-size:13px;color:var(--text-2);margin-top:10px;font-weight:600;position:relative;z-index:2}

/* ===== SLOT GAME (BIGGER) ===== */
.slot-wrapper{background:linear-gradient(145deg,#1e0a36,#0d021a);border-radius:28px;padding:20px;box-shadow:0 16px 50px rgba(0,0,0,.4);border:3px solid var(--gold);max-width:850px;margin:0 auto}
.slot-top{display:flex;justify-content:space-between;align-items:center;background:var(--panel);border:2px solid var(--gold);border-radius:12px;padding:14px 18px;margin-bottom:14px}
.slot-credit{display:flex;align-items:center;gap:12px;color:var(--gold);font-weight:900;font-size:18px}
.slot-credit .coin-icon{width:28px;height:28px}
.slot-credit .coin-icon img{width:100%;height:100%;object-fit:contain}
.slot-credit .lbl{font-size:14px;opacity:.75;margin-right:4px}
.slot-credit .val{color:var(--cyan);font-size:24px;text-shadow:0 0 10px rgba(0,255,204,.6)}
.slot-top-right{display:flex;gap:8px}
.slot-btn-sm{background:var(--gold);color:#1a0b2e;border:none;border-radius:8px;width:42px;height:42px;cursor:pointer;font-weight:900;font-size:18px;display:flex;align-items:center;justify-content:center;transition:.15s}
.slot-btn-sm:active{transform:scale(.9)}
.slot-title{text-align:center;font-size:44px;font-weight:900;color:var(--gold);text-shadow:0 0 25px var(--gold),0 0 50px var(--pink),0 2px 4px rgba(0,0,0,.6);letter-spacing:8px;margin:10px 0 6px}
.slot-subtitle{text-align:center;font-size:14px;color:var(--cyan);letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;border:2px solid var(--cyan);border-radius:6px;padding:6px;background:rgba(0,255,204,.08);font-weight:800}
.slot-info-row{display:flex;justify-content:space-between;background:var(--header);border:2px solid var(--gold);border-radius:10px;padding:12px 18px;margin-bottom:14px}
.slot-info-item{display:flex;flex-direction:column;align-items:center;min-width:80px}
.slot-info-item .lbl{font-size:12px;color:var(--gold);font-weight:800;text-transform:uppercase;letter-spacing:1px}
.slot-info-item .val{font-size:22px;color:#fff;font-weight:900;margin-top:4px}
.slot-info-item.vip .val{color:#ffaa00;font-size:26px}
.slot-main{display:flex;gap:12px;margin-bottom:14px}
.slot-ways{display:flex;flex-direction:column;justify-content:center;align-items:center;background:#4a0000;border:2px solid var(--gold);border-radius:10px;padding:8px 6px;width:46px;flex-shrink:0}
.slot-ways span{writing-mode:vertical-rl;color:var(--gold);font-weight:900;font-size:12px;letter-spacing:2px}
.slot-reels{flex:1;background:var(--reel);border:3px solid var(--gold);border-radius:10px;padding:8px;position:relative;display:flex;flex-direction:column;min-width:0}
.reels-table{width:100%;border-collapse:separate;border-spacing:4px;table-layout:fixed}
.reels-table td{background:var(--reel);border-radius:6px;border:2px solid var(--gold);text-align:center;vertical-align:middle;width:20%;height:20%;padding:0;position:relative;overflow:hidden;aspect-ratio:1}
.sym{display:flex;justify-content:center;align-items:center;width:100%;height:100%;font-weight:bold;font-size:36px;color:var(--reel-text);transition:transform .1s}
.sym svg{width:100%;height:100%;max-width:46px;max-height:46px;display:block;margin:auto}
.sym.bomb{font-size:34px}
.reels-table.spinning .sym{animation:spinSym .1s linear infinite}
@keyframes spinSym{0%{transform:translateY(-100%)}100%{transform:translateY(100%)}}
.sym.win{background:linear-gradient(135deg,rgba(0,255,204,.9),rgba(255,204,0,.8));border-radius:6px;animation:wf .4s infinite alternate;box-shadow:0 0 15px #00ffcc,0 0 30px #ffcc00;z-index:2}
.sym.scatter{background:linear-gradient(135deg,rgba(255,0,255,.9),rgba(255,100,0,.8));border-radius:6px;animation:sf .4s infinite alternate;box-shadow:0 0 20px #ff00ff,0 0 40px #ff6600;z-index:2}
@keyframes wf{0%{transform:scale(1)}100%{transform:scale(1.08)}}
@keyframes sf{0%{transform:scale(1)}100%{transform:scale(1.12)}}
.slot-btns{display:flex;flex-direction:column;gap:10px;width:110px;flex-shrink:0}
.slot-btn{border-radius:12px;font-weight:900;cursor:pointer;text-transform:uppercase;border:3px solid rgba(255,255,255,.3);transition:.15s;font-family:inherit;padding:0;color:#1a0b2e}
.slot-btn:active{transform:scale(.95)}
.slot-spin{background:linear-gradient(180deg,#00ffcc,#00cc99);font-size:20px;padding:24px 0;box-shadow:0 0 25px var(--cyan);line-height:1.2}
.slot-spin:disabled{opacity:.5;box-shadow:none;cursor:not-allowed}
.slot-auto{background:linear-gradient(180deg,#ff00ff,#cc00cc);color:#fff;font-size:16px;padding:16px 0;line-height:1.2}
.slot-turbo{background:linear-gradient(180deg,#ffaa00,#cc8800);font-size:16px;padding:16px 0;line-height:1.2}
