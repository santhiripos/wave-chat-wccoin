/* ============================================================
   HELPERS
   ============================================================ */
const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = n => Math.floor(Number(n) || 0).toLocaleString('en-US');

const FALLBACK_COIN = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23FFD54A"/><stop offset="1" stop-color="%23FF8C00"/></linearGradient></defs><circle cx="50" cy="50" r="42" fill="url(%23g)" stroke="%238B4513" stroke-width="4"/><text x="50" y="62" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="34" font-weight="900" fill="%23FFF">W</text></svg>';

function getCoinSrc() {
  const stored = localStorage.getItem('wc_coin_icon');
  return stored || COIN_ICON_URL || FALLBACK_COIN;
}

function applyCoinIcons() {
  const src = getCoinSrc();
  document.querySelectorAll('img[class*="coin-icon"]').forEach(img => {
    img.src = src;
    img.onerror = () => { img.src = FALLBACK_COIN; };
  });
}

function toEmail(phone) {
  const digits = String(phone || '').replace(/\D/g, '');
  return digits + '@wcwallet.app';
}
function cleanPhone(p) {
  let s = String(p || '').replace(/\D/g, '');
  if (s.startsWith('0')) s = s.slice(1);
  return s;
}
function displayPhone(p) {
  const s = cleanPhone(p);
  return s ? '0' + s : '';
}

/* ============================================================
   STATE
   ============================================================ */
let currentUser = null; 
let coinBalance = 0;
let todayEarned = 0;
let totalGamesPlayed = 0;
let totalWins = 0;
let txHistory = [];
let settings = { name: 'Player', notifications: 'on' };
let userDataRef = null;
let txRef = null;
let isAdmin = false;

let selectedPkgId = null;
let allCoinPackages = {}; // Database ကနေ ဆွဲယူမည်

let slotState = {
  credit: 0, bet: 10, baseBet: 10, spinning: false, auto: false, turbo: false,
  autoCount: 0, freeSpins: 0, isFreeSpin: false, totalSpins: 0, totalWins: 0,
  checkinState: { streak:0, lastCheckin:'', claimed:[] }
};

let updateCheckInterval = null;
let _updateVersion = null;

/* ============================================================
   TOAST / NOTIFICATION
   ============================================================ */
function toast(msg, type = 'info') {
  const c = $('toastContainer');
  if (!c) return;
  const el = document.createElement('div');
  el.className = 'toast ' + (type === 'success' ? 'success' : type === 'error' ? 'error' : type === 'warn' ? 'warn' : '');
  const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warn' ? '⚠️' : 'ℹ️';
  el.innerHTML = '<span>' + icon + '</span><span>' + esc(msg) + '</span>';
  c.appendChild(el);
  setTimeout(() => { el.style.transition = 'opacity .3s'; el.style.opacity = '0'; setTimeout(() => el.remove(), 300); }, 3500);
}

function showCoinReward(amount) {
  const el = $('coinReward'), txt = $('coinRewardText'), icn = $('coinRewardIcon');
  if (!el || !txt) return;
  if (icn) icn.src = getCoinSrc();
  txt.textContent = (amount >= 0 ? '+' : '') + fmt(amount) + ' WCCoin';
  el.style.background = amount >= 0 ? 'linear-gradient(135deg,#FFB800,#FF8C00)' : 'linear-gradient(135deg,#FF4757,#FF6B7A)';
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2800);
}

async function requestNotificationPermission() {
  if (!('Notification' in window)) return false;
  if (Notification.permission === 'granted') return true;
  if (Notification.permission === 'denied') return false;
  try { const r = await Notification.requestPermission(); return r === 'granted'; }
  catch(e) { return false; }
}

function showPhoneNotification(title, body) {
  if (settings.notifications !== 'on') return;
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
  try {
    const n = new Notification(title, { body, icon: getCoinSrc(), badge: getCoinSrc(), tag: 'wccoin', renotify: true, vibrate: [200,100,200] });
    setTimeout(() => { try { n.close(); } catch(e){} }, 6000);
  } catch(e) {}
}

async function enableNotifications() {
  const ok = await requestNotificationPermission();
  closeModal('notificationPromptModal');
  if (ok) {
    toast('🔔 Notifications enabled!', 'success');
    settings.notifications = 'on';
    saveSettingsLocal();
  } else toast('⚠️ Permission denied', 'error');
}

/* ============================================================
   LOCAL SETTINGS
   ============================================================ */
function loadSettingsLocal() {
  try {
    const s = localStorage.getItem('wc_settings_v2');
    if (s) settings = Object.assign(settings, JSON.parse(s));
  } catch(e){}
}
function saveSettingsLocal() {
  try { localStorage.setItem('wc_settings_v2', JSON.stringify(settings)); } catch(e){}
}

/* ============================================================
   AUTH
   ============================================================ */
function showAuthTab(tab) {
  if (tab === 'login') {
    $('tabLogin').classList.add('active');
    $('tabSignup').classList.remove('active');
    $('loginForm').classList.remove('hidden');
    $('signupForm').classList.add('hidden');
    $('authTitle').textContent = 'Login';
    $('authSub').textContent = 'WC Wallet ထဲ ဝင်ရောက်ပါ';
  } else {
    $('tabSignup').classList.add('active');
    $('tabLogin').classList.remove('active');
    $('signupForm').classList.remove('hidden');
    $('loginForm').classList.add('hidden');
    $('authTitle').textContent = 'Sign Up';
    $('authSub').textContent = 'အကောင့်အသစ် ဖွင့်ပါ';
  }
}

async function signup(name, phone, password) {
  const email = toEmail(phone);
  const cred = await auth.createUserWithEmailAndPassword(email, password);
  const uid = cred.user.uid;
  await db.ref('users/' + uid).set({
    uid, name, phone: displayPhone(phone),
    coin_balance: 100, today_earned: 0, games_played: 0, total_wins: 0,
    createdAt: Date.now(), isAdmin: false
  });
  await db.ref('coin_transactions/' + uid).push({
    ts: Date.now(), amount: 100, reason: 'signup_bonus', type: 'signup_bonus',
    desc: '🎉 Welcome bonus'
  });
  return cred.user;
}

async function login(phone, password) {
  const email = toEmail(phone);
  return await auth.signInWithEmailAndPassword(email, password);
}

async function logout() {
  if (userDataRef) { try { userDataRef.off(); } catch(e){} userDataRef = null; }
  if (txRef) { try { txRef.off(); } catch(e){} txRef = null; }
  await auth.signOut();
  currentUser = null;
  showScreen('auth');
  toast('Logged out', 'info');
}

function showScreen(name) {
  document.querySelectorAll('#authScreen, #appShell, #adminScreen').forEach(el => { if (el) { el.classList.remove('active'); } });
  if (name === 'auth') $('authScreen').classList.add('active');
  else if (name === 'app') $('appShell').classList.add('active');
  else if (name === 'admin') $('adminScreen').classList.add('active');
}

/* ============================================================
   USER DATA
   ============================================================ */
function loadUserData() {
  if (!currentUser) return;
  if (userDataRef) { try { userDataRef.off(); } catch(e){} }
  userDataRef = db.ref('users/' + currentUser.uid);
  userDataRef.on('value', snap => {
    const data = snap.val();
    if (!data) return;
    coinBalance = data.coin_balance || 0;
    todayEarned = data.today_earned || 0;
    totalGamesPlayed = data.games_played || 0;
    totalWins = data.total_wins || 0;
    currentUser = Object.assign(currentUser, data);
    settings.name = data.name || settings.name;
    isAdmin = data.isAdmin === true || displayPhone(currentUser.phone) === ADMIN_PHONE;
    updateAllUI();
  });
}

function loadHistory() {
  if (!currentUser) return;
  if (txRef) { try { txRef.off(); } catch(e){} }
  txRef = db.ref('coin_transactions/' + currentUser.uid).limitToLast(50);
  txRef.on('value', snap => {
    const data = snap.val() || {};
    txHistory = Object.entries(data).map(([id, tx]) => Object.assign({ id }, tx)).sort((a,b) => (b.ts||0) - (a.ts||0));
    renderHistoryList();
  });
}

async function addCoins(amount, reason, meta = {}) {
  if (!currentUser || !amount) return false;
  try {
    const result = await db.ref('users/' + currentUser.uid + '/coin_balance').transaction(c => {
      const n = (c || 0) + amount;
      return n < 0 ? undefined : n;
    });
    if (!result.committed) return false;
    await db.ref('coin_transactions/' + currentUser.uid).push({
      ts: Date.now(), amount, reason, type: reason,
      desc: meta.desc || reason, ...meta
    });
    if (amount > 0) {
      await db.ref('users/' + currentUser.uid + '/today_earned').transaction(c => (c || 0) + amount).catch(()=>{});
    }
    return true;
  } catch(e) { return false; }
}

