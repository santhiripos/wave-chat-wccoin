function slotSpin() {
  if (slotState.spinning) return;
  if (!currentUser) return toast('Login လုပ်ပါ', 'warn');
  if (!slotState.isFreeSpin && slotState.bet > slotState.credit) {
    toast('⚠️ WCCoin မလုံလောက်ပါ', 'warn');
    slotStopAuto();
    return;
  }
  if (!slotState.isFreeSpin) {
    slotState.credit -= slotState.bet;
    if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit);
    addCoins(-slotState.bet, 'bet', { desc: '🎰 Slot Bet', game: 'Slot' });
  }
  if($('slotWinDisplay')) $('slotWinDisplay').textContent = '0';
  slotState.spinning = true;
  if($('slotSpinBtn')) $('slotSpinBtn').disabled = true;
  if($('slotAutoBtn')) $('slotAutoBtn').disabled = true;
  if($('slotMessage')) $('slotMessage').textContent = slotState.isFreeSpin ? `🎁 Free Spin! (${slotState.freeSpins})` : '🎰 လှည့်နေသည်...';
  slotState.totalSpins++;
  totalGamesPlayed++;
  db.ref('users/' + currentUser.uid + '/games_played').set(totalGamesPlayed).catch(()=>{});
  if($('slotEffect')) $('slotEffect').classList.remove('show');
  if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show');
  document.querySelectorAll('.sym').forEach(el => el.classList.remove('win', 'scatter'));
  
  const cols = [];
  for (let c = 0; c < 5; c++) {
    const col = [];
    for (let r = 0; r < 5; r++) {
      const td = document.querySelectorAll('#reelsBody tr')[r].querySelectorAll('td')[c];
      td.classList.add('spinning');
      col.push(td);
    }
    cols.push(col);
  }
  
  const results = [];
  let bombCount = 0;
  const winChance = Math.random() * 100 < SLOT_WIN_RATE;
  
  for (let i = 0; i < 5; i++) {
    const colRes = [];
    for (let j = 0; j < 5; j++) {
      const rand = Math.random();
      let sym;
      if (rand < 0.03 && bombCount < 2) { sym = SCATTER_SYMBOL; bombCount++; }
      else {
        const wr = Math.random();
        if (wr < 0.6) sym = SYMBOLS[Math.floor(Math.random() * 5)];
        else if (wr < 0.9) sym = SYMBOLS[Math.floor(Math.random() * 10)];
        else sym = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
      }
      colRes.push(sym);
    }
    results.push(colRes);
  }
  
  if (winChance && !slotState.isFreeSpin) {
    const low = ['cherry','lemon','orange','plum','watermelon'];
    const rs = low[Math.floor(Math.random() * low.length)];
    const row = Math.floor(Math.random() * 5);
    results[0][row] = rs; results[1][row] = rs; results[2][row] = rs;
  }
  
  const spinDur = slotState.turbo ? 400 : 1200;
  const stopDelay = slotState.turbo ? 80 : 200;
  
  for (let c = 0; c < 5; c++) {
    setTimeout(() => {
      for (let r = 0; r < 5; r++) {
        const td = cols[c][r];
        td.classList.remove('spinning');
        const s = td.querySelector('.sym');
        const key = results[c][r];
        if (key === SCATTER_SYMBOL) { s.innerHTML = SVG_ICONS['bomb']; s.classList.add('bomb'); }
        else { s.innerHTML = SVG_ICONS[key] || SVG_ICONS['cherry']; s.classList.remove('bomb'); }
      }
      if (c === 4) {
        setTimeout(() => {
          slotCheckWin(results);
          slotState.spinning = false;
          if($('slotSpinBtn')) $('slotSpinBtn').disabled = false;
          if($('slotAutoBtn')) $('slotAutoBtn').disabled = false;
          if (slotState.isFreeSpin) {
            slotState.freeSpins--;
            if (slotState.freeSpins > 0) setTimeout(() => slotSpin(), slotState.turbo ? 400 : 1200);
            else { slotState.isFreeSpin = false; if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show'); }
          }
          if (slotState.auto && slotState.autoCount > 0) {
            slotState.autoCount--;
            if($('slotAutoBtn')) $('slotAutoBtn').innerHTML = `🔄<br>(${slotState.autoCount})`;
            if (slotState.autoCount > 0) setTimeout(() => slotSpin(), slotState.turbo ? 400 : 1000);
            else slotStopAuto();
          }
        }, 100);
      }
    }, spinDur + (c * stopDelay));
  }
}

function slotStopAuto() {
  slotState.auto = false;
  slotState.autoCount = 0;
  if($('slotAutoBtn')) { $('slotAutoBtn').innerHTML = '🔄<br>AUTO'; $('slotAutoBtn').style.background = 'linear-gradient(180deg,#ff00ff,#cc00cc)'; }
}

