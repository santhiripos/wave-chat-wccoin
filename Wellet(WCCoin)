<div class="toast" id="toast"></div>

<script>
(function(){
  'use strict';

  /* ============================================================
     STATE
     ============================================================ */
  var state = {
    wallets: {
      wave: { key:'wave', name:'WaveMoney', sym:'Ks', balance:620000, color:'var(--wave)', account:'09 7xx xxx 890' },
      kpay: { key:'kpay', name:'KBZPay', sym:'Ks', balance:575000, color:'var(--kpay)', account:'09 9xx xxx 123' },
      wc:   { key:'wc', name:'WCCoin Pay', sym:'WC', balance:1420, color:'var(--wc)', account:'0xWC...8f2a' }
    },
    transactions: [
      { wallet:'wave', dir:'in',  amount:50000,  label:'WaveMoney မှ လက်ခံ',   time:'ယနေ့ · 09:24 AM' },
      { wallet:'kpay', dir:'out', amount:25000,  label:'KBZPay သို့ လွှဲ',     time:'မနေ့ · 06:12 PM' },
      { wallet:'wc',   dir:'in',  amount:12,     label:'WCCoin မှ လက်ခံ',    time:'မနေ့ · 02:30 PM' },
      { wallet:'wave', dir:'out', amount:12000,  label:'WaveMoney သို့ လွှဲ',  time:'မနေ့ · 01:40 PM' },
      { wallet:'wc',   dir:'out', amount:5,      label:'WCCoin သို့ လွှဲ',     time:'2 ရက် · 11:15 AM' }
    ],
    version: '1.0.0'
  };

  /* ============================================================
     DOM HELPERS
     ============================================================ */
  function $(id){ return document.getElementById(id); }

  function el(tag, cls, txt){
    var e = document.createElement(tag);
    if(cls) e.className = cls;
    if(txt !== undefined && txt !== null) e.textContent = txt;
    return e;
  }

  function fmtNum(n){
    return Number(n).toLocaleString('en-US');
  }

  /* ============================================================
     TOAST (safe, single instance)
     ============================================================ */
  var toastTimer = null;
  function toast(msg){
    var t = $('toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    if(toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 2200);
  }

  /* ============================================================
     MODALS
     ============================================================ */
  function openModal(id){
    var m = $(id);
    if(m) m.classList.add('show');
  }
  function closeModal(id){
    var m = $(id);
    if(m) m.classList.remove('show');
  }
  function closeAllModals(){
    document.querySelectorAll('.modal-overlay.show').forEach(function(m){ m.classList.remove('show'); });
  }

  /* ============================================================
     RENDER: Stats
     ============================================================ */
  function renderStats(){
    var grid = $('statsGrid');
    if(!grid) return;
    grid.innerHTML = '';

    var w = state.wallets;
    var totalKs = w.wave.balance + w.kpay.balance;
    var totalWc = w.wc.balance;

    // Total
    var c1 = el('div','stat-card sc-total');
    c1.innerHTML =
      '<div class="sc-head"><div class="sc-icon">Σ</div><div class="sc-trend trend-up">↑ 12.4%</div></div>' +
      '<div class="sc-label">Total Balance</div>' +
      '<div class="sc-value">' + fmtNum(totalKs) + ' <small>Ks</small></div>' +
      '<div class="sc-foot">3 wallets synced</div>';

    // Wave
    var c2 = el('div','stat-card sc-wave');
    c2.innerHTML =
      '<div class="sc-head"><div class="sc-icon">💛</div><div class="sc-trend trend-up">↑ 5.2%</div></div>' +
      '<div class="sc-label">WaveMoney</div>' +
      '<div class="sc-value">' + fmtNum(w.wave.balance) + ' <small>Ks</small></div>' +
      '<div class="sc-foot">' + w.wave.account + '</div>';

    // KBZ
    var c3 = el('div','stat-card sc-kpay');
    c3.innerHTML =
      '<div class="sc-head"><div class="sc-icon">💙</div><div class="sc-trend trend-up">↑ 8.1%</div></div>' +
      '<div class="sc-label">KBZPay</div>' +
      '<div class="sc-value">' + fmtNum(w.kpay.balance) + ' <small>Ks</small></div>' +
      '<div class="sc-foot">' + w.kpay.account + '</div>';

    // WC
    var c4 = el('div','stat-card sc-wc');
    c4.innerHTML =
      '<div class="sc-head"><div class="sc-icon">💚</div><div class="sc-trend trend-down">↓ 2.3%</div></div>' +
      '<div class="sc-label">WCCoin Pay</div>' +
      '<div class="sc-value">' + fmtNum(w.wc.balance) + ' <small>WC</small></div>' +
      '<div class="sc-foot">' + w.wc.account + '</div>';

    grid.appendChild(c1);
    grid.appendChild(c2);
    grid.appendChild(c3);
    grid.appendChild(c4);
  }

  /* ============================================================
     RENDER: Sidebar wallets
     ============================================================ */
  function renderSidebarWallets(){
    var wrap = $('sidebarWallets');
    if(!wrap) return;
    wrap.innerHTML = '';
    Object.keys(state.wallets).forEach(function(k){
      var w = state.wallets[k];
      var row = el('div','sb-wallet');
      row.setAttribute('data-wallet', k);
      row.innerHTML =
        '<div class="sw-dot" style="background:' + w.color + ';"></div>' +
        '<div class="sw-meta"><h5>' + w.name + '</h5><p>' + fmtNum(w.balance) + ' ' + w.sym + '</p></div>';
      wrap.appendChild(row);
    });
  }

  /* ============================================================
     RENDER: Wallet quick list
     ============================================================ */
  function renderWalletList(){
    var wrap = $('walletList');
    if(!wrap) return;
    wrap.innerHTML = '';
    Object.keys(state.wallets).forEach(function(k){
      var w = state.wallets[k];
      var row = el('div','wallet-row');
      row.setAttribute('data-wallet', k);
      var badgeCls = k === 'wave' ? 'w-wave' : (k === 'kpay' ? 'w-kpay' : 'w-wc');
      var letter = k === 'wave' ? 'W' : (k === 'kpay' ? 'K' : '₩');
      row.innerHTML =
        '<div class="wr-badge ' + badgeCls + '">' + letter + '</div>' +
        '<div class="wr-meta"><h5>' + w.name + '</h5><p>' + w.account + '</p></div>' +
        '<div class="wr-amt" style="color:' + w.color + ';">' + fmtNum(w.balance) + '<small>' + w.sym + '</small></div>';
      wrap.appendChild(row);
    });
  }

  /* ============================================================
     RENDER: Transactions
     ============================================================ */
  function renderTransactions(filter){
    var wrap = $('txList');
    if(!wrap) return;
    wrap.innerHTML = '';

    var list = state.transactions.slice();
    if(filter && filter.trim()){
      var q = filter.toLowerCase();
      list = list.filter(function(tx){ return tx.label.toLowerCase().indexOf(q) !== -1; });
    }

    if(list.length === 0){
      wrap.appendChild(el('p','', 'ရှာဖွေမှု မတွေ့ပါ'));
      return;
    }

    list.forEach(function(tx){
      var w = state.wallets[tx.wallet];
      if(!w) return;
      var icoCls = 'tx-' + tx.wallet;
      var amtCls = tx.dir === 'in' ? 'amt-in' : 'amt-out';
      var sign = tx.dir === 'in' ? '+' : '-';
      var row = el('div','tx');
      row.innerHTML =
        '<div class="tx-ico ' + icoCls + '">' + (tx.wallet === 'wave' ? '💛' : (tx.wallet === 'kpay' ? '💙' : '💚')) + '</div>' +
        '<div class="tx-info"><h4>' + tx.label + '</h4><p>' + tx.time + '</p></div>' +
        '<div class="tx-amt ' + amtCls + '">' + sign + fmtNum(tx.amount) + ' ' + w.sym + '</div>';
      wrap.appendChild(row);
    });
  }

  /* ============================================================
     RENDER: History badge
     ============================================================ */
  function renderHistoryBadge(){
    var b = $('historyBadge');
    if(b) b.textContent = state.transactions.length;
  }

  /* ============================================================
     SELECT WALLET
     ============================================================ */
  function selectWallet(key){
    var w = state.wallets[key];
    if(!w) return;

    $('welcomeTitle').textContent = w.name + ' ကို ရွေးထားသည် ✅';
    $('welcomeSub').textContent = 'ငွေလွှဲ / လက်ခံ လုပ်ဆောင်နိုင်ပါပြီ';

    var fromSel = $('fromWallet');
    if(fromSel) fromSel.value = key;

    var recvSel = $('recvWallet');
    if(recvSel) recvSel.value = key;

    var myAcc = $('myAccount');
    if(myAcc) myAcc.value = w.account;

    var topupSel = $('topupWallet');
    if(topupSel) topupSel.value = key;

    toast('💼 ' + w.name + ' ရွေးချယ်ပြီး');
  }

  /* ============================================================
     TRANSFER
     ============================================================ */
  function doTransfer(){
    var fromKey = $('fromWallet').value;
    var to = $('toAccount').value.trim();
    var amtRaw = $('amount').value;
    var note = $('note').value.trim();

    if(!to){ toast('⚠️ လက်ခံမည့်သူ ထည့်ပါ'); return; }
    if(!amtRaw || Number(amtRaw) <= 0){ toast('⚠️ ပမာဏ ထည့်ပါ'); return; }

    var amt = Number(amtRaw);
    var w = state.wallets[fromKey];
    if(!w){ toast('⚠️ Wallet မမှန်ပါ'); return; }
    if(amt > w.balance){ toast('⚠️ လက်ကျန်ငွေ မလုံလောက်ပါ'); return; }

    // Deduct
    w.balance -= amt;

    // Add transaction
    state.transactions.unshift({
      wallet: fromKey,
      dir: 'out',
      amount: amt,
      label: w.name + ' မှ လွှဲပြီး' + (note ? ' (' + note + ')' : ''),
      time: 'ယခု'
    });

    // Refresh UI
    renderStats();
    renderSidebarWallets();
    renderWalletList();
    renderTransactions($('searchInput') ? $('searchInput').value : '');
    renderHistoryBadge();

    closeModal('transferModal');
    toast('📤 ' + w.name + ' မှ ' + fmtNum(amt) + ' ' + w.sym + ' လွှဲပြီး ✅');

    // Clear form
    $('toAccount').value = '';
    $('amount').value = '';
    $('note').value = '';
  }

  /* ============================================================
     RECEIVE
     ============================================================ */
  function doReceive(){
    var wKey = $('recvWallet').value;
    var amtRaw = $('recvAmount').value;
    var w = state.wallets[wKey];
    if(!w){ toast('⚠️ Wallet မမှန်ပါ'); return; }

    if(amtRaw && Number(amtRaw) > 0){
      toast('📥 ' + w.name + ' — ' + fmtNum(Number(amtRaw)) + ' ' + w.sym + ' တောင်းခံပြီး ✅');
    } else {
      toast('📥 ' + w.name + ' လက်ခံရန် အသင့် ✅');
    }

    closeModal('receiveModal');
    $('recvAmount').value = '';
  }

  /* ============================================================
     TOPUP
     ============================================================ */
  function doTopup(){
    var phone = $('topupPhone').value.trim();
    var amtRaw = $('topupAmount').value;
    var wKey = $('topupWallet').value;
    var w = state.wallets[wKey];

    if(!phone){ toast('⚠️ ဖုန်းနံပါတ် ထည့်ပါ'); return; }
    if(!amtRaw || Number(amtRaw) <= 0){ toast('⚠️ ပမာဏ ထည့်ပါ'); return; }
    if(!w){ toast('⚠️ Wallet မမှန်ပါ'); return; }

    var amt = Number(amtRaw);
    if(amt > w.balance){ toast('⚠️ လက်ကျန်ငွေ မလုံလောက်ပါ'); return; }

    w.balance -= amt;

    state.transactions.unshift({
      wallet: wKey,
      dir: 'out',
      amount: amt,
      label: phone + ' ဖုန်းဖြည့်',
      time: 'ယခု'
    });

    renderStats();
    renderSidebarWallets();
    renderWalletList();
    renderTransactions($('searchInput') ? $('searchInput').value : '');
    renderHistoryBadge();

    closeModal('topupModal');
    toast('⚡ ' + fmtNum(amt) + ' ' + w.sym + ' ဖုန်းဖြည့်ပြီး ✅');

    $('topupPhone').value = '';
    $('topupAmount').value = '';
  }

  /* ============================================================
     QR
     ============================================================ */
  function doQr(){
    var amtRaw = $('qrAmount').value;
    if(!amtRaw || Number(amtRaw) <= 0){ toast('⚠️ ပမာဏ ထည့်ပါ'); return; }

    closeModal('qrModal');
    toast('📷 QR Scan & Pay — ' + fmtNum(Number(amtRaw)) + ' Ks ✅');
    $('qrAmount').value = '';
  }

  /* ============================================================
     SETTINGS
     ============================================================ */
  function doSaveSettings(){
    var name = $('setName').value.trim() || 'Ko Aung';
    var phone = $('setPhone').value.trim();
    var lang = $('setLang').value;

    $('userProfile').querySelector('h5').textContent = name;
    $('welcomeTitle').textContent = (lang === 'en' ? 'Hello, ' : 'မင်္ဂလာပါ, ') + name + ' 👋';
    $('welcomeSub').textContent = (lang === 'en' ? 'All wallets are synced' : 'သင့်ရဲ့ wallets အားလုံး ဒီနေ့ အဆင်ပြေပါစေ');

    if(phone){
      state.wallets.wave.account = phone;
      renderSidebarWallets();
      renderWalletList();
    }

    closeModal('settingsModal');
    toast('⚙️ Settings သိမ်းပြီး ✅');
  }

  /* ============================================================
     AUTO UPDATE
     ============================================================ */
  var updateCheckTimer = null;
  var currentVersion = state.version;

  function checkForUpdate(){
    // Simulate version check — in production, fetch from server
    // For demo: auto-update every 60s (just a version bump notification)
    var dot = $('updateDot');
    if(dot) dot.style.display = 'block';

    setTimeout(function(){
      if(dot) dot.style.display = 'none';
    }, 4000);
  }

  function startAutoUpdate(){
    // Initial check after 10s
    setTimeout(checkForUpdate, 10000);
    // Then every 120s
    updateCheckTimer = setInterval(checkForUpdate, 120000);
  }

  /* ============================================================
     EVENT DELEGATION — all clicks
     ============================================================ */
  function bindEvents(){

    // Sidebar navigation
    document.querySelectorAll('.sb-item[data-nav]').forEach(function(item){
      item.addEventListener('click', function(){
        var nav = this.getAttribute('data-nav');
        // Active state
        document.querySelectorAll('.sb-item[data-nav]').forEach(function(i){ i.classList.remove('active'); });
        this.classList.add('active');

        if(nav === 'dashboard'){
          $('welcomeTitle').textContent = 'မင်္ဂလာပါ, Ko Aung 👋';
          $('welcomeSub').textContent = 'သင့်ရဲ့ wallets အားလုံး ဒီနေ့ အဆင်ပြေပါစေ';
          toast('🏠 Dashboard');
        } else if(nav === 'transfer'){
          openModal('transferModal');
        } else if(nav === 'receive'){
          openModal('receiveModal');
        } else if(nav === 'history'){
          toast('📊 History — ' + state.transactions.length + ' ခု');
        } else if(nav === 'settings'){
          openModal('settingsModal');
        }
      });
    });

    // Sidebar wallet clicks
    $('sidebarWallets').addEventListener('click', function(e){
      var row = e.target.closest('.sb-wallet');
      if(row) selectWallet(row.getAttribute('data-wallet'));
    });

    // Wallet quick list clicks
    $('walletList').addEventListener('click', function(e){
      var row = e.target.closest('.wallet-row');
      if(row) selectWallet(row.getAttribute('data-wallet'));
    });

    // Action buttons
    $('actionRow').addEventListener('click', function(e){
      var btn = e.target.closest('.act-btn');
      if(!btn) return;
      var action = btn.getAttribute('data-action');
      if(action === 'transfer') openModal('transferModal');
      else if(action === 'receive') openModal('receiveModal');
      else if(action === 'topup') openModal('topupModal');
      else if(action === 'qr') openModal('qrModal');
    });

    // Panel links
    document.querySelectorAll('[data-action="viewAllTx"]').forEach(function(a){
      a.addEventListener('click', function(){
        toast('📊 ငွေလွှဲမှု အားလုံး — ' + state.transactions.length + ' ခု');
      });
    });
    document.querySelectorAll('[data-action="viewAllWallets"]').forEach(function(a){
      a.addEventListener('click', function(){
        toast('💼 Wallets 3 ခု');
      });
    });

    // Topbar
    $('notifBtn').addEventListener('click', function(){ toast('🔔 Notifications'); });
    $('profileBtn').addEventListener('click', function(){ openModal('settingsModal'); });
    $('userProfile').addEventListener('click', function(){ openModal('settingsModal'); });

    // Search
    $('searchInput').addEventListener('input', function(){
      renderTransactions(this.value);
    });

    // Modal close buttons
    document.querySelectorAll('[data-close]').forEach(function(btn){
      btn.addEventListener('click', function(){
        closeModal(this.getAttribute('data-close'));
      });
    });

    // Overlay click to close
    document.querySelectorAll('.modal-overlay').forEach(function(ov){
      ov.addEventListener('click', function(e){
        if(e.target === ov) ov.classList.remove('show');
      });
    });

    // Form submit buttons
    $('doTransferBtn').addEventListener('click', doTransfer);
    $('doReceiveBtn').addEventListener('click', doReceive);
    $('doTopupBtn').addEventListener('click', doTopup);
    $('doQrBtn').addEventListener('click', doQr);
    $('doSaveSettingsBtn').addEventListener('click', doSaveSettings);

    // Keyboard: Escape closes modals
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape') closeAllModals();
    });
  }

  /* ============================================================
     INIT
     ============================================================ */
  function init(){
    // Initial render
    renderStats();
    renderSidebarWallets();
    renderWalletList();
    renderTransactions('');
    renderHistoryBadge();

    // Set default accounts
    $('myAccount').value = state.wallets.wave.account;
    $('setName').value = 'Ko Aung';

    // Bind all events
    bindEvents();

    // Start auto-update checker
    startAutoUpdate();

    // Welcome
    console.log('[TriPay] v' + state.version + ' initialized — all systems functional');
  }

  // Run when DOM ready
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

</body>
</html>
