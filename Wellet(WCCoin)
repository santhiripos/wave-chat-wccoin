function init() {
  loadSettingsLocal();
  applyCoinIcons();
  generateReels();
  
  // Real-time Coin Packages
  db.ref('app_config/coin_packages').on('value', snap => {
    allCoinPackages = snap.val() || {};
    renderPkgGrid();
  });

  $('tabLogin') && ($('tabLogin').onclick = () => showAuthTab('login'));
  $('tabSignup') && ($('tabSignup').onclick = () => showAuthTab('signup'));

  $('loginForm') && ($('loginForm').onsubmit = async e => {
    e.preventDefault();
    const phone = $('loginPhone').value.trim();
    const pass = $('loginPass').value;
    const errEl = $('loginErr');
    const btn = $('loginBtn');
    errEl.textContent = '';
    if (!phone) { errEl.textContent = '⚠️ ဖုန်းနံပါတ် ထည့်ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = '⚠️ Password ၆ လုံး'; return; }
    btn.disabled = true; btn.textContent = 'Logging in...';
    try {
      await login(phone, pass);
      toast('✅ Welcome back!', 'success');
    } catch(err) {
      errEl.textContent = '⚠️ ' + (err.message || 'Login failed');
    } finally { btn.disabled = false; btn.textContent = 'Login'; }
  });

  $('signupForm') && ($('signupForm').onsubmit = async e => {
    e.preventDefault();
    const name = $('suName').value.trim();
    const phone = $('suPhone').value.trim();
    const pass = $('suPass').value;
    const errEl = $('signupErr');
    const btn = $('signupBtn');
    errEl.textContent = '';
    if (!name || name.length < 2) { errEl.textContent = '⚠️ Name ၂ လုံး'; return; }
    if (!phone || phone.replace(/\D/g,'').length < 7) { errEl.textContent = '⚠️ ဖုန်းနံပါတ် မှန်ကန်စွာ ထည့်ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = '⚠️ Password ၆ လုံး'; return; }
    btn.disabled = true; btn.textContent = 'Creating...';
    try {
      await signup(name, phone, pass);
      toast('🎉 Account created! +100 WCCoin bonus', 'success');
    } catch(err) {
      errEl.textContent = '⚠️ ' + (err.message || 'Signup failed');
    } finally { btn.disabled = false; btn.textContent = 'Sign Up'; }
  });

  document.querySelectorAll('.nav-item[data-page]').forEach(btn => {
    btn.onclick = () => gotoPage(btn.dataset.page);
  });

  document.querySelectorAll('.admin-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const panel = $('admPanel-' + btn.dataset.tab);
      if (panel) panel.classList.add('active');
      if (btn.dataset.tab === 'buyreq') loadAdminBuyRequests();
      if (btn.dataset.tab === 'packages') renderAdminPackages();
      if (btn.dataset.tab === 'version') loadAdminVersion();
    };
  });

  document.querySelectorAll('.modal-overlay').forEach(ov => {
    ov.addEventListener('click', e => { if (e.target === ov) ov.classList.remove('show'); });
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllModals(); });

  auth.onAuthStateChanged(async user => {
    if (user) {
      const snap = await db.ref('users/' + user.uid).once('value');
      const data = snap.val();
      if (!data) { await auth.signOut(); showScreen('auth'); return; }
      currentUser = { uid: user.uid, ...data };
      settings.name = data.name || settings.name;
      isAdmin = data.isAdmin === true || displayPhone(data.phone) === ADMIN_PHONE;
      showScreen('app');
      loadUserData();
      loadHistory();
      updateAllUI();
      
      // Coin Packages Listener
      db.ref('app_config/coin_packages').on('value', snap => { allCoinPackages = snap.val() || {}; });

      if (!localStorage.getItem('wc_notif_prompted_v2') && Notification.permission !== 'granted') {
        setTimeout(() => { $('notificationPromptModal').classList.add('show'); localStorage.setItem('wc_notif_prompted_v2', '1'); }, 3000);
      }
    } else {
      showScreen('auth');
    }
  });

  setTimeout(checkUpdate, 2000);
  if (updateCheckInterval) clearInterval(updateCheckInterval);
  updateCheckInterval = setInterval(checkUpdate, 10 * 60 * 1000);

  console.log('✅ WC Wallet + Slot v' + APP_VERSION + ' initialized');
}

