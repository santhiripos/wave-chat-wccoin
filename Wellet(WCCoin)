  wrap.querySelectorAll('.pkg-card').forEach(card => { card.onclick = () => { selectedPkgId = card.dataset.pkg; renderPkgGrid(); }; });
}

function renderGiftGrid() {
  const wrap = $('giftGrid'); if (!wrap) return;
  const items = Object.entries(allGifts).sort((a,b) => (a[1].order||0) - (b[1].order||0));
  if (items.length === 0) { wrap.innerHTML = '<div class="empty-state" style="grid-column:1/-1"><span class="em"></span><h3>လက္ေဆာင္ မရွိေသးပါ</h3><p>Admin မွ လက္ေဆာင္ ထည့္သြင္းပါမည္</p></div>'; return; }
