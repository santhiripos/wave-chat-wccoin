function renderAdminUsers(filter) {
  const list = $('admUserList');
  const data = window._adminUsers || {}; if (!list) return;
  const f = (filter || '').toLowerCase().trim();
  const entries = Object.entries(data).filter(([,u]) => !f || (u.name || '').toLowerCase().includes(f) || (u.phone || '').includes(f));
  if (entries.length === 0) { list.innerHTML = '<div class="empty-state"><span class="em"></span><h3>No users</h3></div>'; return; }
  const genderIcon = g => g === 'male' ? '' : g === 'female' ? '' : '';
  list.innerHTML = entries.map(([uid, u]) => `
