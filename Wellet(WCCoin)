async function addCoins(amount, reason, meta = {}) {
  if (!currentUser || !amount) return false;
  try {
    const result = await db.ref('users/' + currentUser.uid + '/coin_balance').transaction(c => { const n = (c || 0) + amount; return n < 0 ? undefined : n; });
    if (!result.committed) return false;
    await db.ref('coin_transactions/' + currentUser.uid).push({ ts: Date.now(), amount, reason, type: reason, desc: meta.desc || reason, ...meta });
    if (amount > 0) await db.ref('users/' + currentUser.uid + '/today_earned').transaction(c => (c || 0) + amount).catch(()=>{});
    return true;
  } catch(e) { return false; }
}

async function addCoinsToUser(uid, amount, reason, meta = {}) {
  try {
    const result = await db.ref('users/' + uid + '/coin_balance').transaction(c => { const n = (c || 0) + amount; return n < 0 ? undefined : n; });
    if (!result.committed) return false;
    await db.ref('coin_transactions/' + uid).push({ ts: Date.now(), amount, reason, type: reason, desc: meta.desc || reason, ...meta });
    return true;
  } catch(e) { return false; }
}

