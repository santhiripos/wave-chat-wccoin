.admin-card{background:#FFF;border:1px solid var(--border);border-radius:20px;padding:24px;margin-bottom:18px;box-shadow:var(--sh-sm)}
.user-row{display:flex;align-items:center;gap:16px;padding:16px;background:var(--surface-2);border-radius:16px;margin-bottom:10px}
.user-row .ur-av{width:52px;height:52px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;flex-shrink:0}
.user-row .ur-body{flex:1;min-width:0}
.user-row .ur-name{font-size:16px;font-weight:800;margin-bottom:4px}
.user-row .ur-sub{font-size:13px;color:var(--text-2);font-weight:600}

