      <div class="gift-grid" id="giftGrid"></div>
      <div class="section-header" style="margin-top:20px"><h3> ကျွန်ုပ်၏ Orders</h3></div>
      <div id="myGiftOrders"></div>
    </div>

    <div class="page-view" id="page-transfer">
      <div class="section-header"><h3> WCCoin Transfer</h3></div>
