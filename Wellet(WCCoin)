/* ============================================================
   AUTO UPDATE
   ============================================================ */
let _updateVersion = null;
let updateCheckInterval = null;
function checkUpdate() {
  if (!db) return;
  db.ref('app_config/version').once('value').then(snap => {
    const v = snap.val(); if (!v || !v.latest) return;
    const cmp = compareVersion(APP_VERSION, v.latest); if (cmp >= 0) return;
    const dismissed = localStorage.getItem('wc_version_dismissed'); if (dismissed === v.latest) return;
    if (_updateVersion && _updateVersion.latest === v.latest) return;
    showUpdateModal(v);
  }).catch(err => console.warn('[Update]', err.message));
}
function compareVersion(a, b) { const pa = String(a || '0').split('.').map(n => parseInt(n, 10) || 0); const pb = String(b || '0').split('.').map(n => parseInt(n, 10) || 0); const len = Math.max(pa.length, pb.length); for (let i = 0; i < len; i++) { const x = pa[i] || 0, y = pb[i] || 0; if (x > y) return 1; if (x < y) return -1; } return 0; }
function showUpdateModal(v) { _updateVersion = v; if($('newVerLabel')) $('newVerLabel').textContent = v.latest; if($('releaseNotes')) $('releaseNotes').textContent = v.releaseNotes || 'Bug fixes and improvements'; $('updateModal').classList.add('show'); }
function applyUpdate() { if (!_updateVersion) { closeModal('updateModal'); return; } localStorage.setItem('wc_version_dismissed', _updateVersion.latest); _updateVersion = null; closeModal('updateModal'); if ('caches' in window) { caches.keys().then(names => { for (let name of names) caches.delete(name); }).catch(()=>{}); } toast('🔄 Updating App...', 'info'); setTimeout(() => { window.location.href = window.location.href.split('?')[0] + '?t=' + Date.now(); }, 600); }
function checkUpdateManually() { toast('🔄 Checking...', 'info'); db.ref('app_config/version').once('value').then(snap => { const v = snap.val(); if (!v || !v.latest) return toast('Version info မရှိပါ', 'warn'); const cmp = compareVersion(APP_VERSION, v.latest); if (cmp >= 0) return toast('✅ Latest Version ဖြစ်ပါတယ်', 'success'); showUpdateModal(v); }).catch(err => toast('Failed: ' + err.message, 'error')); }

