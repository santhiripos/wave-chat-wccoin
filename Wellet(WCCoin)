function slotChangeBet(delta) {
  if (slotState.spinning) return;
  let nb = slotState.bet + delta;
  if (nb < SLOT_MIN_BET) nb = SLOT_MIN_BET;
  if (nb > SLOT_MAX_BET) nb = SLOT_MAX_BET;
  if (nb > coinBalance) { if($('slotMessage')) $('slotMessage').textContent = '⚠️ WCCoin မလုံလောက်'; return; }
  slotState.bet = nb;
  slotState.baseBet = nb;
  syncSlotCredit();
}

function slotQuickBet(mult) {
  if (slotState.spinning) return;
  const nb = slotState.baseBet * mult;
  if (nb > SLOT_MAX_BET) return;
  if (nb > coinBalance) { if($('slotMessage')) $('slotMessage').textContent = '⚠️ WCCoin မလုံလောက်'; return; }
  slotState.bet = nb;
  syncSlotCredit();
  if($('slotMessage')) $('slotMessage').textContent = `💰 ${fmt(nb)} WCCoin (${mult}×)`;
}

function slotCheckWin(results) {
  let totalWin = 0;
  const winPositions = [];
  const winLines = [];
  let hasJackpot = false;
  const scatterPos = [];
  for (let c = 0; c < 5; c++) for (let r = 0; r < 5; r++) {
    if (results[c][r] === SCATTER_SYMBOL) scatterPos.push({ col: c, row: r });
  }
  let bombFreeSpins = 0;
  if (scatterPos.length >= 3) {
    if (scatterPos.length === 3) bombFreeSpins = 5;
    else if (scatterPos.length === 4) bombFreeSpins = 7;
    else bombFreeSpins = 10;
    slotState.freeSpins += bombFreeSpins;
    slotState.isFreeSpin = true;
    if($('slotFreeSpin')) $('slotFreeSpin').classList.add('show');
    scatterPos.forEach(p => {
      winPositions.push(p);
      const td = document.querySelectorAll('#reelsBody tr')[p.row].querySelectorAll('td')[p.col];
      if (td) { const s = td.querySelector('.sym'); if (s) s.classList.add('scatter'); }
    });
  }
  const allLines = [];
  for (let row = 0; row < 5; row++) allLines.push({ positions: Array.from({length:5},(_,c)=>({col:c,row})), dir:'➡️' });
  for (let col = 0; col < 5; col++) allLines.push({ positions: Array.from({length:5},(_,r)=>({col,row:r})), dir:'⬇️' });
  allLines.push({ positions: [{col:0,row:0},{col:1,row:1},{col:2,row:2},{col:3,row:3},{col:4,row:4}], dir:'↘️' });
  allLines.push({ positions: [{col:0,row:4},{col:1,row:3},{col:2,row:2},{col:3,row:1},{col:4,row:0}], dir:'↗️' });
  
  allLines.forEach(line => {
    const syms = line.positions.map(p => results[p.col][p.row]);
    const firstSym = syms[0];
    if (!firstSym || firstSym === SCATTER_SYMBOL) return;
    let count = 1;
    const positions = [0];
    for (let i = 1; i < syms.length; i++) {
      if (syms[i] === firstSym) { count++; positions.push(i); } else break;
    }
    if (PAYOUTS[firstSym] && count >= 3) {
      const mult = PAYOUTS[firstSym][count];
      if (mult) {
        const amount = slotState.bet * mult;
        totalWin += amount;
        if (count >= 5) hasJackpot = true;
        const mp = positions.map(p => line.positions[p]);
        winLines.push({ positions: mp, symbol: firstSym, matchCount: count, winAmount: amount, dir: line.dir });
        mp.forEach(p => winPositions.push(p));
      }
    }
  });
  
  if (totalWin > 0) {
    slotState.credit += totalWin;
    slotState.totalWins += totalWin;
    totalWins += totalWin;
    if($('slotWinDisplay')) $('slotWinDisplay').textContent = fmt(totalWin);
    if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit);
    addCoins(totalWin, 'game_reward', { desc: '🎰 Slot Win', game: 'Slot' }).then(ok => {
      if (ok) {
        showCoinReward(totalWin);
        showPhoneNotification('🎉 WCCoin ရရှိပါပြီ!', '+' + fmt(totalWin) + ' WCCoin Slot ကနေ');
      }
    });
    db.ref('users/' + currentUser.uid + '/total_wins').set(totalWins).catch(()=>{});
    let winText = '🎉 WIN!', color = '#00ffcc';
    if (hasJackpot) { winText = '🎰 JACKPOT!'; color = '#ff00ff'; }
    else if (totalWin >= slotState.bet * 100) { winText = '💎 SUPER!'; color = '#ffcc00'; }
    else if (totalWin >= slotState.bet * 30) { winText = '🌟 MEGA!'; color = '#00ffcc'; }
    const eff = $('slotEffect');
    if (eff) { eff.textContent = winText; eff.style.color = color; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2500); }
    const linesHtml = winLines.map(l => `<span class="win-line">${l.dir} ${l.matchCount}×${fmt(l.winAmount)} WCCoin</span>`).join('');
    if($('slotMessage')) $('slotMessage').innerHTML = `<div style="width:100%;text-align:center;margin-bottom:4px">${winText} = <span style="color:#ffcc00">${fmt(totalWin)} WCCoin</span></div><div style="width:100%;text-align:center">${linesHtml}</div>`;
    winPositions.forEach(p => {
      const td = document.querySelectorAll('#reelsBody tr')[p.row].querySelectorAll('td')[p.col];
      if (td) { const s = td.querySelector('.sym'); if (s && !s.classList.contains('scatter')) s.classList.add('win'); }
    });
    coinBalance = slotState.credit;
    updateAllUI();
  }
  
  if (bombFreeSpins > 0) {
    const eff = $('slotEffect');
    if (eff) { eff.textContent = '💣 FREE SPIN!'; eff.style.color = '#ff00ff'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2500); }
    const bombMsg = `💣 <span style="color:#ff00ff">BOMB ${scatterPos.length}!</span> Free Spin ${bombFreeSpins} ခါ!`;
    if ($('slotMessage')) {
      if (totalWin > 0) $('slotMessage').innerHTML += `<div style="width:100%;text-align:center;margin-top:3px">${bombMsg}</div>`;
      else $('slotMessage').innerHTML = bombMsg;
    }
  } else if (totalWin === 0) {
    const eff = $('slotEffect');
    if (eff) { eff.textContent = 'LOSE'; eff.style.color = '#ff4444'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 1500); }
    if($('slotMessage')) $('slotMessage').innerHTML = '😢 <span style="color:#ff4444">LOSE!</span> ထပ်ကြိုးစားပါ';
  }
}

function slotDailyBonus() {
  const today = new Date().toDateString();
  const st = slotState.checkinState;
  if (st.lastCheckin === today) { toast('⚠️ ဒီနေ့ ယူပြီးပါပြီ', 'warn'); return; }
  const dayIdx = new Date().getDate() % 4;
  const reward = DAILY_REWARDS[dayIdx] || 10;
  const yest = new Date(); yest.setDate(yest.getDate() - 1);
  if (st.lastCheckin === yest.toDateString()) st.streak = (st.streak || 0) + 1;
  else st.streak = 1;
  st.lastCheckin = today;
  addCoins(reward, 'daily_bonus', { desc: '🎁 Daily Bonus' }).then(ok => {
    if (ok) {
      showCoinReward(reward);
      toast('🎁 +' + fmt(reward) + ' WCCoin', 'success');
      showPhoneNotification('🎁 Daily Bonus!', '+' + fmt(reward) + ' WCCoin ရရှိပါပြီ');
    }
  });
}

