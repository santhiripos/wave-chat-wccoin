  if (!phoneInput) return toast('ဖုန်းနံပါတ် ထည့်ပါ', 'warn');
  if (!amtInput) return toast('ပမာဏ ထည့်ပါ', 'warn');
  const amt = parseInt(amtInput, 10); if (!amt || amt <= 0) return toast('ပမာဏ မှန်ကန်စွာ ထည့်ပါ', 'warn');
  if (amt > coinBalance) return toast('WCCoin မလုံလောက်ပါ', 'warn');
  if (cleanPhone(phoneInput) === cleanPhone(currentUser.phone)) return toast('ကိုယ့်ကိုယ် လွှဲလို့မရ', 'warn');
  const btn = $('doTransferBtn'); btn.disabled = true;
  try {
    const usersSnap = await db.ref('users').orderByChild('phone').equalTo(displayPhone(phoneInput)).once('value');
    let recipient = null; usersSnap.forEach(child => { if (!recipient) recipient = Object.assign({ _key: child.key }, child.val()); });
    if (!recipient) throw new Error('လက်ခံမည့်သူ မတွေ့ပါ');
    if (recipient.uid === currentUser.uid) throw new Error('ကိုယ့်ကိုယ် လွှဲလို့မရ');
    const ok = await addCoins(-amt, 'transfer_sent', { desc: '💸 Transfer to ' + recipient.name, to: recipient.uid, toName: recipient.name, note });
    if (!ok) throw new Error('လွှဲမရပါ');
    const ok2 = await addCoinsToUser(recipient.uid, amt, 'transfer_received', { desc: '💸 Transfer from ' + currentUser.name, from: currentUser.uid, fromName: currentUser.name, note });
    if (!ok2) { await addCoins(amt, 'transfer_refund', { desc: 'Transfer failed - refund' }); throw new Error('လွှဲမရပါ (rollback)'); }
    toast('✅ ' + fmt(amt) + ' WCCoin လွှဲပြီး', 'success'); showCoinReward(-amt);
    $('trPhone').value = ''; $('trAmount').value = ''; $('trNote').value = '';
  } catch(err) { toast('❌ ' + err.message, 'error'); } finally { btn.disabled = false; }
}

async function requestBuyCoins() {
  if (!selectedPkgId) return toast('Package ရွေးပါ', 'warn');
  const pkg = allCoinPackages[selectedPkgId]; if (!pkg) return toast('Package မတွေ့', 'error');
  const note = $('buyNote').value.trim(); const btn = $('reqBuyBtn'); btn.disabled = true;
  try {
    await db.ref('coin_buy_requests').push({ uid: currentUser.uid, userName: currentUser.name, phone: currentUser.phone, coins: pkg.coins, bonus: pkg.bonus || 0, price: pkg.price, note, status: 'pending', ts: Date.now() });
