}

async function doTransfer() {
  const phoneInput = $('trPhone').value.trim();
  const amtInput = $('trAmount').value.trim();
  const note = $('trNote').value.trim();
  if (!phoneInput) return toast('ဖုန္းနံပါတ္ ထည့္ပါ', 'warn');
  if (!amtInput) return toast('ပမာဏ ထည့္ပါ', 'warn');
  const amt = parseInt(amtInput, 10);
  if (!amt || amt <= 0) return toast('ပမာဏ မွန္ကန္စြာ ထည့္ပါ', 'warn');
  if (amt > coinBalance) return toast('WCCoin မလုံေလာက္ပါ', 'warn');
  if (cleanPhone(phoneInput) === cleanPhone(currentUser.phone)) return toast('ကိုယ့္ကိုယ္ လႊဲလို႔မရ', 'warn');
  const btn = $('doTransferBtn'); btn.disabled = true;
  try {
    const usersSnap = await db.ref('users').orderByChild('phone').equalTo(displayPhone(phoneInput)).once('value');
    let recipient = null;
    usersSnap.forEach(child => { if (!recipient) recipient = Object.assign({ _key: child.key }, child.val()); });
    if (!recipient) throw new Error('လက္ခံမည့္သူ မေတြ႕ပါ');
    if (recipient.uid === currentUser.uid) throw new Error('ကိုယ့္ကိုယ္ လႊဲလို႔မရ');
    const ok = await addCoins(-amt, 'transfer_sent', { desc: ' Transfer to ' + recipient.name, to: recipient.uid, toName: recipient.name, note });
    if (!ok) throw new Error('လႊဲမရပါ');
    const ok2 = await addCoinsToUser(recipient.uid, amt, 'transfer_received', { desc: ' Transfer from ' + currentUser.name, from: currentUser.uid, fromName: currentUser.name, note });
    if (!ok2) { await addCoins(amt, 'transfer_refund', { desc: 'Transfer failed - refund' }); throw new Error('လႊဲမရပါ (rollback)'); }
    toast(' ' + fmt(amt) + ' WCCoin လႊဲၿပီး', 'success');
    showCoinReward(-amt);
    showPhoneNotification(' Transfer sent', '-' + fmt(amt) + ' WCCoin to ' + recipient.name);
    $('trPhone').value = ''; $('trAmount').value = ''; $('trNote').value = '';
  } catch(err) { toast(' ' + err.message, 'error'); } finally { btn.disabled = false; }
}

async function requestBuyCoins() {
  if (!selectedPkgId) return toast('Package ေ႐ြးပါ', 'warn');
  const pkg = allCoinPackages[selectedPkgId];
  if (!pkg) return toast('Package မေတြ႕', 'error');
  const note = $('buyNote').value.trim();
  const btn = $('reqBuyBtn'); btn.disabled = true;
  try {
    await db.ref('coin_buy_requests').push({ uid: currentUser.uid, userName: currentUser.name, phone: currentUser.phone, coins: pkg.coins, bonus: pkg.bonus || 0, price: pkg.price, note, status: 'pending', ts: Date.now() });
    toast(' Request sent! Admin approve လုပ္ပါမယ္', 'success');
    $('buyNote').value = '';
    loadMyBuyRequests();
  } catch(err) { toast(' ' + err.message, 'error'); } finally { btn.disabled = false; }
}

function loadMyBuyRequests() {
  if (!currentUser) return;
  db.ref('coin_buy_requests').orderByChild('uid').equalTo(currentUser.uid).once('value').then(snap => {
    const data = snap.val() || {};
    const list = Object.entries(data).sort((a,b) => (b[1].ts||0) - (a[1].ts||0)).slice(0, 10);
    const wrap = $('myBuyRequests'); if (!wrap) return;
    if (list.length === 0) { wrap.innerHTML = '<div class="empty-state"><span class="em"></span><h3>Request မရွိေသးပါ</h3></div>'; return; }
    wrap.innerHTML = list.map(([id, r]) => {
      const statusColor = r.status === 'approved' ? '#00D9A3' : r.status === 'rejected' ? '#FF4757' : '#FFB800';
      const statusIcon = r.status === 'approved' ? '' : r.status === 'rejected' ? '' : '';
      return `<div class="req-card"><div style="font-size:28px">${statusIcon}</div><div class="req-body"><div class="req-title">${fmt(r.coins || 0)} WCCoin${r.bonus ? ' (+' + r.bonus + ' bonus)' : ''}  ${esc(r.price || '')}</div><div class="req-sub">${new Date(r.ts || Date.now()).toLocaleString()}  <span style="color:${statusColor};font-weight:800">${esc(r.status || 'pending')}</span></div></div></div>`;
    }).join('');
  }).catch(() => {});
}

