    const imgHtml = g.image ? `<img src="${esc(g.image)}" alt="${esc(g.name)}" onerror="this.parentElement.innerHTML='<span class=&quot;gift-placeholder&quot;>${esc(g.emoji || '')}</span>'">` : `<span class="gift-placeholder">${esc(g.emoji || '')}</span>`;
