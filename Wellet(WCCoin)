function renderHistoryList() {
  const wrap = $('historyList'); if (!wrap) return;
  if (txHistory.length === 0) { wrap.innerHTML = '<div class="empty-state"><span class="em"></span><h3>မွတ္တမ္း မရွိေသးပါ</h3><p>Slot ကစားၿပီး WCCoin ရယူပါ</p></div>'; return; }
  const src = getCoinSrc();
  wrap.innerHTML = txHistory.map(tx => {
    const amt = tx.amount || 0; const cls = amt >= 0 ? 'plus' : 'minus'; const sign = amt >= 0 ? '+' : '';
    const desc = tx.game ? (tx.desc + '  ' + tx.game) : (tx.desc || tx.reason || 'Transaction');
    return `<div class="tx-row"><div class="tx-icon ${cls}">${amt >= 0 ? '' : ''}</div><div class="tx-body"><div class="tx-title">${esc(desc)}</div><div class="tx-desc">${new Date(tx.ts || Date.now()).toLocaleString()}</div></div><div class="tx-amount ${cls}">${sign}${fmt(amt)}<div class="coin-icon"><img src="${src}"></div></div></div>`;
  }).join('');
}

function renderPkgGrid() {
  const wrap = $('pkgGrid'); if (!wrap) return;
  const items = Object.entries(allCoinPackages).sort((a,b) => (a[1].order||0) - (b[1].order||0));
  if (items.length === 0) { wrap.innerHTML = '<p style="color:var(--text-2);font-size:15px;padding:20px 0;grid-column:1/-1;text-align:center">Package မရွိေသးပါ။ (Admin မွ ထည့္သြင္းပါ)</p>'; return; }
