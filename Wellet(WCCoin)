function loadAdminVersion() { db.ref('app_config/version').once('value').then(snap => { const v = snap.val() || {}; if($('admLatest')) $('admLatest').value = v.latest || ''; if($('admNotes')) $('admNotes').value = v.releaseNotes || ''; if($('admForce')) $('admForce').checked = !!v.forceUpdate; }); }
async function adminSaveVersion() { const latest = $('admLatest').value.trim(); if (!latest) return toast('Version ထည့္ပါ', 'warn'); await db.ref('app_config/version').set({ latest, releaseNotes: $('admNotes').value.trim(), forceUpdate: $('admForce').checked, releaseDate: Date.now() }); toast(' Version saved', 'success'); }

let _updateVersion = null;
let updateCheckInterval = null;
function checkUpdate() {
  if (!db) return;
  db.ref('app_config/version').once('value').then(snap => {
    const v = snap.val(); if (!v || !v.latest) return;
    const cmp = compareVersion(APP_VERSION, v.latest); if (cmp >= 0) return;
    const dismissed = localStorage.getItem('wc_version_dismissed'); if (dismissed === v.latest) return;
    if (_updateVersion && _updateVersion.latest === v.latest) return;
    showUpdateModal(v);
  }).catch(err => console.warn('[Update]', err.message));
}
function compareVersion(a, b) { const pa = String(a || '0').split('.').map(n => parseInt(n, 10) || 0); const pb = String(b || '0').split('.').map(n => parseInt(n, 10) || 0); const len = Math.max(pa.length, pb.length); for (let i = 0; i < len; i++) { const x = pa[i] || 0, y = pb[i] || 0; if (x > y) return 1; if (x < y) return -1; } return 0; }
function showUpdateModal(v) { _updateVersion = v; if($('newVerLabel')) $('newVerLabel').textContent = v.latest; if($('releaseNotes')) $('releaseNotes').textContent = v.releaseNotes || 'Bug fixes and improvements'; $('updateModal').classList.add('show'); }
function applyUpdate() { if (!_updateVersion) { closeModal('updateModal'); return; } localStorage.setItem('wc_version_dismissed', _updateVersion.latest); _updateVersion = null; closeModal('updateModal'); if ('caches' in window) { caches.keys().then(names => { for (let name of names) caches.delete(name); }).catch(()=>{}); } toast(' Updating App...', 'info'); setTimeout(() => { window.location.href = window.location.href.split('?')[0] + '?t=' + Date.now(); }, 600); }
function checkUpdateManually() { toast(' Checking...', 'info'); db.ref('app_config/version').once('value').then(snap => { const v = snap.val(); if (!v || !v.latest) return toast('Version info မရွိပါ', 'warn'); const cmp = compareVersion(APP_VERSION, v.latest); if (cmp >= 0) return toast(' Latest Version ျဖစ္ပါတယ္', 'success'); showUpdateModal(v); }).catch(err => toast('Failed: ' + err.message, 'error')); }

function init() {
  loadSettingsLocal();
  applyCoinIcons();
  generateReels();
  window.addEventListener('resize', () => { setTimeout(() => { resetReelPositions(); }, 100); });
  db.ref('app_config/coin_packages').on('value', snap => { allCoinPackages = snap.val() || {}; renderPkgGrid(); });
  db.ref('gifts').on('value', snap => { allGifts = snap.val() || {}; renderGiftGrid(); });
  db.ref('app_config/slot_config').on('value', snap => { if (snap.val()) { slotConfig = Object.assign(slotConfig, snap.val()); SLOT_MIN_BET = slotConfig.minBet; SLOT_MAX_BET = slotConfig.maxBet; SLOT_WIN_RATE = slotConfig.winRate; if($('slotWinRateLabel')) $('slotWinRateLabel').textContent = slotConfig.winRate; } });
  db.ref('app_config/slot_force_mode').on('value', snap => { slotForceMode = snap.val() || 'auto'; });
  $('tabLogin') && ($('tabLogin').onclick = () => { playClickSound(); showAuthTab('login'); });
  $('tabSignup') && ($('tabSignup').onclick = () => { playClickSound(); showAuthTab('signup'); });
  $('loginForm') && ($('loginForm').onsubmit = async e => {
    e.preventDefault();
    const phone = $('loginPhone').value.trim(); const pass = $('loginPass').value;
    const errEl = $('loginErr'); const btn = $('loginBtn');
    errEl.textContent = '';
    if (!phone) { errEl.textContent = ' ဖုန္းနံပါတ္ ထည့္ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = ' Password ၆ လုံး'; return; }
    btn.disabled = true; btn.textContent = 'Logging in...';
    try { getAudioCtx(); await login(phone, pass); toast(' Welcome back!', 'success'); }
    catch(err) { errEl.textContent = ' ' + (err.message || 'Login failed'); }
    finally { btn.disabled = false; btn.textContent = 'Login'; }
  });
  $('signupForm') && ($('signupForm').onsubmit = async e => {
    e.preventDefault();
    const name = $('suName').value.trim();
    const phone = $('suPhone').value.trim();
    const pass = $('suPass').value;
    const gender = $('suGender').value;
    const ageGroup = $('suAge').value;
    const errEl = $('signupErr'); const btn = $('signupBtn');
    errEl.textContent = '';
    if (!name || name.length < 2) { errEl.textContent = ' Name ၂ လုံး'; return; }
    if (!phone || phone.replace(/\D/g,'').length < 7) { errEl.textContent = ' ဖုန္းနံပါတ္ မွန္ကန္စြာ ထည့္ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = ' Password ၆ လုံး'; return; }
    if (!gender) { errEl.textContent = ' လိင္အမ်ိဳးအစား ေ႐ြးပါ'; return; }
    if (!ageGroup) { errEl.textContent = ' ေဘာကြဲ ေ႐ြးပါ'; return; }
    btn.disabled = true; btn.textContent = 'Creating...';
    try { getAudioCtx(); await signup(name, phone, pass, gender, ageGroup); toast(' Account created! +100 WCCoin bonus', 'success'); }
    catch(err) { errEl.textContent = ' ' + (err.message || 'Signup failed'); }
    finally { btn.disabled = false; btn.textContent = 'Sign Up'; }
  });
  document.querySelectorAll('.nav-item[data-page]').forEach(btn => { btn.onclick = () => gotoPage(btn.dataset.page); });
  document.querySelectorAll('.admin-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const panel = $('admPanel-' + btn.dataset.tab); if (panel) panel.classList.add('active');
      if (btn.dataset.tab === 'buyreq') loadAdminBuyRequests();
      if (btn.dataset.tab === 'gift') { loadAdminGifts(); renderAdminGifts(); }
      if (btn.dataset.tab === 'giftorders') loadAdminGiftOrders();
      if (btn.dataset.tab === 'slot') { loadAdminSlotConfig(); updateForceModeUI(); }
      if (btn.dataset.tab === 'packages') renderAdminPackages();
      if (btn.dataset.tab === 'version') loadAdminVersion();
    };
  });
  document.querySelectorAll('.modal-overlay').forEach(ov => { ov.addEventListener('click', e => { if (e.target === ov) ov.classList.remove('show'); }); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllModals(); });
  auth.onAuthStateChanged(async user => {
    if (user) {
      const snap = await db.ref('users/' + user.uid).once('value');
      const data = snap.val();
      if (!data) { await auth.signOut(); showScreen('auth'); return; }
      currentUser = { uid: user.uid, ...data };
      settings.name = data.name || settings.name;
      isAdmin = data.isAdmin === true || displayPhone(data.phone) === ADMIN_PHONE;
      showScreen('app');
      loadUserData();
      loadHistory();
      updateAllUI();
      if (!localStorage.getItem('wc_notif_prompted_v2') && Notification.permission !== 'granted') { setTimeout(() => { $('notificationPromptModal').classList.add('show'); localStorage.setItem('wc_notif_prompted_v2', '1'); }, 3000); }
    } else { showScreen('auth'); }
  });
  setTimeout(checkUpdate, 3000);
  if (updateCheckInterval) clearInterval(updateCheckInterval);
  updateCheckInterval = setInterval(checkUpdate, 10 * 60 * 1000);
  console.log(' WC Wallet + Slot v' + APP_VERSION + ' initialized');
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
