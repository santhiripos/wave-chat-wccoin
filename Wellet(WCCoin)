<!DOCTYPE html>
<html lang="my">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0f172a">
<title>WC Wallet + Slot</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Padauk:wght@400;700&family=Noto+Sans+Myanmar:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg-main:#0f172a;
  --bg-card:#1e293b;
  --bg-card-hover:#334155;
  --text-main:#f8fafc;
  --text-muted:#94a3b8;
  --primary:#00b4d8;
  --primary-dark:#0077b6;
  --accent:#fbbf24;
  --accent-dark:#d97706;
  --success:#10b981;
  --danger:#ef4444;
  --border:#334155;
  --grad-primary:linear-gradient(135deg,#00b4d8,#0077b6);
  --grad-accent:linear-gradient(135deg,#fbbf24,#d97706);
  --grad-success:linear-gradient(135deg,#10b981,#059669);
  --grad-danger:linear-gradient(135deg,#ef4444,#dc2626);
  --slot-bg:#020617;
  --slot-border:#fbbf24;
  --reel-bg:#f8fafc;
  --sh-sm:0 2px 8px rgba(0,0,0,.2);
  --sh-md:0 4px 16px rgba(0,0,0,.3);
  --sh-lg:0 8px 32px rgba(0,0,0,.4);
  
  /* ရွှေအဝိုင်းပြား (Gold Coin) ပုံ Data URI */
  --gold-coin: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23FFD700"/><stop offset="0.5" stop-color="%23FFA500"/><stop offset="1" stop-color="%23FF8C00"/></linearGradient></defs><circle cx="50" cy="50" r="45" fill="url(%23g)" stroke="%23B8860B" stroke-width="4"/><circle cx="50" cy="50" r="35" fill="none" stroke="%23FFF8DC" stroke-width="2" opacity="0.6"/><text x="50" y="62" text-anchor="middle" font-family="Arial, sans-serif" font-size="36" font-weight="900" fill="%23B8860B">W</text></svg>');
}
body{
  font-family:'Inter','Padauk','Noto Sans Myanmar',sans-serif;
  background:var(--bg-main);color:var(--text-main);min-height:100vh;
  overflow-x:hidden;-webkit-font-smoothing:antialiased;font-size:15px;line-height:1.6;
}
[data-lang="zg"] { font-family:'Zawgyi-One','Inter',sans-serif; }
[data-lang="en"] { font-family:'Inter',sans-serif; }
.hidden{display:none!important}

/* ===== LANGUAGE SELECTOR ===== */
.lang-bar{position:fixed;top:0;left:0;right:0;background:#020617;padding:8px 16px;display:flex;justify-content:flex-end;align-items:center;gap:8px;z-index:9999;border-bottom:1px solid var(--border)}
.lang-select{background:var(--bg-card);color:var(--text-main);border:1px solid var(--border);padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;outline:none;cursor:pointer;font-family:inherit}

/* ===== LOADING ===== */
.loading{position:fixed;inset:0;background:rgba(15,23,42,.9);display:none;align-items:center;justify-content:center;z-index:99999;backdrop-filter:blur(4px)}
.loading.show{display:flex}
.spinner{width:50px;height:50px;border:5px solid rgba(0,180,216,.15);border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== AUTH SCREEN ===== */
#authScreen{display:none;min-height:100vh;background:linear-gradient(135deg,#020617 0%,#0f172a 50%,#1e1b4b 100%);align-items:center;justify-content:center;padding:60px 20px 20px;position:fixed;inset:0;z-index:1000;overflow-y:auto}
#authScreen.active{display:flex}
.auth-logo{position:absolute;top:60px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12px;z-index:10}
.auth-logo-mark{width:50px;height:50px;border-radius:14px;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;color:#fff;box-shadow:0 8px 24px rgba(0,180,216,.3)}
.auth-logo-text{font-size:28px;font-weight:900;color:#fff;letter-spacing:-.5px}
.auth-logo-text span{color:var(--primary)}
.auth-box{background:var(--bg-card);padding:40px 28px 32px;border-radius:24px;box-shadow:var(--sh-lg);width:440px;max-width:100%;position:relative;z-index:5;margin:60px 0 20px;border:1px solid var(--border)}
.auth-box h1{font-size:30px;font-weight:900;color:var(--primary);text-align:center;margin-bottom:6px}
.auth-box .subtitle{text-align:center;color:var(--text-muted);font-size:15px;margin-bottom:24px;font-weight:500}
.auth-tabs{display:flex;background:var(--bg-main);border-radius:12px;padding:5px;margin-bottom:24px;border:1px solid var(--border)}
.auth-tab{flex:1;padding:12px;border:none;background:transparent;cursor:pointer;font-weight:800;font-size:15px;color:var(--text-muted);border-radius:10px;font-family:inherit;transition:.2s}
.auth-tab.active{background:var(--grad-primary);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}
.auth-form{display:flex;flex-direction:column;gap:16px}
.auth-input-group{position:relative;display:flex;align-items:center}
.auth-input-group .ico{position:absolute;left:16px;font-size:18px;pointer-events:none;z-index:1}
.auth-form input,.auth-form select{
  width:100%;padding:16px 16px 16px 48px;border:1px solid var(--border);border-radius:12px;
  font-size:15px;background:var(--bg-main);transition:.2s;outline:none;color:var(--text-main);
  font-family:inherit;font-weight:500;appearance:none;-webkit-appearance:none;cursor:pointer;
}
.auth-form select{
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-repeat:no-repeat;background-position:right 16px center;padding-right:40px;
}
.auth-form select option{background:var(--bg-card);color:var(--text-main);padding:10px}
.auth-form input:focus,.auth-form select:focus{border-color:var(--primary);background:var(--bg-main);box-shadow:0 0 0 3px rgba(0,180,216,.15)}
.auth-btn{background:var(--grad-primary);color:#fff;padding:16px;border:none;border-radius:12px;font-weight:900;cursor:pointer;font-size:16px;font-family:inherit;transition:.2s;box-shadow:0 4px 16px rgba(0,180,216,.3);margin-top:8px}
.auth-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,180,216,.4)}
.auth-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.auth-err{color:var(--danger);font-size:14px;text-align:center;min-height:20px;font-weight:600}
.auth-footer{margin-top:20px;text-align:center;font-size:13px;color:var(--text-muted);font-weight:500}

/* ===== TOASTS & REWARDS ===== */
.toast-container{position:fixed;top:60px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;pointer-events:none;max-width:calc(100vw - 40px)}
.toast{background:var(--bg-card);padding:16px 20px;border-radius:12px;box-shadow:var(--sh-lg);border-left:4px solid var(--primary);font-size:14px;font-weight:600;color:var(--text-main);min-width:260px;max-width:380px;pointer-events:auto;display:flex;align-items:center;gap:12px;animation:slideRight .3s ease-out}
.toast.success{border-left-color:var(--success)}
.toast.error{border-left-color:var(--danger)}
.toast.warn{border-left-color:var(--accent)}
@keyframes slideRight{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

.coin-reward{position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-200px);background:var(--grad-accent);color:#fff;padding:12px 24px;border-radius:30px;font-weight:900;font-size:18px;box-shadow:0 8px 24px rgba(251,191,36,.4);z-index:99998;transition:transform .4s cubic-bezier(.4,0,.2,1);pointer-events:none;display:flex;align-items:center;gap:8px}
.coin-reward.show{transform:translateX(-50%) translateY(0)}
.coin-reward .coin-icon{width:24px;height:24px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}

/* ===== APP SHELL ===== */
.app-shell{display:none;min-height:100vh;padding-top:40px}
.app-shell.active{display:flex}
.sidebar{width:240px;background:var(--bg-card);border-right:1px solid var(--border);padding:20px 12px;display:flex;flex-direction:column;position:fixed;top:40px;bottom:0;left:0;z-index:20;overflow-y:auto}
.sidebar-logo{display:flex;align-items:center;gap:10px;padding:0 8px;margin-bottom:24px}
.logo-mark{width:40px;height:40px;border-radius:12px;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;color:#fff}
.sidebar-logo h1{font-size:18px;font-weight:900}
.sidebar-logo p{font-size:10px;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;font-weight:700}
.nav-section{font-size:11px;color:var(--text-muted);font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:0 12px;margin:16px 0 8px}
.nav-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;cursor:pointer;transition:.2s;color:var(--text-muted);font-size:14px;font-weight:700;margin-bottom:4px;border:none;background:transparent;width:100%;text-align:left;font-family:inherit}
.nav-item .ni-icon{font-size:18px;width:22px;text-align:center}
.nav-item:hover{background:var(--bg-card-hover);color:var(--text-main)}
.nav-item.active{background:linear-gradient(90deg,rgba(0,180,216,.15),rgba(0,180,216,.05));color:var(--primary);border-left:3px solid var(--primary)}
.nav-wallet{margin-top:8px}
.wallet-row{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;cursor:pointer;transition:.2s;margin-bottom:6px}
.wallet-row:hover{background:var(--bg-card-hover)}
.wallet-row .wr-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.wallet-row .wr-meta{flex:1;min-width:0}
.wallet-row .wr-meta h5{font-size:14px;font-weight:800;margin-bottom:2px}
.wallet-row .wr-meta p{font-size:12px;color:var(--text-muted);font-weight:600}
.sb-user{margin-top:auto;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;background:var(--bg-main);border:1px solid var(--border);cursor:pointer;transition:.2s}
.sb-user:hover{background:var(--bg-card-hover)}
.sb-avatar{width:40px;height:40px;border-radius:50%;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;color:#fff;flex-shrink:0}
.sb-user h5{font-size:14px;font-weight:800}
.sb-user p{font-size:11px;color:var(--text-muted);font-weight:600}

.main-content{flex:1;margin-left:240px;padding:24px 30px 50px;position:relative;z-index:2}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:16px;flex-wrap:wrap}
.topbar-left h2{font-size:24px;font-weight:900;letter-spacing:-.5px}
.topbar-left p{font-size:14px;color:var(--text-muted);margin-top:4px;font-weight:500}
.topbar-right{display:flex;align-items:center;gap:12px}
.avatar-btn{width:44px;height:44px;border-radius:50%;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:18px;cursor:pointer;box-shadow:var(--sh-sm);position:relative;border:none;font-family:inherit}
.avatar-btn .status-dot{position:absolute;bottom:2px;right:2px;width:12px;height:12px;background:var(--success);border:2px solid var(--bg-main);border-radius:50%}
.logout-btn{background:var(--bg-card);border:1px solid var(--danger);border-radius:10px;padding:10px 16px;font-size:14px;font-weight:800;cursor:pointer;font-family:inherit;color:var(--danger);transition:.2s}
.logout-btn:hover{background:rgba(239,68,68,.1)}

/* ===== PAGE VIEWS ===== */
.page-view{display:none}
.page-view.active{display:block;animation:fadeUp .3s ease-out}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ===== BALANCE / STATS ===== */
.balance-card{background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);border-radius:24px;padding:30px;color:#fff;position:relative;overflow:hidden;margin-bottom:24px;box-shadow:var(--sh-md);border:1px solid var(--border)}
.balance-card::before{content:'';position:absolute;top:-50%;right:-30%;width:300px;height:300px;background:radial-gradient(circle,rgba(0,180,216,.15),transparent 70%);border-radius:50%}
.balance-card::after{content:'';position:absolute;bottom:-60%;left:-20%;width:250px;height:250px;background:radial-gradient(circle,rgba(251,191,36,.1),transparent 70%);border-radius:50%}
.balance-label{font-size:13px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--primary);margin-bottom:10px;position:relative;z-index:2}
.balance-amount{font-size:44px;font-weight:900;letter-spacing:-1px;line-height:1.1;position:relative;z-index:2;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.balance-amount .coin-icon{width:40px;height:40px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}
.balance-amount small{font-size:18px;font-weight:800;color:var(--text-muted)}
.balance-sub{font-size:14px;margin-top:10px;font-weight:500;color:var(--text-muted);position:relative;z-index:2;display:flex;align-items:center;gap:8px}
.balance-actions{display:flex;gap:12px;margin-top:20px;position:relative;z-index:2}
.balance-action{flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#fff;padding:14px 12px;border-radius:12px;font-size:15px;font-weight:800;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;transition:.2s;backdrop-filter:blur(10px)}
.balance-action:hover{background:rgba(255,255,255,.1);transform:translateY(-2px)}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}
.stat-box{background:var(--bg-card);border:1px solid var(--border);border-radius:18px;padding:20px;box-shadow:var(--sh-sm);transition:.25s}
.stat-box:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
.stat-box .sb-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.stat-box .sb-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;background:var(--bg-main)}
.stat-box .sb-label{font-size:13px;color:var(--text-muted);font-weight:700;margin-bottom:6px}
.stat-box .sb-value{font-size:24px;font-weight:900;letter-spacing:-.5px;line-height:1.15;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.stat-box .sb-value small{font-size:13px;font-weight:700;color:var(--text-muted)}
.stat-box .sb-value .inline-coin{width:24px;height:24px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}
.stat-box .sb-foot{font-size:12px;color:var(--text-muted);margin-top:8px;font-weight:500}

.action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin-bottom:24px}
.action-tile{background:var(--bg-card);border:1px solid var(--border);border-radius:18px;padding:20px 14px;display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm);font-family:inherit}
.action-tile:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:var(--primary)}
.action-tile .at-icon{width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;background:var(--bg-main)}
.action-tile h4{font-size:15px;font-weight:800;color:var(--text-main);text-align:center;line-height:1.2}
.action-tile p{font-size:12px;color:var(--text-muted);font-weight:600;text-align:center}

/* ===== WALLET CARDS ===== */
.wallets-section{margin-bottom:24px}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.section-header h3{font-size:20px;font-weight:900;letter-spacing:-.5px;display:flex;align-items:center;gap:8px}
.section-header a{font-size:13px;color:var(--primary);font-weight:800;cursor:pointer;text-decoration:none}
.wallet-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.wallet-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:20px;position:relative;overflow:hidden;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm)}
.wallet-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.wallet-card::before{content:'';position:absolute;top:-40%;right:-20%;width:180px;height:180px;border-radius:50%;opacity:.1;filter:blur(20px);background:var(--primary)}
.wallet-card-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;position:relative;z-index:2}
.wallet-logo{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;color:#fff;flex-shrink:0;background:var(--grad-primary)}
.wallet-card-head .wc-name{flex:1;min-width:0}
.wallet-card-head .wc-name h4{font-size:16px;font-weight:900;margin-bottom:2px}
.wallet-card-head .wc-name p{font-size:12px;color:var(--text-muted);font-weight:600}
.wallet-balance{font-size:30px;font-weight:900;letter-spacing:-1px;position:relative;z-index:2;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.wallet-balance small{font-size:14px;font-weight:800;color:var(--text-muted)}
.wallet-balance .inline-coin{width:28px;height:28px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center}
.wallet-meta{font-size:12px;color:var(--text-muted);margin-top:8px;font-weight:500;position:relative;z-index:2}

/* ===== SLOT GAME ===== */
.slot-wrapper{background:linear-gradient(145deg,#1a0a2e 0%,#0a0118 50%,#12031f 100%);border-radius:24px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 0 2px rgba(251,191,36,.3),inset 0 0 40px rgba(251,191,36,.05);max-width:980px;margin:0 auto;position:relative;overflow:hidden}
.slot-top{display:flex;justify-content:space-between;align-items:center;background:rgba(22,8,41,.9);border:1px solid rgba(251,191,36,.5);border-radius:12px;padding:10px 16px;margin-bottom:12px;position:relative;z-index:2;backdrop-filter:blur(10px)}
.slot-credit{display:flex;align-items:center;gap:8px;color:var(--accent);font-weight:900;font-size:15px}
.slot-credit .coin-icon{width:24px;height:24px;background-image:var(--gold-coin);background-size:contain;background-repeat:no-repeat;background-position:center;filter:drop-shadow(0 0 6px rgba(251,191,36,.5))}
.slot-credit .lbl{font-size:12px;color:var(--text-muted);margin-right:4px}
.slot-credit .val{color:#00ffcc;font-size:20px;text-shadow:0 0 10px rgba(0,255,204,.6)}
.slot-top-right{display:flex;gap:8px}
.slot-btn-sm{background:var(--grad-accent);color:#1a0b2e;border:none;border-radius:8px;width:36px;height:36px;cursor:pointer;font-weight:900;font-size:14px;display:flex;align-items:center;justify-content:center;transition:.15s}
.slot-btn-sm:active{transform:scale(.9)}
.slot-title{text-align:center;font-size:36px;font-weight:900;background:linear-gradient(180deg,#FFD700 0%,#FF8C00 50%,#FFD700 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:6px;margin:8px 0 2px;position:relative;z-index:2;filter:drop-shadow(0 0 15px rgba(251,191,36,.6))}
.slot-subtitle{text-align:center;font-size:11px;color:#00ffcc;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px;border:1px solid rgba(0,255,204,.4);border-radius:6px;padding:4px;background:rgba(0,255,204,.05);font-weight:800;position:relative;z-index:2}
.slot-info-row{display:flex;justify-content:space-around;background:rgba(42,8,69,.8);border:1px solid rgba(251,191,36,.3);border-radius:10px;padding:8px 12px;margin-bottom:12px;position:relative;z-index:2}
.slot-info-item{display:flex;flex-direction:column;align-items:center;min-width:60px}
.slot-info-item .lbl{font-size:9px;color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:1px}
.slot-info-item .val{font-size:18px;color:#fff;font-weight:900;margin-top:2px}
.slot-main{display:flex;gap:10px;margin-bottom:12px;position:relative;z-index:2}
.slot-ways{display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(180deg,#4a0000,#2a0000);border:1px solid rgba(251,191,36,.4);border-radius:10px;padding:8px 4px;width:36px;flex-shrink:0}
.slot-ways span{writing-mode:vertical-rl;color:var(--accent);font-weight:900;font-size:10px;letter-spacing:2px}
.slot-reels{flex:1;background:linear-gradient(180deg,#0a0015,#1a0525);border:3px solid var(--accent);border-radius:12px;padding:6px;position:relative;min-width:0;overflow:hidden;box-shadow:inset 0 0 30px rgba(251,191,36,.1)}
.reels-frame{position:relative;width:100%;height:100%;border-radius:8px;overflow:hidden;background:#0a0015}
.reels-container{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:4px;width:100%;height:100%;background:linear-gradient(180deg,#1a0a2e,#0a0015);border-radius:8px}
