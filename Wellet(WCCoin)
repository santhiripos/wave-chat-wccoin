  db.ref('app_config/slot_force_mode').on('value', snap => { slotForceMode = snap.val() || 'auto'; });
  
  $('tabLogin') && ($('tabLogin').onclick = () => { playClickSound(); showAuthTab('login'); });
  $('tabSignup') && ($('tabSignup').onclick = () => { playClickSound(); showAuthTab('signup'); });
  
  $('loginForm') && ($('loginForm').onsubmit = async e => {
    e.preventDefault();
    const phone = $('loginPhone').value.trim(); const pass = $('loginPass').value;
    const errEl = $('loginErr'); const btn = $('loginBtn');
    errEl.textContent = '';
    if (!phone) { errEl.textContent = '⚠️ ဖုန်းနံပါတ် ထည့်ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = '⚠️ Password ၆ လုံး'; return; }
    btn.disabled = true; btn.textContent = 'Logging in...';
    try { getAudioCtx(); await login(phone, pass); toast('✅ Welcome back!', 'success'); }
    catch(err) { errEl.textContent = '⚠️ ' + (err.message || 'Login failed'); }
    finally { btn.disabled = false; btn.textContent = translations[settings.lang].btn_login; }
  });
  
  $('signupForm') && ($('signupForm').onsubmit = async e => {
    e.preventDefault();
    const name = $('suName').value.trim(); const phone = $('suPhone').value.trim(); const pass = $('suPass').value; const gender = $('suGender').value; const ageGroup = $('suAge').value;
    const errEl = $('signupErr'); const btn = $('signupBtn');
    errEl.textContent = '';
    if (!name || name.length < 2) { errEl.textContent = '⚠️ Name ၂ လုံး'; return; }
    if (!phone || phone.replace(/\D/g,'').length < 7) { errEl.textContent = '⚠️ ဖုန်းနံပါတ် မှန်ကန်စွာ ထည့်ပါ'; return; }
    if (pass.length < 6) { errEl.textContent = '⚠️ Password ၆ လုံး'; return; }
    if (!gender) { errEl.textContent = '⚠️ လိင်အမျိုးအစား ရွေးပါ'; return; }
    if (!ageGroup) { errEl.textContent = '⚠️ ဘောကွဲ ရွေးပါ'; return; }
    btn.disabled = true; btn.textContent = 'Creating...';
    try { getAudioCtx(); await signup(name, phone, pass, gender, ageGroup); toast('🎉 Account created! +100 WCCoin bonus', 'success'); }
    catch(err) { errEl.textContent = '⚠️ ' + (err.message || 'Signup failed'); }
    finally { btn.disabled = false; btn.textContent = translations[settings.lang].btn_signup; }
  });

  document.querySelectorAll('.nav-item[data-page]').forEach(btn => { btn.onclick = () => gotoPage(btn.dataset.page); });
  
  document.querySelectorAll('.admin-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const panel = $('admPanel-' + btn.dataset.tab); if (panel) panel.classList.add('active');
      if (btn.dataset.tab === 'buyreq') loadAdminBuyRequests();
      if (btn.dataset.tab === 'gift') { loadAdminGifts(); renderAdminGifts(); }
      if (btn.dataset.tab === 'giftorders') loadAdminGiftOrders();
      if (btn.dataset.tab === 'slot') { loadAdminSlotConfig(); updateForceModeUI(); }
      if (btn.dataset.tab === 'packages') renderAdminPackages();
      if (btn.dataset.tab === 'version') loadAdminVersion();
    };
  });
  
  document.querySelectorAll('.modal-overlay').forEach(ov => { ov.addEventListener('click', e => { if (e.target === ov) ov.classList.remove('show'); }); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllModals(); });
  
  auth.onAuthStateChanged(async user => {
    if (user) {
      const snap = await db.ref('users/' + user.uid).once('value');
      const data = snap.val();
      if (!data) { await auth.signOut(); showScreen('auth'); return; }
      currentUser = { uid: user.uid, ...data };
      settings.name = data.name || settings.name;
      isAdmin = data.isAdmin === true || displayPhone(data.phone) === ADMIN_PHONE;
      showScreen('app'); loadUserData(); loadHistory(); updateAllUI();
      if (!localStorage.getItem('wc_notif_prompted_v2') && Notification.permission !== 'granted') { setTimeout(() => { $('notificationPromptModal').classList.add('show'); localStorage.setItem('wc_notif_prompted_v2', '1'); }, 3000); }
    } else { showScreen('auth'); }
  });
  
  setTimeout(checkUpdate, 3000);
  if (updateCheckInterval) clearInterval(updateCheckInterval);
  updateCheckInterval = setInterval(checkUpdate, 10 * 60 * 1000);
  console.log('✅ WC Wallet + Slot v' + APP_VERSION + ' initialized');
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
</body>
</html>
