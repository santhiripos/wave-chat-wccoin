.admin-tab{padding:14px 22px;border:none;background:transparent;font-weight:800;font-size:15px;cursor:pointer;border-radius:var(--r-pill);color:var(--text-2);font-family:inherit;white-space:nowrap;transition:.2s}
.admin-tab.active{background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}
.admin-panel{display:none}
