function syncSlotCredit() { slotState.credit = coinBalance; if($('slotCredit')) $('slotCredit').textContent = fmt(coinBalance); if($('slotBetValue')) $('slotBetValue').textContent = fmt(slotState.bet); if($('slotBetDisplay')) $('slotBetDisplay').textContent = fmt(slotState.bet); updateSlotVIP(); }
function randomSymbol() { const rand = Math.random(); if (rand < 0.04) return SCATTER_SYMBOL; if (rand < 0.6) return SYMBOLS[Math.floor(Math.random() * 5)]; if (rand < 0.9) return SYMBOLS[Math.floor(Math.random() * 10)]; return SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]; }
function buildCell(symKey) { const cell = document.createElement('div'); cell.className = 'reel-cell'; const s = document.createElement('div'); s.className = 'sym' + (symKey === SCATTER_SYMBOL ? ' bomb' : ''); s.innerHTML = SVG_ICONS[symKey] || SVG_ICONS['cherry']; s.dataset.sym = symKey; cell.appendChild(s); return cell; }

function generateReels() {
  const container = $('reelsContainer'); if (!container) return;
  container.innerHTML = ''; _reelColumns = []; _reelStrips = []; _reelOffsets = [0,0,0,0,0];
  for (let c = 0; c < 5; c++) {
    const col = document.createElement('div'); col.className = 'reel-column'; col.dataset.col = c;
    const strip = document.createElement('div'); strip.className = 'reel-strip'; strip.dataset.col = c;
    for (let i = 0; i < REEL_VISIBLE + REEL_BUFFER * 2; i++) strip.appendChild(buildCell(randomSymbol()));
    col.appendChild(strip); container.appendChild(col);
    _reelColumns.push(col); _reelStrips.push(strip);
  }
  resetReelPositions();
}

function resetReelPositions() { const cellH = getCellHeight(); if (!cellH) return; _reelOffsets = [0,0,0,0,0]; for (let c = 0; c < 5; c++) { const strip = _reelStrips[c]; if (!strip) continue; strip.style.transition = 'none'; strip.style.transform = `translateY(${-cellH * REEL_BUFFER}px)`; _reelOffsets[c] = -cellH * REEL_BUFFER; } }

function getCellHeight() { if (!_reelStrips[0]) return 0; const firstCell = _reelStrips[0].querySelector('.reel-cell'); if (!firstCell) return 0; const rect = firstCell.getBoundingClientRect(); const style = window.getComputedStyle(firstCell); const margin = (parseFloat(style.marginTop) || 0) + (parseFloat(style.marginBottom) || 0); return rect.height + margin; }

function spinColumn(colIndex, targetSymbols, duration, onDone) {
  const strip = _reelStrips[colIndex]; const colEl = _reelColumns[colIndex];
  if (!strip || !colEl) { if (onDone) onDone(); return; }
  const cellH = getCellHeight(); if (!cellH) { if (onDone) onDone(); return; }
  colEl.classList.add('spinning');
  const totalScrollCells = 30 + colIndex * 5;
  const startOffset = _reelOffsets[colIndex];
  const requiredCells = totalScrollCells + REEL_VISIBLE + REEL_BUFFER;
  while (strip.children.length < requiredCells + REEL_BUFFER * 2) strip.appendChild(buildCell(randomSymbol()));
  const finalCells = targetSymbols.slice(0, REEL_VISIBLE).map(buildCell);
  const targetEndIndex = totalScrollCells + REEL_VISIBLE;
  const totalNeeded = targetEndIndex + REEL_BUFFER;
  while (strip.children.length < totalNeeded) strip.appendChild(buildCell(randomSymbol()));
  for (let i = 0; i < finalCells.length; i++) { const idx = totalScrollCells + i; if (strip.children[idx]) strip.replaceChild(finalCells[i], strip.children[idx]); }
  const endOffset = -cellH * totalScrollCells;
  const durationMs = Math.max(duration, 200);
  strip.style.transition = `transform ${durationMs}ms cubic-bezier(0.2, 0.9, 0.3, 1)`;
  void strip.offsetHeight;
  strip.style.transform = `translateY(${endOffset}px)`;
  _reelOffsets[colIndex] = endOffset;
  setTimeout(() => { colEl.classList.remove('spinning'); cleanupColumn(colIndex, totalScrollCells, cellH); playReelStopSound(colIndex); if (onDone) onDone(); }, durationMs + 20);
}

function cleanupColumn(colIndex, targetStartIndex, cellH) { const strip = _reelStrips[colIndex]; if (!strip) return; const keepAbove = REEL_BUFFER; const removeCount = Math.max(0, targetStartIndex - keepAbove); for (let i = 0; i < removeCount; i++) { if (strip.firstChild) strip.removeChild(strip.firstChild); } const newOffset = _reelOffsets[colIndex] + cellH * removeCount; strip.style.transition = 'none'; strip.style.transform = `translateY(${newOffset}px)`; _reelOffsets[colIndex] = newOffset; void strip.offsetHeight; }

function slotSpin() {
  if (slotState.spinning) return;
  if (!currentUser) return toast('Login လုပ္ပါ', 'warn');
  if (slotConfig.status === 'disabled') { toast(' Slot ပိတ္ထားပါသည္', 'warn'); return; }
  if (!slotState.isFreeSpin && slotState.bet > slotState.credit) { toast(' WCCoin မလုံေလာက္ပါ', 'warn'); slotStopAuto(); return; }
  getAudioCtx(); playSpinSound();
  if (!slotState.isFreeSpin) { slotState.credit -= slotState.bet; if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit); addCoins(-slotState.bet, 'bet', { desc: ' Slot Bet', game: 'Slot' }); }
  if($('slotWinDisplay')) $('slotWinDisplay').textContent = '0';
  slotState.spinning = true;
  if($('slotSpinBtn')) $('slotSpinBtn').disabled = true;
  if($('slotAutoBtn')) $('slotAutoBtn').disabled = true;
  if($('slotMessage')) $('slotMessage').textContent = slotState.isFreeSpin ? ` Free Spin! (${slotState.freeSpins})` : ' လွည့္ေနသည္...';
  slotState.totalSpins++; totalGamesPlayed++;
  db.ref('users/' + currentUser.uid + '/games_played').set(totalGamesPlayed).catch(()=>{});
  if($('slotEffect')) $('slotEffect').classList.remove('show');
  if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show');
  document.querySelectorAll('.reel-cell .sym').forEach(el => el.classList.remove('win', 'scatter'));
  let winChance = false;
  if (slotForceMode === 'win') winChance = true;
  else if (slotForceMode === 'lose') winChance = false;
  else winChance = Math.random() * 100 < slotConfig.winRate;
  const results = []; let bombCount = 0;
  for (let c = 0; c < 5; c++) {
    const colRes = [];
    for (let r = 0; r < REEL_VISIBLE; r++) {
      let sym;
      const rand = Math.random();
      if (rand < 0.03 && bombCount < 2) { sym = SCATTER_SYMBOL; bombCount++; }
      else { if (rand < 0.6) sym = SYMBOLS[Math.floor(Math.random() * 5)]; else if (rand < 0.9) sym = SYMBOLS[Math.floor(Math.random() * 10)]; else sym = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]; }
      colRes.push(sym);
    }
    results.push(colRes);
  }
  if (winChance && !slotState.isFreeSpin) { const low = ['cherry','lemon','orange','plum','watermelon']; const rs = low[Math.floor(Math.random() * low.length)]; results[0][1] = rs; results[1][1] = rs; results[2][1] = rs; }
  const baseDur = slotState.turbo ? 300 : 700; const staggerDur = slotState.turbo ? 60 : 150;
  let finishedCount = 0;
  for (let c = 0; c < 5; c++) {
    const colDur = baseDur + c * staggerDur;
    spinColumn(c, results[c], colDur, () => {
      finishedCount++;
      if (finishedCount === 5) {
        setTimeout(() => {
          slotCheckWin(results);
          slotState.spinning = false;
          if($('slotSpinBtn')) $('slotSpinBtn').disabled = false;
          if($('slotAutoBtn')) $('slotAutoBtn').disabled = false;
          if (slotState.isFreeSpin) { slotState.freeSpins--; if (slotState.freeSpins > 0) setTimeout(() => slotSpin(), slotState.turbo ? 300 : 800); else { slotState.isFreeSpin = false; if($('slotFreeSpin')) $('slotFreeSpin').classList.remove('show'); } }
          if (slotState.auto && slotState.autoCount > 0) { slotState.autoCount--; if($('slotAutoBtn')) $('slotAutoBtn').innerHTML = `<br><span class="btn-label">(${slotState.autoCount})</span>`; if (slotState.autoCount > 0) setTimeout(() => slotSpin(), slotState.turbo ? 300 : 800); else slotStopAuto(); }
        }, 80);
      }
    });
  }
}

function slotStopAuto() { slotState.auto = false; slotState.autoCount = 0; if($('slotAutoBtn')) { $('slotAutoBtn').innerHTML = '<br><span class="btn-label">AUTO</span>'; $('slotAutoBtn').style.background = 'linear-gradient(180deg,#ff00ff,#c400c4)'; } }
function slotToggleAuto() { if (slotState.spinning) return; playClickSound(); slotState.auto = !slotState.auto; if (slotState.auto) { slotState.autoCount = 10; if($('slotAutoBtn')) { $('slotAutoBtn').innerHTML = `<br><span class="btn-label">(${slotState.autoCount})</span>`; $('slotAutoBtn').style.background = 'linear-gradient(180deg,#ff0000,#cc0000)'; } if($('slotMessage')) $('slotMessage').textContent = ' Auto Spin!'; setTimeout(() => { if (!slotState.spinning && slotState.auto) slotSpin(); }, 250); } else { slotStopAuto(); if($('slotMessage')) $('slotMessage').textContent = 'Auto ရပ္'; } }
function slotToggleTurbo() { playClickSound(); slotState.turbo = !slotState.turbo; if($('slotTurboBtn')) $('slotTurboBtn').style.background = slotState.turbo ? 'linear-gradient(180deg,#ff0000,#cc0000)' : 'linear-gradient(180deg,#ffaa00,#cc8800)'; if($('slotMessage')) $('slotMessage').textContent = slotState.turbo ? ' Turbo ON!' : 'Turbo OFF'; }
function slotChangeBet(delta) { if (slotState.spinning) return; playClickSound(); let nb = slotState.bet + delta; if (nb < slotConfig.minBet) nb = slotConfig.minBet; if (nb > slotConfig.maxBet) nb = slotConfig.maxBet; if (nb > coinBalance) { if($('slotMessage')) $('slotMessage').textContent = ' WCCoin မလုံေလာက္'; return; } slotState.bet = nb; slotState.baseBet = nb; syncSlotCredit(); }
function slotQuickBet(mult) { if (slotState.spinning) return; playClickSound(); const nb = slotState.baseBet * mult; if (nb > slotConfig.maxBet) return; if (nb > coinBalance) { if($('slotMessage')) $('slotMessage').textContent = ' WCCoin မလုံေလာက္'; return; } slotState.bet = nb; syncSlotCredit(); if($('slotMessage')) $('slotMessage').textContent = ` ${fmt(nb)} WCCoin (${mult})`; }

function slotCheckWin(results) {
  let totalWin = 0; const winPositions = []; const winLines = []; let hasJackpot = false;
  const scatterPos = [];
  for (let c = 0; c < 5; c++) for (let r = 0; r < REEL_VISIBLE; r++) { if (results[c][r] === SCATTER_SYMBOL) scatterPos.push({ col: c, row: r }); }
  let bombFreeSpins = 0;
  const freeSpinChance = Math.random() * 100 < slotConfig.freeSpinRate;
  if (scatterPos.length >= 3 || freeSpinChance) {
    if (scatterPos.length === 3) bombFreeSpins = 5; else if (scatterPos.length === 4) bombFreeSpins = 7; else if (scatterPos.length >= 5) bombFreeSpins = 10; else bombFreeSpins = 3;
    slotState.freeSpins += bombFreeSpins; slotState.isFreeSpin = true;
    if($('slotFreeSpin')) $('slotFreeSpin').classList.add('show');
    scatterPos.forEach(p => { winPositions.push(p); const strip = _reelStrips[p.col]; if (!strip) return; const cell = strip.children[REEL_BUFFER + p.row]; if (cell) { const s = cell.querySelector('.sym'); if (s) s.classList.add('scatter'); } });
  }
  const lines = [
    { positions: [{c:0,r:0},{c:1,r:0},{c:2,r:0},{c:3,r:0},{c:4,r:0}], dir:'' },
    { positions: [{c:0,r:1},{c:1,r:1},{c:2,r:1},{c:3,r:1},{c:4,r:1}], dir:'' },
    { positions: [{c:0,r:2},{c:1,r:2},{c:2,r:2},{c:3,r:2},{c:4,r:2}], dir:'' },
    { positions: [{c:0,r:0},{c:1,r:1},{c:2,r:2},{c:3,r:1},{c:4,r:0}], dir:'' },
    { positions: [{c:0,r:2},{c:1,r:1},{c:2,r:0},{c:3,r:1},{c:4,r:2}], dir:'' },
    { positions: [{c:0,r:0},{c:1,r:1},{c:2,r:1},{c:3,r:1},{c:4,r:0}], dir:'V' },
    { positions: [{c:0,r:2},{c:1,r:1},{c:2,r:1},{c:3,r:1},{c:4,r:2}], dir:'^' }
  ];
  lines.forEach(line => {
    const syms = line.positions.map(p => results[p.c][p.r]);
    const firstSym = syms[0];
    if (!firstSym || firstSym === SCATTER_SYMBOL) return;
    let count = 1; const matchedPositions = [0];
    for (let i = 1; i < syms.length; i++) { if (syms[i] === firstSym) { count++; matchedPositions.push(i); } else break; }
    if (PAYOUTS[firstSym] && count >= 3) {
      const mult = PAYOUTS[firstSym][count];
      if (mult) {
        const amount = slotState.bet * mult; totalWin += amount;
        if (count >= 5) hasJackpot = true;
        const mp = matchedPositions.map(i => line.positions[i]);
        winLines.push({ positions: mp, symbol: firstSym, matchCount: count, winAmount: amount, dir: line.dir });
        mp.forEach(p => winPositions.push(p));
      }
    }
  });
  const maxWin = slotState.bet * slotConfig.maxWinMultiplier;
  if (totalWin > maxWin) totalWin = maxWin;
  if (totalWin > 0) {
    slotState.credit += totalWin; slotState.totalWins += totalWin; totalWins += totalWin;
    if($('slotWinDisplay')) $('slotWinDisplay').textContent = fmt(totalWin);
    if($('slotCredit')) $('slotCredit').textContent = fmt(slotState.credit);
    addCoins(totalWin, 'game_reward', { desc: ' Slot Win', game: 'Slot' }).then(ok => { if (ok) { showCoinReward(totalWin); showPhoneNotification(' WCCoin ရရွိပါၿပီ!', '+' + fmt(totalWin) + ' WCCoin Slot ကေန'); } });
    db.ref('users/' + currentUser.uid + '/total_wins').set(totalWins).catch(()=>{});
    let winText = ' WIN!', color = '#00ffcc', sound;
    if (hasJackpot || totalWin >= slotState.bet * 500) { winText = ' JACKPOT!'; color = '#ff00ff'; sound = playJackpotSound; }
    else if (totalWin >= slotState.bet * 100) { winText = ' MEGA WIN!'; color = '#ff00ff'; sound = playMegaWinSound; }
    else if (totalWin >= slotState.bet * 50) { winText = ' SUPER WIN!'; color = '#ffcc00'; sound = playSuperWinSound; }
    else if (totalWin >= slotState.bet * 20) { winText = ' WIN BIG!'; color = '#00ffcc'; sound = playBigWinSound; }
    else { sound = playWinSound; }
    if (sound) sound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = winText; eff.style.color = color; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2800); }
    const linesHtml = winLines.map(l => `<span class="win-line">${l.dir} ${l.matchCount}${fmt(l.winAmount)} WCCoin</span>`).join('');
    if($('slotMessage')) $('slotMessage').innerHTML = `<div style="width:100%;text-align:center;margin-bottom:4px">${winText} = <span style="color:#ffcc00">${fmt(totalWin)} WCCoin</span></div><div style="width:100%;text-align:center">${linesHtml}</div>`;
    winPositions.forEach(p => { const strip = _reelStrips[p.col]; if (!strip) return; const cell = strip.children[REEL_BUFFER + p.r]; if (cell) { const s = cell.querySelector('.sym'); if (s && !s.classList.contains('scatter')) s.classList.add('win'); } });
    coinBalance = slotState.credit; updateAllUI();
  }
  if (bombFreeSpins > 0) {
    playFreeSpinSound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = ' FREE SPIN!'; eff.style.color = '#ff00ff'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 2500); }
    const bombMsg = ` <span style="color:#ff00ff">BOMB ${scatterPos.length}!</span> Free Spin ${bombFreeSpins} ခါ!`;
    if ($('slotMessage')) { if (totalWin > 0) $('slotMessage').innerHTML += `<div style="width:100%;text-align:center;margin-top:3px">${bombMsg}</div>`; else $('slotMessage').innerHTML = bombMsg; }
  } else if (totalWin === 0) {
    playLoseSound();
    const eff = $('slotEffect');
    if (eff) { eff.textContent = 'LOSE'; eff.style.color = '#ff4444'; eff.classList.add('show'); setTimeout(() => eff.classList.remove('show'), 1500); }
    if($('slotMessage')) $('slotMessage').innerHTML = '😢 <span style="color:#ff4444">LOSE!</span> ထပ္ႀကိဳးစားပါ';
  }
}

function slotDailyBonus() {
  playClickSound();
  const today = new Date().toDateString();
  const st = slotState.checkinState;
  if (st.lastCheckin === today) { toast(' ဒီေန႕ ယူၿပီးပါၿပီ', 'warn'); return; }
  const dayIdx = new Date().getDate() % 4;
  const reward = DAILY_REWARDS[dayIdx] || 10;
  const yest = new Date(); yest.setDate(yest.getDate() - 1);
  if (st.lastCheckin === yest.toDateString()) st.streak = (st.streak || 0) + 1; else st.streak = 1;
  st.lastCheckin = today;
  addCoins(reward, 'daily_bonus', { desc: ' Daily Bonus' }).then(ok => { if (ok) { showCoinReward(reward); toast(' +' + fmt(reward) + ' WCCoin', 'success'); showPhoneNotification(' Daily Bonus!', '+' + fmt(reward) + ' WCCoin ရရွိပါၿပီ'); } });
}

