<!DOCTYPE html>
<html lang="my">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#00B4D8">
<title>WC Wallet + Slot</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Padauk:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --wc-blue:#00B4D8;--wc-blue-dark:#0077B6;--wc-blue-light:#90E0EF;
  --wc-gold:#FFB800;--wc-gold-dark:#FF8C00;
  --bg:#EEF4F9;--surface:#FFF;--surface-2:#F5F9FC;--text:#0F172A;--text-2:#5B6B82;
  --border:#DCE6F0;--green:#00D9A3;--red:#FF4757;--warn:#FFB800;
  --grad:linear-gradient(135deg,#00B4D8,#0077B6);
  --grad-gold:linear-gradient(135deg,#FFB800,#FF8C00);
  --grad-green:linear-gradient(135deg,#00D9A3,#00A378);
  --grad-red:linear-gradient(135deg,#FF4757,#E63946);
  --grad-purple:linear-gradient(135deg,#8B5CF6,#6D28D9);
  --r:18px;--r-pill:999px;
  --sh-sm:0 2px 8px rgba(15,23,42,.05);--sh-md:0 8px 24px rgba(15,23,42,.08);
  --sh-lg:0 16px 40px rgba(15,23,42,.12);
  --slot-bg:#0a0118;--panel:#160829;--header:#2a0845;
  --gold:#ffcc00;--cyan:#00ffcc;--pink:#ff00ff;
  --reel:#FFFBF0;--reel-text:#1E293B;
}
body{font-family:'Inter','Padauk',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased;font-size:15px}
.hidden{display:none!important}

/* ===== LOADING ===== */
.loading{position:fixed;inset:0;background:rgba(255,255,255,.9);display:none;align-items:center;justify-content:center;z-index:99999;backdrop-filter:blur(6px)}
.loading.show{display:flex}
.spinner{width:50px;height:50px;border:5px solid rgba(0,180,216,.15);border-top-color:var(--wc-blue);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== AUTH SCREEN ===== */
#authScreen{display:none;min-height:100vh;background:linear-gradient(135deg,#00B4D8 0%,#0077B6 50%,#03045E 100%);align-items:center;justify-content:center;padding:20px;position:fixed;inset:0;z-index:1000;overflow-y:auto}
#authScreen.active{display:flex}
.auth-logo{position:absolute;top:30px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:14px;z-index:10}
.auth-logo-mark{width:60px;height:60px;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;color:#0077B6;box-shadow:0 10px 32px rgba(0,0,0,.2);letter-spacing:-1px}
.auth-logo-text{font-size:32px;font-weight:900;color:#fff;letter-spacing:-1px}
.auth-logo-text span{color:#90E0EF}
.auth-box{background:#FFF;padding:44px 32px 36px;border-radius:28px;box-shadow:0 30px 80px rgba(0,0,0,.3);width:440px;max-width:100%;position:relative;z-index:5;margin:80px 0 20px}
.auth-box h1{font-size:32px;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-align:center;margin-bottom:8px}
.auth-box .subtitle{text-align:center;color:var(--text-2);font-size:16px;margin-bottom:26px;font-weight:600}
.auth-tabs{display:flex;background:var(--surface-2);border-radius:var(--r-pill);padding:6px;margin-bottom:24px}
.auth-tab{flex:1;padding:14px;border:none;background:transparent;cursor:pointer;font-weight:800;font-size:16px;color:var(--text-2);border-radius:var(--r-pill);font-family:inherit;transition:.2s}
.auth-tab.active{background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}
.auth-form{display:flex;flex-direction:column;gap:16px}
.auth-input-group{position:relative;display:flex;align-items:center}
.auth-input-group .ico{position:absolute;left:18px;font-size:20px;pointer-events:none;z-index:1}
.auth-form input,.auth-form select{width:100%;padding:16px 18px 16px 52px;border:2px solid var(--border);border-radius:14px;font-size:16px;background:var(--surface-2);transition:.2s;outline:none;color:var(--text);font-family:inherit;font-weight:600;appearance:none;-webkit-appearance:none;cursor:pointer}
.auth-form select{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%235B6B82' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");background-repeat:no-repeat;background-position:right 18px center;padding-right:46px}
.auth-form input:focus,.auth-form select:focus{border-color:var(--wc-blue);background:#FFF;box-shadow:0 0 0 4px rgba(0,180,216,.1)}
.auth-form select option{background:#FFF;color:var(--text);font-weight:600;padding:10px}
.auth-btn{background:var(--grad);color:#fff;padding:16px;border:none;border-radius:14px;font-weight:900;cursor:pointer;font-size:18px;font-family:inherit;transition:.2s;box-shadow:0 6px 20px rgba(0,180,216,.3);margin-top:8px}
.auth-btn:hover{transform:translateY(-2px)}
.auth-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.auth-err{color:var(--red);font-size:15px;text-align:center;min-height:22px;font-weight:700}
.auth-footer{margin-top:24px;text-align:center;font-size:14px;color:var(--text-2);font-weight:600}

/* ===== TOASTS ===== */
.toast-container{position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;pointer-events:none;max-width:calc(100vw - 40px)}
.toast{background:#FFF;padding:16px 22px;border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.15);border-left:6px solid var(--wc-blue);font-size:16px;font-weight:700;color:var(--text);min-width:260px;max-width:380px;pointer-events:auto;display:flex;align-items:center;gap:12px;animation:slideRight .3s ease-out}
.toast.success{border-left-color:var(--green)}
.toast.error{border-left-color:var(--red)}
.toast.warn{border-left-color:var(--warn)}
@keyframes slideRight{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

.coin-reward{position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-200px);background:var(--grad-gold);color:#fff;padding:16px 28px;border-radius:36px;font-weight:900;font-size:20px;box-shadow:0 12px 32px rgba(255,184,0,.4);z-index:99998;transition:transform .4s cubic-bezier(.4,0,.2,1);pointer-events:none;display:flex;align-items:center;gap:10px}
.coin-reward.show{transform:translateX(-50%) translateY(0)}
.coin-reward .coin-icon{width:30px;height:30px}
.coin-reward .coin-icon img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,.2))}

/* ===== APP SHELL ===== */
.app-shell{display:none;min-height:100vh}
.app-shell.active{display:flex}
.sidebar{width:250px;background:#FFF;border-right:1px solid var(--border);padding:24px 16px;display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;z-index:20;overflow-y:auto}
.sidebar-logo{display:flex;align-items:center;gap:12px;padding:0 8px;margin-bottom:30px}
.logo-mark{width:48px;height:48px;border-radius:16px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#fff;box-shadow:0 4px 14px rgba(0,180,216,.35);letter-spacing:-1px}
.sidebar-logo h1{font-size:20px;font-weight:900;letter-spacing:-0.5px}
.sidebar-logo p{font-size:11px;color:var(--text-2);letter-spacing:1px;text-transform:uppercase;font-weight:700;margin-top:2px}
.nav-section{font-size:12px;color:var(--text-2);font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:0 12px;margin:20px 0 10px}
.nav-item{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;cursor:pointer;transition:.2s;color:var(--text-2);font-size:15px;font-weight:700;margin-bottom:4px;border:none;background:transparent;width:100%;text-align:left;font-family:inherit}
.nav-item .ni-icon{font-size:20px;width:24px;text-align:center}
.nav-item:hover{background:var(--surface-2);color:var(--text)}
.nav-item.active{background:linear-gradient(90deg,rgba(0,180,216,.15),rgba(0,180,216,.03));color:var(--wc-blue-dark);border-left:4px solid var(--wc-blue)}
.nav-wallet{margin-top:8px}
.wallet-row{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:14px;cursor:pointer;transition:.2s;margin-bottom:6px}
.wallet-row:hover{background:var(--surface-2)}
.wallet-row .wr-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.wallet-row .wr-meta{flex:1;min-width:0}
.wallet-row .wr-meta h5{font-size:15px;font-weight:800;margin-bottom:2px}
.wallet-row .wr-meta p{font-size:12px;color:var(--text-2);font-weight:600}
.sb-user{margin-top:auto;display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--surface-2);border:1px solid var(--border);cursor:pointer;transition:.2s}
.sb-user:hover{background:#FFF}
.sb-avatar{width:44px;height:44px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;color:#fff;flex-shrink:0}
.sb-user h5{font-size:15px;font-weight:800}
.sb-user p{font-size:12px;color:var(--text-2);font-weight:600}

.main-content{flex:1;margin-left:250px;padding:30px 36px 50px;position:relative;z-index:2}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;gap:16px;flex-wrap:wrap}
.topbar-left h2{font-size:28px;font-weight:900;letter-spacing:-1px}
.topbar-left p{font-size:15px;color:var(--text-2);margin-top:4px;font-weight:600}
.topbar-right{display:flex;align-items:center;gap:14px}
.avatar-btn{width:48px;height:48px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:20px;cursor:pointer;box-shadow:var(--sh-sm);position:relative;border:none;font-family:inherit}
.avatar-btn .status-dot{position:absolute;bottom:2px;right:2px;width:14px;height:14px;background:var(--green);border:3px solid #FFF;border-radius:50%}
.logout-btn{background:var(--surface);border:2px solid var(--border);border-radius:14px;padding:12px 18px;font-size:15px;font-weight:800;cursor:pointer;font-family:inherit;color:var(--red);transition:.2s}
.logout-btn:hover{background:#FFF0F1;border-color:var(--red)}

/* ===== PAGE VIEWS ===== */
.page-view{display:none}
.page-view.active{display:block;animation:fadeUp .3s ease-out}
@keyframes fadeUp{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}

/* ===== BALANCE / STATS / ACTIONS ===== */
.balance-card{background:linear-gradient(135deg,#00B4D8 0%,#0077B6 100%);border-radius:28px;padding:32px 30px;color:#fff;position:relative;overflow:hidden;margin-bottom:28px;box-shadow:0 12px 32px rgba(0,180,216,.28)}
.balance-card::before{content:'';position:absolute;top:-50%;right:-30%;width:320px;height:320px;background:rgba(255,255,255,.08);border-radius:50%}
.balance-card::after{content:'';position:absolute;bottom:-60%;left:-20%;width:260px;height:260px;background:rgba(255,255,255,.05);border-radius:50%}
.balance-label{font-size:14px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;opacity:.85;margin-bottom:12px;position:relative;z-index:2}
.balance-amount{font-size:48px;font-weight:900;letter-spacing:-2px;line-height:1.1;position:relative;z-index:2;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.balance-amount .coin-icon{width:44px;height:44px;display:flex;align-items:center;justify-content:center}
.balance-amount .coin-icon img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(0,0,0,.2))}
.balance-amount small{font-size:20px;font-weight:800;opacity:.9}
.balance-sub{font-size:15px;margin-top:12px;font-weight:600;opacity:.85;position:relative;z-index:2;display:flex;align-items:center;gap:8px}
.balance-actions{display:flex;gap:14px;margin-top:24px;position:relative;z-index:2}
.balance-action{flex:1;background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.35);color:#fff;padding:16px 12px;border-radius:16px;font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;transition:.2s;backdrop-filter:blur(10px)}
.balance-action:hover{background:rgba(255,255,255,.3);transform:translateY(-2px)}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-bottom:30px}
.stat-box{background:#FFF;border:1px solid var(--border);border-radius:22px;padding:22px 24px;box-shadow:var(--sh-sm);transition:.25s}
.stat-box:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
.stat-box .sb-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.stat-box .sb-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px}
.sb-wave .sb-icon{background:linear-gradient(135deg,#FFF3D0,#FFE29A)}
.sb-kpay .sb-icon{background:linear-gradient(135deg,#DDEEFF,#B8DCFF)}
.sb-wc .sb-icon{background:linear-gradient(135deg,#D0F9E8,#A8EFD3)}
.sb-total .sb-icon{background:linear-gradient(135deg,#E0F2FE,#BAE6FD)}
.stat-box .sb-label{font-size:14px;color:var(--text-2);font-weight:700;margin-bottom:8px}
.stat-box .sb-value{font-size:28px;font-weight:900;letter-spacing:-1px;line-height:1.15;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.stat-box .sb-value small{font-size:15px;font-weight:800;color:var(--text-2)}
.stat-box .sb-value .inline-coin{width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.stat-box .sb-value .inline-coin img{width:100%;height:100%;object-fit:contain}
.stat-box .sb-foot{font-size:13px;color:var(--text-2);margin-top:10px;font-weight:600}

.action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:30px}
.action-tile{background:#FFF;border:1px solid var(--border);border-radius:22px;padding:22px 18px;display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm);font-family:inherit;border:none}
.action-tile:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:rgba(0,180,216,.3)}
.action-tile .at-icon{width:64px;height:64px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:30px}
.at-play .at-icon{background:linear-gradient(135deg,#FFE4B8,#FFC97A)}
.at-receive .at-icon{background:linear-gradient(135deg,#D0F9E8,#A8EFD3)}
.at-history .at-icon{background:linear-gradient(135deg,#DDEEFF,#B8DCFF)}
.at-buy .at-icon{background:linear-gradient(135deg,#F3E4FF,#E0C8FF)}
.at-gift .at-icon{background:linear-gradient(135deg,#FFD6E8,#FFB3D9)}
.action-tile h4{font-size:16px;font-weight:800;color:var(--text);text-align:center;line-height:1.2}
.action-tile p{font-size:13px;color:var(--text-2);font-weight:600;text-align:center}

/* ===== WALLET CARDS ===== */
.wallets-section{margin-bottom:28px}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.section-header h3{font-size:22px;font-weight:900;letter-spacing:-0.5px;display:flex;align-items:center;gap:10px}
.section-header a{font-size:14px;color:var(--wc-blue-dark);font-weight:800;cursor:pointer;text-decoration:none}
.wallet-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px}
.wallet-card{background:#FFF;border:1px solid var(--border);border-radius:24px;padding:24px;position:relative;overflow:hidden;cursor:pointer;transition:.25s;box-shadow:var(--sh-sm)}
.wallet-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.wallet-card::before{content:'';position:absolute;top:-40%;right:-20%;width:200px;height:200px;border-radius:50%;opacity:.12;filter:blur(20px);background:#00B4D8}
.wallet-card-head{display:flex;align-items:center;gap:14px;margin-bottom:20px;position:relative;z-index:2}
.wallet-logo{width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#fff;flex-shrink:0;background:var(--grad);letter-spacing:-1px}
.wallet-card-head .wc-name{flex:1;min-width:0}
.wallet-card-head .wc-name h4{font-size:18px;font-weight:900;margin-bottom:4px}
.wallet-card-head .wc-name p{font-size:13px;color:var(--text-2);font-weight:600}
.wallet-balance{font-size:34px;font-weight:900;letter-spacing:-1.5px;position:relative;z-index:2;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.wallet-balance small{font-size:16px;font-weight:800;color:var(--text-2)}
.wallet-balance .inline-coin{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.wallet-balance .inline-coin img{width:100%;height:100%;object-fit:contain}
.wallet-meta{font-size:13px;color:var(--text-2);margin-top:10px;font-weight:600;position:relative;z-index:2}

/* ===== SLOT GAME ===== */
.slot-wrapper{background:linear-gradient(145deg,#1a0a2e 0%,#0a0118 50%,#12031f 100%);border-radius:28px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 0 3px rgba(255,204,0,.3),inset 0 0 60px rgba(255,204,0,.05);max-width:980px;margin:0 auto;position:relative;overflow:hidden}
.slot-wrapper::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,0,255,.08) 0%,transparent 60%);animation:glowRotate 8s linear infinite;pointer-events:none}
@keyframes glowRotate{to{transform:rotate(360deg)}}
.slot-top{display:flex;justify-content:space-between;align-items:center;background:rgba(22,8,41,.9);border:2px solid rgba(255,204,0,.5);border-radius:14px;padding:12px 18px;margin-bottom:12px;position:relative;z-index:2;backdrop-filter:blur(10px)}
.slot-credit{display:flex;align-items:center;gap:10px;color:var(--gold);font-weight:900;font-size:16px}
.slot-credit .coin-icon{width:28px;height:28px}
.slot-credit .coin-icon img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 0 8px rgba(255,204,0,.5))}
.slot-credit .lbl{font-size:13px;opacity:.75;margin-right:4px}
.slot-credit .val{color:var(--cyan);font-size:24px;text-shadow:0 0 12px rgba(0,255,204,.7)}
.slot-top-right{display:flex;gap:8px}
.slot-btn-sm{background:linear-gradient(135deg,#FFD700,#FFA500);color:#1a0b2e;border:none;border-radius:10px;width:40px;height:40px;cursor:pointer;font-weight:900;font-size:16px;display:flex;align-items:center;justify-content:center;transition:.15s;box-shadow:0 3px 8px rgba(255,204,0,.3)}
.slot-btn-sm:active{transform:scale(.9)}
.slot-title{text-align:center;font-size:42px;font-weight:900;background:linear-gradient(180deg,#FFD700 0%,#FF8C00 50%,#FFD700 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:8px;margin:8px 0 2px;position:relative;z-index:2;filter:drop-shadow(0 0 20px rgba(255,204,0,.6));animation:titlePulse 2s ease-in-out infinite}
@keyframes titlePulse{0%,100%{filter:drop-shadow(0 0 20px rgba(255,204,0,.6))}50%{filter:drop-shadow(0 0 35px rgba(255,0,255,.8))}}
.slot-subtitle{text-align:center;font-size:12px;color:var(--cyan);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;border:1.5px solid rgba(0,255,204,.6);border-radius:8px;padding:6px;background:rgba(0,255,204,.08);font-weight:800;position:relative;z-index:2;backdrop-filter:blur(10px)}
.slot-info-row{display:flex;justify-content:space-around;background:rgba(42,8,69,.8);border:2px solid rgba(255,204,0,.4);border-radius:12px;padding:10px 16px;margin-bottom:12px;position:relative;z-index:2;backdrop-filter:blur(10px)}
.slot-info-item{display:flex;flex-direction:column;align-items:center;min-width:70px}
.slot-info-item .lbl{font-size:10px;color:var(--gold);font-weight:800;text-transform:uppercase;letter-spacing:1.5px}
.slot-info-item .val{font-size:22px;color:#fff;font-weight:900;margin-top:2px}
.slot-info-item.vip .val{color:#ffaa00;font-size:24px}
.slot-main{display:flex;gap:12px;margin-bottom:12px;position:relative;z-index:2}
.slot-ways{display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(180deg,#4a0000,#2a0000);border:2px solid rgba(255,204,0,.5);border-radius:12px;padding:10px 6px;width:44px;flex-shrink:0}
.slot-ways span{writing-mode:vertical-rl;color:var(--gold);font-weight:900;font-size:12px;letter-spacing:3px;text-shadow:0 0 10px rgba(255,204,0,.5)}
.slot-reels{flex:1;background:linear-gradient(180deg,#0a0015,#1a0525);border:4px solid var(--gold);border-radius:16px;padding:8px;position:relative;min-width:0;overflow:hidden;box-shadow:inset 0 0 40px rgba(255,204,0,.1),0 0 20px rgba(255,204,0,.2)}
.reels-frame{position:relative;width:100%;height:100%;border-radius:10px;overflow:hidden;background:#0a0015}
.reels-container{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:6px;width:100%;height:100%;background:linear-gradient(180deg,#1a0a2e,#0a0015);border-radius:10px}
.reel-column{position:relative;overflow:hidden;border-radius:8px;background:#0a0015;border:2px solid rgba(255,204,0,.3);height:100%;min-height:340px}
.reel-strip{position:absolute;top:0;left:0;right:0;display:flex;flex-direction:column;will-change:transform}
.reel-cell{width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#FFFDF8,#FFF5E0);border-radius:6px;border:1px solid rgba(255,204,0,.3);margin:1px 0;position:relative;overflow:hidden;box-shadow:inset 0 2px 4px rgba(0,0,0,.05);flex-shrink:0}
.reel-cell .sym{display:flex;justify-content:center;align-items:center;width:100%;height:100%;font-weight:bold;font-size:40px;color:var(--reel-text)}
.reel-cell .sym svg{width:100%;height:100%;max-width:58px;max-height:58px;display:block;margin:auto;filter:drop-shadow(0 2px 3px rgba(0,0,0,.15))}
.reel-cell .sym.bomb{font-size:40px}
.reel-cell .sym.win{background:linear-gradient(135deg,rgba(0,255,204,.95),rgba(255,204,0,.85));border-radius:6px;animation:wf .25s infinite alternate;box-shadow:0 0 20px #00ffcc,0 0 40px #ffcc00;z-index:2}
.reel-cell .sym.scatter{background:linear-gradient(135deg,rgba(255,0,255,.95),rgba(255,100,0,.85));border-radius:6px;animation:sf .25s infinite alternate;box-shadow:0 0 25px #ff00ff,0 0 50px #ff6600;z-index:2}
@keyframes wf{0%{transform:scale(1)}100%{transform:scale(1.12)}}
@keyframes sf{0%{transform:scale(1)}100%{transform:scale(1.18)}}
.slot-btns{display:flex;flex-direction:column;gap:10px;width:120px;flex-shrink:0}
.slot-btn{border-radius:14px;font-weight:900;cursor:pointer;text-transform:uppercase;border:2px solid rgba(255,255,255,.25);transition:.15s;font-family:inherit;padding:0;color:#1a0b2e;position:relative;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.3);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1}
.slot-btn:active{transform:scale(.95)}
.slot-btn::after{content:'';position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);transition:.5s}
.slot-btn:hover::after{left:150%}
.slot-spin{background:linear-gradient(180deg,#00ffcc,#00b894);font-size:28px;padding:20px 0;box-shadow:0 0 25px rgba(0,255,204,.5),0 4px 12px rgba(0,0,0,.3)}
.slot-spin .btn-label{font-size:14px;letter-spacing:1px}
.slot-spin:disabled{opacity:.5;box-shadow:none;cursor:not-allowed}
.slot-auto{background:linear-gradient(180deg,#ff00ff,#c400c4);color:#fff;font-size:22px;padding:14px 0;box-shadow:0 0 18px rgba(255,0,255,.4)}
.slot-auto .btn-label{font-size:12px;letter-spacing:1px}
.slot-turbo{background:linear-gradient(180deg,#ffaa00,#cc8800);font-size:22px;padding:14px 0;box-shadow:0 0 18px rgba(255,170,0,.4)}
.slot-turbo .btn-label{font-size:12px;letter-spacing:1px}
.slot-bet-row{display:flex;justify-content:space-between;align-items:center;background:rgba(22,8,41,.9);border:2px solid rgba(255,204,0,.4);border-radius:12px;padding:10px 14px;gap:10px;flex-wrap:wrap;position:relative;z-index:2;backdrop-filter:blur(10px)}
.bet-ctrl{display:flex;align-items:center;gap:8px;background:rgba(74,0,0,.8);padding:6px 10px;border-radius:10px;border:2px solid rgba(255,204,0,.5)}
.bet-ctrl button{background:linear-gradient(180deg,#FFD700,#FFA500);border:none;width:38px;height:38px;border-radius:8px;font-weight:900;cursor:pointer;font-size:20px;color:#1a0b2e;transition:.15s;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.bet-ctrl button:active{transform:scale(.9)}
.bet-ctrl .bv{color:#fff;font-weight:900;font-size:22px;min-width:60px;text-align:center}
.bet-ctrl .bl{color:var(--gold);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px}
.quick-bets{display:flex;gap:6px}
.quick-bets button{border:none;border-radius:8px;font-weight:900;cursor:pointer;color:#fff;font-size:15px;padding:12px 16px;min-width:52px;font-family:inherit;transition:.15s;box-shadow:0 3px 8px rgba(0,0,0,.2)}
.quick-bets button:active{transform:scale(.95)}
.q2x{background:linear-gradient(180deg,#ffaa00,#cc8800)}
.q3x{background:linear-gradient(180deg,#ff6600,#cc4400)}
.q5x{background:linear-gradient(180deg,#ff0066,#cc0044)}
.daily-btn{background:linear-gradient(180deg,#00ff66,#00cc44);color:#1a0b2e;padding:12px 18px;border:none;border-radius:10px;font-weight:900;cursor:pointer;font-size:20px;font-family:inherit;transition:.15s;box-shadow:0 3px 8px rgba(0,255,102,.3)}
.daily-btn:active{transform:scale(.95)}
.slot-msg{background:linear-gradient(180deg,#000,#0a0015);border:2px solid rgba(255,204,0,.5);border-radius:12px;padding:14px;color:#ffcc00;font-size:15px;font-weight:800;min-height:60px;display:flex;justify-content:center;align-items:center;text-align:center;line-height:1.5;flex-wrap:wrap;gap:6px;margin-top:12px;overflow:hidden;position:relative;z-index:2;box-shadow:inset 0 0 20px rgba(255,204,0,.1)}
.slot-msg .win-line{background:rgba(255,204,0,.15);border:2px solid rgba(255,204,0,.6);border-radius:8px;padding:4px 10px;margin:3px;display:inline-block;font-size:12px;animation:popIn .3s ease-out}
@keyframes popIn{0%{transform:scale(0)}100%{transform:scale(1)}}
.slot-effect{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0);font-size:72px;font-weight:900;text-shadow:0 0 40px currentColor,0 0 80px currentColor;z-index:50;pointer-events:none;opacity:0;transition:opacity .3s,transform .3s;white-space:nowrap;text-align:center}
.slot-effect.show{opacity:1;transform:translate(-50%,-50%) scale(1);animation:winPulse .35s infinite alternate}
@keyframes winPulse{0%{transform:translate(-50%,-50%) scale(1)}100%{transform:translate(-50%,-50%) scale(1.18)}}
.slot-freespin{position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,0,255,.15),rgba(255,204,0,.15));z-index:40;pointer-events:none;opacity:0;transition:opacity .3s;border-radius:10px}
.slot-freespin.show{opacity:1}
.slot-freespin::before{content:' FREE SPIN';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-15deg);font-size:38px;font-weight:900;color:#ff00ff;text-shadow:0 0 25px #ff00ff,0 0 50px #ff00ff;animation:fsFlash .4s infinite alternate}
@keyframes fsFlash{0%{opacity:.5}100%{opacity:1}}

/* ===== GIFT SHOP ===== */
.gift-hero{background:linear-gradient(135deg,#FF6B9D 0%,#C44569 100%);border-radius:24px;padding:28px;color:#fff;margin-bottom:24px;position:relative;overflow:hidden;box-shadow:0 12px 32px rgba(196,69,105,.3)}
.gift-hero::before{content:'';position:absolute;top:-20px;right:-20px;font-size:140px;opacity:.15;transform:rotate(-15deg)}
.gift-hero h2{font-size:28px;font-weight:900;margin-bottom:8px;position:relative;z-index:2}
.gift-hero p{font-size:15px;font-weight:600;opacity:.9;position:relative;z-index:2}
.gift-hero .gift-balance{font-size:32px;font-weight:900;margin-top:12px;display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.gift-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:18px;margin-bottom:30px}
.gift-card{background:#FFF;border:2px solid var(--border);border-radius:20px;overflow:hidden;transition:.25s;box-shadow:var(--sh-sm);display:flex;flex-direction:column}
.gift-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:#FF6B9D}
.gift-image{width:100%;aspect-ratio:1/1;background:linear-gradient(135deg,#FFF5F8,#FFE4EC);display:flex;align-items:center;justify-content:center;font-size:64px;overflow:hidden;position:relative}
.gift-image img{width:100%;height:100%;object-fit:cover;display:block}
.gift-image .gift-placeholder{font-size:64px;opacity:.5}
.gift-body{padding:16px;display:flex;flex-direction:column;gap:8px;flex:1}
.gift-body h4{font-size:16px;font-weight:900;color:var(--text);line-height:1.2}
.gift-body .gift-desc{font-size:13px;color:var(--text-2);font-weight:600;line-height:1.4;flex:1;min-height:36px}
.gift-body .gift-price{font-size:20px;font-weight:900;color:#C44569;display:flex;align-items:center;gap:6px;margin-top:4px}
.gift-body .gift-price .coin-icon{width:20px;height:20px}
.gift-body .gift-price .coin-icon img{width:100%;height:100%;object-fit:contain}
.gift-body .gift-stock{font-size:12px;color:var(--text-2);font-weight:700}
.gift-body .gift-btn{background:linear-gradient(135deg,#FF6B9D,#C44569);color:#fff;border:none;border-radius:12px;padding:12px;font-weight:900;cursor:pointer;font-family:inherit;font-size:14px;transition:.2s;margin-top:6px}
.gift-body .gift-btn:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(196,69,105,.3)}
.gift-body .gift-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.gift-body .gift-btn.out{background:var(--surface-2);color:var(--text-2);cursor:not-allowed}

.gift-admin-form{background:var(--surface-2);border-radius:16px;padding:20px;margin-bottom:20px;border:2px dashed var(--border)}
.gift-admin-form h4{font-size:16px;font-weight:900;margin-bottom:14px;color:var(--text)}
.gift-admin-row{display:flex;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.gift-admin-row input,.gift-admin-row textarea{flex:1;min-width:140px;padding:12px 16px;border:2px solid var(--border);border-radius:10px;font-size:14px;font-family:inherit;font-weight:600;background:#FFF;outline:none}
.gift-admin-row input:focus,.gift-admin-row textarea:focus{border-color:var(--wc-blue)}
.gift-admin-row textarea{min-height:60px;resize:vertical}

/* ===== TRANSFER / BUY / HISTORY ===== */
.tab-bar{display:flex;gap:10px;background:var(--surface-2);border-radius:var(--r-pill);padding:6px;margin-bottom:22px;overflow-x:auto}
.tab-bar button{padding:12px 20px;border:none;background:transparent;font-weight:800;font-size:15px;cursor:pointer;border-radius:var(--r-pill);color:var(--text-2);font-family:inherit;white-space:nowrap;transition:.2s}
.tab-bar button.active{background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}

.info-row{margin-bottom:20px}
.info-row label{display:block;font-size:14px;font-weight:800;color:var(--text-2);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.info-row input,.info-row select,.info-row textarea{width:100%;padding:16px 20px;border:2px solid var(--border);border-radius:14px;font-size:16px;background:var(--surface-2);outline:none;color:var(--text);font-family:inherit;font-weight:600;transition:.15s}
.info-row input:focus,.info-row select:focus,.info-row textarea:focus{border-color:var(--wc-blue);background:#FFF;box-shadow:0 0 0 4px rgba(0,180,216,.1)}
.info-row textarea{resize:vertical;min-height:100px}

.btn{padding:16px 24px;border-radius:14px;font-weight:800;font-size:16px;cursor:pointer;font-family:inherit;border:none;transition:.2s;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 4px 14px rgba(0,180,216,.3)}
.btn-secondary{background:var(--surface-2);color:var(--text);border:2px solid var(--border)}
.btn-danger{background:linear-gradient(135deg,#FF4757,#FF6B7A);color:#fff}
.btn-success{background:var(--grad-green);color:#fff;box-shadow:0 4px 14px rgba(0,217,163,.3)}
.btn-gold{background:var(--grad-gold);color:#fff;box-shadow:0 4px 14px rgba(255,184,0,.3)}
.btn-purple{background:var(--grad-purple);color:#fff;box-shadow:0 4px 14px rgba(139,92,246,.3)}
.btn-block{width:100%}
.btn-sm{padding:10px 16px;font-size:14px;border-radius:10px}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

.history-list{display:flex;flex-direction:column;gap:12px}
.tx-row{background:#FFF;border:1px solid var(--border);border-radius:18px;padding:18px 20px;display:flex;align-items:center;gap:18px;box-shadow:var(--sh-sm);transition:.2s}
.tx-row:hover{transform:translateX(4px);box-shadow:var(--sh-md)}
.tx-icon{width:54px;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;background:var(--surface-2)}
.tx-icon.plus{background:linear-gradient(135deg,#D0F9E8,#A8EFD3);color:#00A378}
.tx-icon.minus{background:linear-gradient(135deg,#FFE4E4,#FFC8C8);color:#E63946}
.tx-body{flex:1;min-width:0}
.tx-body .tx-title{font-size:16px;font-weight:800;margin-bottom:4px}
.tx-body .tx-desc{font-size:13px;color:var(--text-2);font-weight:600}
.tx-amount{font-size:20px;font-weight:900;flex-shrink:0;display:flex;align-items:center;gap:6px}
.tx-amount.plus{color:#00A378}
.tx-amount.minus{color:#E63946}
.tx-amount .coin-icon{width:24px;height:24px}
.tx-amount .coin-icon img{width:100%;height:100%;object-fit:contain}

.empty-state{text-align:center;padding:60px 20px;color:var(--text-2)}
.empty-state .em{font-size:72px;display:block;margin-bottom:20px;opacity:.5}
.empty-state h3{font-size:22px;font-weight:800;color:var(--text);margin-bottom:8px}
.empty-state p{font-size:15px;font-weight:600}

/* ===== PACKAGE / REQUEST CARDS ===== */
.pkg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:24px}
.pkg-card{background:#FFF;border:3px solid var(--border);border-radius:20px;padding:24px 16px;text-align:center;cursor:pointer;position:relative;transition:.2s}
.pkg-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.pkg-card.selected{border-color:var(--wc-gold);background:rgba(255,184,0,.06);box-shadow:0 8px 24px rgba(255,184,0,.2)}
.pkg-coins{font-size:28px;font-weight:900;color:#FF8C00;line-height:1.1;margin-bottom:8px}
.pkg-price{font-size:16px;color:var(--text-2);font-weight:800}
.pkg-bonus{position:absolute;top:-10px;right:12px;background:var(--red);color:#fff;font-size:12px;font-weight:900;padding:4px 12px;border-radius:14px}
.req-card{background:#FFF;border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:12px;display:flex;align-items:center;gap:16px}
.req-card .req-body{flex:1;min-width:0}
.req-card .req-title{font-size:16px;font-weight:800;margin-bottom:4px}
.req-card .req-sub{font-size:13px;color:var(--text-2);font-weight:600}

/* ===== MODALS ===== */
.modal-overlay{position:fixed;inset:0;background:rgba(10,14,39,.7);display:none;align-items:center;justify-content:center;z-index:9000;padding:20px;backdrop-filter:blur(6px)}
.modal-overlay.show{display:flex}
.modal{background:#FFF;border-radius:24px;width:100%;max-width:460px;max-height:90vh;overflow-y:auto;box-shadow:0 30px 80px rgba(0,0,0,.3);animation:popIn .3s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column}
.modal.modal-lg{max-width:640px}
@keyframes popIn{0%{transform:scale(.92);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-head{padding:24px 26px;border-bottom:2px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.modal-head h3{font-size:22px;font-weight:900;letter-spacing:-0.5px;display:flex;align-items:center;gap:10px}
.modal-close{background:transparent;border:none;font-size:24px;cursor:pointer;color:var(--text-2);width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-family:inherit}
.modal-close:hover{background:var(--surface-2)}
.modal-body{padding:26px;flex:1;overflow-y:auto}
.modal-foot{padding:20px 26px 26px;display:flex;gap:12px;flex-shrink:0}

/* ===== ADMIN ===== */
#adminScreen{display:none;min-height:100vh;background:var(--bg);position:fixed;inset:0;z-index:1000;overflow-y:auto}
#adminScreen.active{display:block}
.admin-header{background:var(--grad);color:#fff;padding:20px 28px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;box-shadow:0 4px 20px rgba(0,0,0,.15)}
.admin-header h2{font-size:24px;font-weight:900;display:flex;align-items:center;gap:10px}
.admin-body{padding:30px;max-width:1280px;margin:0 auto}
.admin-tabs{display:flex;gap:8px;background:#FFF;border-radius:var(--r-pill);padding:8px;margin-bottom:24px;overflow-x:auto;box-shadow:var(--sh-sm);position:sticky;top:80px;z-index:9}
.admin-tab{padding:14px 20px;border:none;background:transparent;font-weight:800;font-size:15px;cursor:pointer;border-radius:var(--r-pill);color:var(--text-2);font-family:inherit;white-space:nowrap;transition:.2s}
.admin-tab.active{background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(0,180,216,.3)}
.admin-panel{display:none}
.admin-panel.active{display:block}
.admin-card{background:#FFF;border:1px solid var(--border);border-radius:20px;padding:24px;margin-bottom:18px;box-shadow:var(--sh-sm)}
.admin-card-title{font-size:18px;font-weight:900;color:var(--text);margin-bottom:18px;display:flex;align-items:center;gap:10px;padding-bottom:14px;border-bottom:2px solid var(--border)}
.admin-card-title .title-badge{background:var(--grad);color:#fff;font-size:11px;font-weight:900;padding:4px 10px;border-radius:10px;letter-spacing:.5px}
.admin-grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.admin-grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.admin-field{margin-bottom:16px}
.admin-field label{display:block;font-size:13px;font-weight:800;color:var(--text-2);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.admin-field input,.admin-field select,.admin-field textarea{width:100%;padding:13px 16px;border:2px solid var(--border);border-radius:12px;font-size:15px;background:var(--surface-2);outline:none;color:var(--text);font-family:inherit;font-weight:600;transition:.15s}
.admin-field input:focus,.admin-field select:focus,.admin-field textarea:focus{border-color:var(--wc-blue);background:#FFF;box-shadow:0 0 0 4px rgba(0,180,216,.1)}
.admin-field textarea{resize:vertical;min-height:80px}
.admin-field .help-text{font-size:12px;color:var(--text-2);font-weight:600;margin-top:6px;font-style:italic}

.user-row{display:flex;align-items:center;gap:16px;padding:16px;background:var(--surface-2);border-radius:16px;margin-bottom:10px;border:1px solid var(--border);transition:.2s}
.user-row:hover{background:#FFF;box-shadow:var(--sh-sm)}
.user-row .ur-av{width:52px;height:52px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;flex-shrink:0}
.user-row .ur-body{flex:1;min-width:0}
.user-row .ur-name{font-size:16px;font-weight:800;margin-bottom:4px}
.user-row .ur-sub{font-size:13px;color:var(--text-2);font-weight:600}
.user-row .ur-actions{display:flex;gap:8px;flex-wrap:wrap}

.admin-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px}
.admin-stat{background:#FFF;border:1px solid var(--border);border-radius:18px;padding:20px;box-shadow:var(--sh-sm);text-align:center}
.admin-stat .as-icon{font-size:32px;margin-bottom:8px}
.admin-stat .as-value{font-size:26px;font-weight:900;color:var(--text);letter-spacing:-1px}
.admin-stat .as-label{font-size:12px;color:var(--text-2);font-weight:800;text-transform:uppercase;letter-spacing:.8px;margin-top:4px}

.slot-control-banner{background:linear-gradient(135deg,#1a0a2e,#0a0118);color:#fff;border-radius:20px;padding:24px;margin-bottom:20px;border:2px solid rgba(255,204,0,.4);position:relative;overflow:hidden}
.slot-control-banner::before{content:'';position:absolute;top:-50%;right:-20%;width:200px;height:200px;background:radial-gradient(circle,rgba(255,0,255,.3),transparent 70%);pointer-events:none}
.slot-control-banner h3{font-size:20px;font-weight:900;color:#ffcc00;margin-bottom:6px;position:relative;z-index:2;display:flex;align-items:center;gap:10px}
.slot-control-banner p{font-size:13px;color:#90E0EF;font-weight:600;position:relative;z-index:2;line-height:1.5}
.slot-control-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:18px;position:relative;z-index:2}
.slot-control-item{background:rgba(255,255,255,.08);border:2px solid rgba(255,204,0,.3);border-radius:14px;padding:16px;backdrop-filter:blur(10px)}
.slot-control-item label{display:block;font-size:12px;font-weight:800;color:#ffcc00;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.slot-control-item input,.slot-control-item select{width:100%;padding:10px 14px;border:2px solid rgba(255,204,0,.4);border-radius:10px;background:rgba(0,0,0,.4);color:#fff;font-size:16px;font-weight:900;font-family:inherit;outline:none}
.slot-control-item input:focus,.slot-control-item select:focus{border-color:#00ffcc}
.slot-control-item .help{font-size:11px;color:#90E0EF;font-weight:600;margin-top:6px}
.slot-force-btns{display:flex;gap:8px;margin-top:12px}
.slot-force-btns button{flex:1;padding:10px;border:none;border-radius:10px;font-weight:900;cursor:pointer;font-family:inherit;font-size:13px;transition:.2s}
.slot-force-btns .win-btn{background:linear-gradient(135deg,#00D9A3,#00A378);color:#fff}
.slot-force-btns .lose-btn{background:linear-gradient(135deg,#FF4757,#E63946);color:#fff}
.slot-force-btns .auto-btn{background:linear-gradient(135deg,#FFB800,#FF8C00);color:#fff}
.slot-force-btns button.active{box-shadow:0 0 0 3px rgba(255,255,255,.5)}

.order-row{display:flex;align-items:center;gap:14px;padding:16px;background:var(--surface-2);border-radius:14px;margin-bottom:10px;border:1px solid var(--border)}
.order-row .order-img{width:60px;height:60px;border-radius:12px;background:#FFF;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:28px}
.order-row .order-img img{width:100%;height:100%;object-fit:cover}
.order-row .order-body{flex:1;min-width:0}
.order-row .order-title{font-size:15px;font-weight:900;margin-bottom:4px}
.order-row .order-meta{font-size:12px;color:var(--text-2);font-weight:600}
.order-row .order-actions{display:flex;gap:6px;flex-wrap:wrap}

@media(max-width:900px){
  .sidebar{width:80px;padding:20px 10px}
  .sidebar-logo h1,.sidebar-logo p,.nav-section,.nav-item span:not(.ni-icon),.wallet-row .wr-meta,.sb-user h5,.sb-user p{display:none}
  .sidebar-logo{justify-content:center;padding:0}
  .nav-item,.wallet-row{justify-content:center;padding:14px 10px}
  .main-content{margin-left:80px;padding:20px 18px 40px}
  .admin-body{padding:20px 14px}
}
@media(max-width:700px){
  .slot-wrapper{padding:14px;border-radius:20px}
  .slot-title{font-size:32px;letter-spacing:5px}
  .slot-btns{width:88px}
  .slot-spin{font-size:20px;padding:16px 0}
  .slot-auto,.slot-turbo{font-size:16px;padding:10px 0}
  .reel-cell .sym{font-size:28px}
  .reel-cell .sym svg{max-width:38px;max-height:38px}
  .reel-column{min-height:220px}
  .slot-ways{width:36px}
  .slot-ways span{font-size:10px}
  .bet-ctrl button{width:34px;height:34px;font-size:18px}
  .bet-ctrl .bv{font-size:18px;min-width:50px}
  .quick-bets button{padding:10px 12px;min-width:44px;font-size:13px}
  .daily-btn{padding:10px 14px;font-size:16px}
  .balance-amount{font-size:38px}
  .balance-amount .coin-icon{width:34px;height:34px}
  .balance-action{padding:12px 10px;font-size:14px}
  .auth-box{padding:32px 24px 28px}
  .auth-box h1{font-size:26px}
  .gift-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
  .gift-hero h2{font-size:22px}
  .gift-hero .gift-balance{font-size:24px}
  .admin-tabs{top:70px;padding:6px}
  .admin-tab{padding:10px 14px;font-size:13px}
}
@media(max-width:450px){
  .slot-title{font-size:26px;letter-spacing:4px}
  .slot-btns{width:72px}
  .slot-spin{font-size:16px;padding:14px 0}
  .slot-spin .btn-label{font-size:11px}
  .slot-auto,.slot-turbo{font-size:14px;padding:8px 0}
  .reel-cell .sym{font-size:22px}
  .reel-cell .sym svg{max-width:30px;max-height:30px}
  .reel-column{min-height:180px}
  .reels-container{gap:3px;padding:4px}
  .slot-main{gap:8px}
  .gift-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<div class="loading" id="loading"><div class="spinner"></div></div>

<div class="toast-container" id="toastContainer"></div>
<div class="coin-reward" id="coinReward">
  <div class="coin-icon"><img id="coinRewardIcon" src="" alt="WCCoin"></div>
  <span id="coinRewardText">+0 WCCoin</span>
</div>

<!-- AUTH SCREEN -->
<div id="authScreen" class="active">
  <div class="auth-logo">
    <div class="auth-logo-mark">WC</div>
    <div class="auth-logo-text">WC<span>Wallet</span></div>
  </div>
  <div class="auth-box">
    <h1 id="authTitle">Login</h1>
    <p class="subtitle" id="authSub">WC Wallet ထဲ ဝင္ေရာက္ပါ</p>
    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLogin">Login</button>
      <button class="auth-tab" id="tabSignup">Sign Up</button>
    </div>
    <form class="auth-form" id="loginForm">
      <div class="auth-input-group"><span class="ico"></span><input type="tel" id="loginPhone" placeholder="09xxxxxxxxx" autocomplete="username" required></div>
      <div class="auth-input-group"><span class="ico"></span><input type="password" id="loginPass" placeholder="Password" autocomplete="current-password" required></div>
      <p class="auth-err" id="loginErr"></p>
      <button type="submit" class="auth-btn" id="loginBtn">Login</button>
    </form>
    <form class="auth-form hidden" id="signupForm">
      <div class="auth-input-group"><span class="ico"></span><input type="text" id="suName" placeholder="Full Name" required></div>
      <div class="auth-input-group"><span class="ico"></span><input type="tel" id="suPhone" placeholder="09xxxxxxxxx" required></div>
      <div class="auth-input-group"><span class="ico"></span><input type="password" id="suPass" placeholder="Password (6+ chars)" required></div>
      
      <!-- လိင္အမ်ိဳးအစား Dropdown -->
      <div class="auth-input-group">
        <span class="ico"></span>
        <select id="suGender" required>
          <option value="">-- လိင္အမ်ိဳးအစား ေ႐ြးပါ --</option>
          <option value="male"> က်ား (Male)</option>
          <option value="female"> မ (Female)</option>
          <option value="other"> အျခား (Other)</option>
        </select>
      </div>
      
      <!-- ေဘာကြဲ Dropdown -->
      <div class="auth-input-group">
        <span class="ico"></span>
        <select id="suAge" required>
          <option value="">-- ေဘာကြဲ ေ႐ြးပါ --</option>
          <option value="18-24">18-24 ႏွစ္</option>
          <option value="25-34">25-34 ႏွစ္</option>
          <option value="35-44">35-44 ႏွစ္</option>
          <option value="45+">45+ ႏွစ္</option>
        </select>
      </div>
      
      <p class="auth-err" id="signupErr"></p>
      <button type="submit" class="auth-btn" id="signupBtn">Sign Up</button>
    </form>
    <div class="auth-footer">WC Wallet  v2.1.0</div>
  </div>
</div>

<!-- APP SHELL -->
<div class="app-shell" id="appShell">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">WC</div>
      <div><h1>WC Wallet</h1><p>Wallet + Slot</p></div>
    </div>
    <div class="nav-section">Menu</div>
    <button class="nav-item active" data-page="dashboard"><span class="ni-icon"></span><span>Dashboard</span></button>
    <button class="nav-item" data-page="play"><span class="ni-icon"></span><span>Play Slot</span></button>
    <button class="nav-item" data-page="gift"><span class="ni-icon"></span><span>Gift Shop</span></button>
    <button class="nav-item" data-page="transfer"><span class="ni-icon"></span><span>Transfer</span></button>
    <button class="nav-item" data-page="buy"><span class="ni-icon"></span><span>Buy WCCoin</span></button>
    <button class="nav-item" data-page="history"><span class="ni-icon"></span><span>History</span></button>
    <button class="nav-item" data-page="settings"><span class="ni-icon"></span><span>Settings</span></button>
    <div class="nav-section">Wallets</div>
    <div class="nav-wallet" id="sidebarWallets"></div>
    <div class="sb-user" onclick="gotoPage('settings')">
      <div class="sb-avatar" id="sbAvatar">W</div>
      <div><h5 id="userName">Player</h5><p id="userPhone">-</p></div>
    </div>
  </aside>

  <main class="main-content">
    <div class="topbar">
      <div class="topbar-left">
        <h2 id="pageTitle">WC Wallet</h2>
